// "La pantalla de tu móvil…" — recreación completa del video de referencia "electrocutarte",
// mismo estilo y ritmo de planos (ver videos_referencia/electro/BIBLIOTECA_PLANOS.md), voz Gemini.
import React, {useLayoutEffect, useMemo, useRef} from 'react';
import {AbsoluteFill, Sequence, interpolate, staticFile, useCurrentFrame, useVideoConfig} from 'remotion';
import {Audio} from '@remotion/media';
import PALABRAS from '../electro.palabras.json';
import {Subtitulos} from '../../componentes/Subtitulos';
import {VideoCtx} from '../../motor/contexto';
import {crearReloj, normalizar} from '../../motor/reloj';
import {prepararPalabras} from '../../Video';
import {kf, rampa} from '../tiempo';
import type {VideoSpec} from '../../motor/tipos';
import {
  G, W, H, Y_CRISTAL, cam, fondo, cuadricula, seccion, dedo, boli, chispas, etiqueta, rotulo, telefono, pantalla,
  manoTelefono, dedoTocando, malla, proyector, rejilla3D, arcosEn, circuloPlano, tejido, rnd, lerp, FF,
} from './dibujo';

const P = PALABRAS as {word: string; start: number; end: number}[];
/** inicio de la palabra i, verificando que sea la esperada */
const w = (i: number, txt: string) => {
  if (!normalizar(P[i].word).startsWith(normalizar(txt))) throw new Error(`palabra ${i} es "${P[i].word}", esperaba "${txt}"`);
  return P[i].start;
};
export const DURACION_ELECTRO = P[P.length - 1].end + 1.2;

type Plano = {id: string; t0: number; dib: (g: G, s: number, l: number) => void; corte?: 'blur' | 'duro'};
const toca = (s: number, a: number, b = a + 0.3) => rampa(s, a, b, 'salida');

// ===================================================================== planos
const TX = 452; // punto de contacto principal en el corte

const PLANOS: Plano[] = [
  // 01 — corte con dedo y boli
  {id: 'p01', t0: 0, dib: (g, s) => {
    fondo(g, s);
    cam(g, kf(s, [[0, 0.8], [0.25, 0.8], [0.62, 1.0, 'suave'], [3, 1.03, 'lineal']]), kf(s, [[0, 560], [0.25, 560], [0.62, 520, 'suave']]), 1000);
    cuadricula(g);
    const c = toca(s, 0.45, 0.75);
    seccion(g, s, {atr: [{x: TX, f: c}]});
    boli(g, 800, 712 + Math.sin(s * 1.3) * 6);
    const b = kf(s, [[0, 0], [0.62, 1, 'suave']]);
    dedo(g, TX - 35 * (1 - b), Y_CRISTAL - 6 - 250 * (1 - b) + Math.sin(s * 2.1) * 3, -0.86, {s});
    etiqueta(g, rampa(s, 0.6, 0.85), 'CRISTAL', 595, 960, 597, 1088);
    etiqueta(g, rampa(s, 0.9, 1.15), 'CABLES', 688, 885, 690, 1173);
    etiqueta(g, rampa(s, w(9, 'suave'), w(9, 'suave') + 0.25), 'CARGA', 522, 800, 555, 1080);
  }},
  // 02 — el boli aprieta
  {id: 'p02', t0: w(13, 'pero'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, lerp(1.05, 1.22, rampa(l, 0, 2.2, 'lineal')), 640, 990);
    cuadricula(g);
    seccion(g, s, {atr: [{x: TX, f: 1}]});
    const ta = w(15, 'aprietas');
    const pb = rampa(s, ta - 0.1, ta + 0.25, 'salida');
    const py = lerp(712, Y_CRISTAL - 10, pb) + (pb > 0.95 ? Math.sin(s * 60) * 2 : 0);
    if (pb > 0.95) chispas(g, 760, Y_CRISTAL - 10, s - ta - 0.25, 22);
    boli(g, lerp(800, 760, pb), py, lerp(0.5, 0.38, pb));
    dedo(g, TX, Y_CRISTAL - 6, -0.86, {s});
  }},
  // 03 — macro de las chispas: "ni se entera"
  {id: 'p03', t0: w(22, 'fuerzas'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, lerp(1.75, 1.85, rampa(l, 0, 2, 'lineal')), 740, 1010);
    cuadricula(g);
    seccion(g, s, {atr: [{x: TX, f: 1}]});
    chispas(g, 760, Y_CRISTAL - 10, l + 0.6, 34);
    boli(g, 760 + Math.sin(s * 50) * 3, Y_CRISTAL - 10, 0.38);
    dedo(g, TX, Y_CRISTAL - 6, -0.86, {s});
  }},
  // 04 — "¿qué es lo que está notando de verdad?"
  {id: 'p04', t0: w(26, 'entonces'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, lerp(1.0, 1.05, rampa(l, 0, 2.2, 'lineal')), 540, 1000);
    cuadricula(g);
    const sube = rampa(s, w(26, 'entonces') + 0.1, w(26, 'entonces') + 0.7, 'suave');
    const vuelve = rampa(s, w(32, 'notando'), w(32, 'notando') + 0.35, 'salida');
    const dy = 220 * sube * (1 - vuelve);
    seccion(g, s, {atr: [{x: TX, f: 1 - sube * (1 - vuelve)}]});
    boli(g, 760 + 40 * sube, Y_CRISTAL - 10 - 380 * sube, 0.38 + 0.12 * sube);
    dedo(g, TX, Y_CRISTAL - 6 - dy, -0.86, {s});
  }},
  // 05 — "No es la presión: es la electricidad de tu cuerpo"
  {id: 'p05', t0: w(35, 'no'), dib: (g, s, l) => {
    fondo(g, s);
    const tc = w(44, 'cuerpo');
    cam(g, kf(l, [[0, 1.05], [0.5, 1.3, 'suave'], [4, 1.38, 'lineal']]), kf(l, [[0, 540], [0.5, 470, 'suave']]), 1010);
    cuadricula(g);
    const elec = rampa(s, w(41, 'electricidad'), w(41, 'electricidad') + 0.4);
    seccion(g, s, {atr: [{x: TX, f: 1 + elec * 0.4, ancho: 330 + elec * 120}]});
    boli(g, 800 + 400 * rampa(l, 0, 0.6, 'entrada'), 712 - 500 * rampa(l, 0, 0.6, 'entrada'), 0.5);
    dedo(g, TX, Y_CRISTAL - 6, -0.86, {oro: rampa(s, tc, tc + 0.35), R: 165, s});
    etiqueta(g, rampa(s, w(38, 'presion'), w(38, 'presion') + 0.25), 'PRESIÓN ✕', 640, 830, 700, 960, 30);
  }},
  // 06 — invierno: mano con guante y teléfono bloqueado
  {id: 'p06', t0: w(45, 'imagina'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    cam(g, lerp(1.0, 1.06, rampa(l, 0, 2, 'lineal')), 540, 1180);
    for (let k = 0; k < 60; k++) {
      const x = rnd(k + 300) * W, y = (rnd(k + 400) * H + s * (60 + rnd(k) * 80)) % H;
      g.fillStyle = 'rgba(255,255,255,0.55)';
      g.beginPath(); g.arc(x, y, 2 + rnd(k + 2) * 3, 0, 7); g.fill();
    }
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => pantalla(gg, ww, hh, 'bloqueo', s, {copos: rampa(s, w(48, 'invierno'), w(48, 'invierno') + 0.4)}));
  }},
  // 07 — te llaman con los guantes puestos
  {id: 'p07', t0: w(50, 'te'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    cam(g, lerp(1.05, 1.12, rampa(l, 0, 2.2, 'lineal')), 540, 1200);
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => {
      pantalla(gg, ww, hh, 'llamada', s, {boton: 0.05 * Math.max(0, Math.sin(s * 9))});
    });
    // el dedo enguantado intenta deslizar (no responde)
    const ent = rampa(s, w(53, 'llevas') - 0.2, w(53, 'llevas') + 0.3, 'salida');
    const roce = Math.sin(Math.max(0, s - w(53, 'llevas')) * 7) * 22;
    dedoTocando(g, lerp(900, 420 + roce, ent), lerp(2000, 1600, ent), -0.5, 92, true);
  }},
  // 08 — debajo del cristal: zoom a través de la pantalla → rejilla
  {id: 'p08', t0: w(57, 'debajo'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    const z = kf(l, [[0, 1.12], [0.8, 2.6, 'suave'], [3, 2.75, 'lineal']]);
    cam(g, z, 520, 1150);
    const malOp = rampa(s, w(62, 'rejilla') - 0.2, w(64, 'cables'), 'suave');
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => {
      pantalla(gg, ww, hh, 'llamada', s);
      gg.fillStyle = `rgba(20,22,28,${malOp * 0.8})`;
      gg.fillRect(0, 0, ww, hh);
      malla(gg, 0, 0, ww, hh, 34, malOp, null, 0, null, 0, s);
    });
  }},
  // 09 — filas y columnas
  {id: 'p09', t0: w(69, 'filas'), dib: (g, s) => {
    fondo(g, s, 'negro');
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.fillStyle = '#16181d';
    g.fillRect(0, 0, W, H);
    const fp = rampa(s, w(69, 'filas'), w(72, 'sentido') + 0.3, 'suave');
    const cp = rampa(s, w(74, 'columnas'), w(77, 'otro') + 0.3, 'suave');
    malla(g, 30, 420, 1020, 1480, 120, 1, 960, fp, 780, cp, s);
    rotulo(g, rampa(s, w(69, 'filas'), w(69, 'filas') + 0.2), 'FILA', 50, 935, 24);
    rotulo(g, rampa(s, w(74, 'columnas'), w(74, 'columnas') + 0.2), 'COLUMNA', 800, 1280, 24);
  }},
  // 10 — inclinación 3D y macro del cruce
  {id: 'p10', t0: w(78, 'cada'), dib: (g, s, l) => {
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.fillStyle = '#121418';
    g.fillRect(0, 0, W, H);
    const incl = kf(l, [[0, 0], [0.9, 0.95, 'suave']]);
    const dist = kf(l, [[0, 2400], [0.9, 1500, 'suave'], [5, 1250, 'lineal']]);
    const p = proyector(540, 1150, incl, dist, 1500, kf(l, [[0, 0], [5, 0.12, 'lineal']]));
    const tg = w(90, 'guarda');
    const tc = w(93, 'carga');
    const amb = rampa(s, tg, tg + 0.4);
    rejilla3D(g, p, 8, 300, {ambar: [[3, 3, amb], [4, 3, amb * 0.8], [3, 4, amb * 0.8], [4, 4, amb]]});
    const [nx, ny, k] = p(0, 0);
    const cr = rampa(s, w(84, 'cruza') - 0.1, w(84, 'cruza') + 0.3);
    if (cr > 0) {
      g.strokeStyle = `rgba(255,255,255,${cr})`;
      g.lineWidth = 3;
      g.beginPath(); g.arc(nx, ny, 40 * k * 3, 0, 7 * cr); g.stroke();
    }
    const ca = rampa(s, tc, tc + 0.35);
    if (ca > 0) arcosEn(g, nx, ny, k * 2.4 * (1 - 0.35 * rampa(s, w(95, 'diminuta'), w(95, 'diminuta') + 0.4)), s, ca);
    etiqueta(g, cr, 'CRUCE', nx - 260, ny - 230, nx - 30, ny - 10, 30);
    etiqueta(g, ca, 'CARGA', nx + 60, ny - 330, nx + 40, ny - 120, 30);
  }},
  // 11 — campo de lecturas: "comprueba todos esos cruces una y otra vez"
  {id: 'p11', t0: w(96, 'y'), dib: (g, s, l) => {
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.fillStyle = '#101216';
    g.fillRect(0, 0, W, H);
    const p = proyector(540, 1100, 0.95, kf(l, [[0, 1250], [0.6, 3100, 'suave'], [3, 3300, 'lineal']]), 1500, 0.12);
    const barrido = ((s - w(97, 'revisa')) * 3) % 1;
    rejilla3D(g, p, 22, 300, {valores: (i, j) => (Math.abs(j / 22 - barrido) < 0.05 ? 100 : 100), blancas: Array.from({length: 22}, (_, i) => [i, Math.floor(barrido * 22), 0.25] as [number, number, number])});
    const n = Math.round(interpolate(s, [w(97, 'revisa'), w(104, 'vez')], [0, 120], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'}));
    if (n > 0) {
      g.fillStyle = 'rgba(14,16,20,0.85)';
      g.beginPath(); g.roundRect(330, 1560, 420, 90, 18); g.fill();
      g.font = `700 54px "Cascadia Mono", Consolas, monospace`;
      g.fillStyle = '#fff';
      g.fillText(String(n), 355, 1625);
      g.font = `700 22px ${FF}`;
      g.fillText('lecturas por segundo', 490, 1605);
      g.font = `500 17px ${FF}`;
      g.fillStyle = 'rgba(255,255,255,0.6)';
      g.fillText('en cada cruce', 490, 1632);
    }
  }},
  // 12 — "Tu cuerpo es casi todo agua"
  {id: 'p12', t0: w(105, 'tu'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, lerp(1.15, 1.22, rampa(l, 0, 1.4, 'lineal')), 520, 1050);
    cuadricula(g);
    seccion(g, s, {valores: true});
    dedo(g, 500, Y_CRISTAL - 150 + Math.sin(s * 2) * 4, -0.55, {R: 240, s});
  }},
  // 13 — rayos X: agua con sal que conduce
  {id: 'p13', t0: w(110, 'agua'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.22], [0.4, 1.45, 'suave'], [2, 1.5, 'lineal']]), 470, 860);
    cuadricula(g);
    seccion(g, s, {valores: true});
    dedo(g, 500, Y_CRISTAL - 150 + Math.sin(s * 2) * 4, -0.55, {R: 240, iones: rampa(l, 0, 0.35), ionesOro: rampa(s, w(115, 'conduce'), w(115, 'conduce') + 0.4), s});
  }},
  // 14 — el dedo toca y se lleva carga
  {id: 'p14', t0: w(118, 'cuando'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.05], [5, 1.12, 'lineal']]), 520, 1080);
    cuadricula(g);
    const baja = rampa(s, w(119, 'acercas'), w(125, 'cristal'), 'suave');
    const lleva = rampa(s, w(127, 'lleva'), w(127, 'lleva') + 0.5);
    seccion(g, s, {atr: [{x: 500, f: lleva}], valores: true, llave: s > w(138, 'justo') ? [380, 620] : null});
    dedo(g, 500, lerp(Y_CRISTAL - 230, Y_CRISTAL - 6, baja), -0.55, {R: 210, oro: lleva * 0.7, s});
  }},
  // 15 — el móvil ve la bajada: "esto es un toque"
  {id: 'p15', t0: w(140, 'el'), dib: (g, s, l) => {
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.fillStyle = '#101216';
    g.fillRect(0, 0, W, H);
    const p = proyector(540, 1080, 0.85, kf(l, [[0, 2600], [0.6, 2100, 'suave'], [4, 1950, 'lineal']]), 1500, 0.2);
    const dip = rampa(s, w(145, 'bajada'), w(145, 'bajada') + 0.5);
    const toque = rampa(s, w(155, 'toque'), w(155, 'toque') + 0.25);
    const val = (i: number, j: number) => {
      const d = Math.hypot(i - 7, j - 7);
      return Math.round(100 - dip * Math.max(0, 38 - d * 13) + (d < 3 ? Math.sin(s * 9 + i * j) : 0));
    };
    const blancas: [number, number, number][] = [];
    for (let i = 5; i < 9; i++) for (let j = 5; j < 9; j++) blancas.push([i, j, toque * (Math.hypot(i - 6.5, j - 6.5) < 2 ? 1 : 0)]);
    rejilla3D(g, p, 14, 260, {valores: val, blancas});
    circuloPlano(g, p, 0, 0, 470, rampa(s, w(146, 'justo'), w(146, 'justo') + 0.4));
  }},
  // 16 — dos dedos a la vez
  {id: 'p16', t0: w(156, 'y'), dib: (g, s, l) => {
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.fillStyle = '#101216';
    g.fillRect(0, 0, W, H);
    const p = proyector(540, 1080, kf(l, [[0, 0.85], [3, 0.75, 'lineal']]), 2000, 1500, kf(l, [[0, 0.2], [3.5, -0.05, 'lineal']]));
    const d2 = rampa(s, w(165, 'dos'), w(165, 'dos') + 0.5);
    const val = (i: number, j: number) => {
      const a = Math.max(0, 38 - Math.hypot(i - 7, j - 7) * 13);
      const b = d2 * Math.max(0, 38 - Math.hypot(i - 10, j - 3) * 13);
      return Math.round(100 - Math.max(a, b));
    };
    rejilla3D(g, p, 14, 260, {valores: val});
    circuloPlano(g, p, 0, 0, 470, 1);
    circuloPlano(g, p, 780, -1040, 470, d2);
  }},
  // 17 — zoom pellizcando
  {id: 'p17', t0: w(170, 'que'), dib: (g, s) => {
    fondo(g, s, 'negro');
    cam(g, 1, 540, 1150);
    const z = rampa(s, w(174, 'zoom'), w(175, 'pellizcando') + 0.4, 'suave');
    telefono(g, 540, 1150, 560, 1150, (gg, ww, hh) => pantalla(gg, ww, hh, 'foto', s, {zoomFoto: 1 + z * 0.9}));
    dedoTocando(g, lerp(470, 330, z), lerp(1250, 1400, z), 0.35, 78, false);
    dedoTocando(g, lerp(600, 760, z), lerp(1080, 900, z), -0.35, 78, false);
  }},
  // 18 — el guante no conduce
  {id: 'p18', t0: w(176, 'pero'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.3], [0.5, 1.15, 'suave'], [4, 1.1, 'lineal']]), 520, 1020);
    cuadricula(g);
    seccion(g, s, {valores: true});
    const ap = rampa(s, w(188, 'apretando'), w(188, 'apretando') + 0.3);
    dedo(g, 500, lerp(Y_CRISTAL - 200, Y_CRISTAL - 30, ap) + (ap > 0.9 ? Math.sin(s * 40) * 2 : 0), -0.6, {R: 200, guante: 1, s});
    etiqueta(g, rampa(s, w(178, 'guante'), w(178, 'guante') + 0.25), 'LANA', 760, 760, 730, 900, 28);
  }},
  // 19 — la carga ni se mueve (contraste con un dedo sin guante)
  {id: 'p19', t0: w(191, 'y'), dib: (g, s) => {
    fondo(g, s);
    cam(g, 1.0, 560, 1000);
    cuadricula(g);
    const piel = rampa(s, w(193, 'carga') + 0.3, w(193, 'carga') + 0.8, 'salida');
    seccion(g, s, {atr: [{x: 860, f: piel * rampa(s, w(196, 'mueve'), w(196, 'mueve') + 0.3)}], valores: true});
    dedo(g, 380, Y_CRISTAL - 30, -0.6, {R: 190, guante: 1, s});
    dedo(g, 880, lerp(Y_CRISTAL - 600, Y_CRISTAL - 6, piel), 0.55, {R: 150, s});
    etiqueta(g, rampa(s, w(200, 'nadie'), w(200, 'nadie') + 0.25), 'SIN CAMBIO', 250, 1400, 380, 1290, 26);
  }},
  // 20 — la pantalla se vuelve loca cuando llueve
  {id: 'p20', t0: w(203, 'por'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    cam(g, lerp(1.0, 1.08, rampa(l, 0, 2.5, 'lineal')), 540, 1180);
    const llueve = rampa(s, w(210, 'loca') - 0.6, w(212, 'llueve'));
    for (let k = 0; k < 90 * llueve; k++) {
      const x = rnd(k + 500) * W, y = (rnd(k + 600) * H + s * 1400) % H;
      g.strokeStyle = 'rgba(180,210,255,0.45)';
      g.lineWidth = 2;
      g.beginPath(); g.moveTo(x, y); g.lineTo(x - 6, y + 40); g.stroke();
    }
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => pantalla(gg, ww, hh, l < 0.7 ? 'bloqueo' : 'home', s, {gotas: llueve, caos: rampa(s, w(210, 'loca'), w(210, 'loca') + 0.3)}));
  }},
  // 21 — cada gota parece un dedo
  {id: 'p21', t0: w(213, 'el'), dib: (g, s) => {
    fondo(g, s);
    cam(g, 1.0, 560, 1000);
    cuadricula(g);
    const cae = rampa(s, w(214, 'agua'), w(216, 'conduce'), 'entrada');
    const conduce = rampa(s, w(216, 'conduce'), w(216, 'conduce') + 0.4);
    const ddo = rampa(s, w(223, 'dedo') - 0.5, w(223, 'dedo'), 'salida');
    seccion(g, s, {atr: [{x: 380, f: conduce}, {x: 860, f: ddo}], valores: true});
    // gota
    const gy = lerp(500, Y_CRISTAL - 40, cae);
    const aplasta = conduce;
    g.fillStyle = 'rgba(190,220,255,0.35)';
    g.strokeStyle = 'rgba(255,255,255,0.85)';
    g.lineWidth = 3;
    g.beginPath();
    if (aplasta < 0.05) {
      g.moveTo(380, gy - 70); g.bezierCurveTo(420, gy - 10, 420, gy + 40, 380, gy + 40); g.bezierCurveTo(340, gy + 40, 340, gy - 10, 380, gy - 70);
    } else {
      g.ellipse(380, Y_CRISTAL - 2, 70 + 20 * aplasta, 60 - 25 * aplasta, 0, Math.PI, 0);
    }
    g.fill(); g.stroke();
    if (ddo > 0) dedo(g, 880, lerp(Y_CRISTAL - 500, Y_CRISTAL - 6, ddo), 0.55, {R: 150, s});
  }},
  // 22 — guantes táctiles: sí responde
  {id: 'p22', t0: w(224, 'y'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    cam(g, lerp(1.04, 1.1, rampa(l, 0, 2.5, 'lineal')), 540, 1200);
    const desl = rampa(s, w(232, 'tactiles') - 0.2, w(232, 'tactiles') + 0.4, 'suave');
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => pantalla(gg, ww, hh, 'llamada', s, {boton: desl}));
    const ent = rampa(s, w(227, 'funcionan'), w(227, 'funcionan') + 0.4, 'salida');
    dedoTocando(g, lerp(900, 365 + desl * 290, ent), lerp(2000, 1600, ent), -0.5, 92, true, rampa(s, w(229, 'guantes'), w(229, 'guantes') + 0.3));
  }},
  // 23 — tejido: el hilo conductor
  {id: 'p23', t0: w(233, 'llevan'), corte: 'duro', dib: (g, s) => {
    tejido(g, s, rampa(s, w(235, 'hilo'), w(235, 'hilo') + 0.5));
  }},
  // 24 — el hilo lleva la electricidad hasta el cristal
  {id: 'p24', t0: w(239, 'que'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.3], [0.5, 1.15, 'suave'], [4, 1.1, 'lineal']]), 520, 1020);
    cuadricula(g);
    const oro = rampa(s, w(240, 'conduce'), w(244, 'electricidad'), 'suave');
    const llega = rampa(s, w(250, 'cristal') - 0.2, w(250, 'cristal') + 0.3);
    seccion(g, s, {atr: [{x: 500, f: llega}], valores: true});
    dedo(g, 500, Y_CRISTAL - 30, -0.6, {R: 200, guante: 1, guanteOro: oro, oro: oro * 0.5, s});
    etiqueta(g, rampa(l, 0.2, 0.45), 'HILO CONDUCTOR', 620, 760, 720, 900, 26);
  }},
  // 25 — "Así que tu pantalla…" (llamada contestada)
  {id: 'p25', t0: w(251, 'asi'), dib: (g, s) => {
    fondo(g, s, 'negro');
    cam(g, 1.06, 540, 1200);
    manoTelefono(g, 520, 1200, 440, (gg, ww, hh) => pantalla(gg, ww, hh, 'encurso', s));
  }},
  // 26 — nunca ha sentido tu dedo: solo un poquito de carga que se esfuma
  {id: 'p26', t0: w(255, 'nunca'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.35], [4, 1.45, 'lineal']]), 500, 1020);
    cuadricula(g);
    const ve = rampa(s, w(257, 'sentido'), w(257, 'sentido') + 0.4);
    const esf = rampa(s, w(268, 'esfumaba'), w(268, 'esfumaba') + 0.8, 'suave');
    seccion(g, s, {unArco: {x: 470, f: 1, brillo: ve * (1 - esf * 0.85)}, valores: true, atr: [{x: 470, f: 0.55 * ve, ancho: 110}]});
    dedo(g, 480, Y_CRISTAL - 40, -0.6, {R: 230, s});
    rotulo(g, rampa(s, w(264, 'poquito'), w(264, 'poquito') + 0.25), 'menos de 1 pF', 560, 1110, 22);
  }},
  // 27 — tu dedo solo era lo que se la llevaba
  {id: 'p27', t0: w(269, 'y'), dib: (g, s, l) => {
    fondo(g, s);
    cam(g, kf(l, [[0, 1.45], [3, 1.55, 'lineal']]), 470, 900);
    cuadricula(g);
    seccion(g, s, {valores: true, apagado: 0.3});
    dedo(g, 480, Y_CRISTAL - 40, -0.6, {R: 230, remolino: rampa(s, w(278, 'llevaba') - 0.2, w(278, 'llevaba') + 0.3), s});
  }},
  // 28 — cierre: el video dentro de Instagram, seguir y compartir
  {id: 'p28', t0: w(279, 'sigueme'), dib: (g, s, l) => {
    fondo(g, s, 'negro');
    cam(g, 1, 540, 1100);
    const tSeg = w(279, 'sigueme') + 0.25;
    const tCom = w(281, 'mandaselo');
    const tAmi = w(284, 'amigo');
    const tEnv = w(289, 'funciona');
    const hoja = rampa(s, tCom + 0.15, tCom + 0.5, 'salida');
    const TW = 640;
    telefono(g, 540, 1100, TW, TW * 2.05, (gg, ww, hh) => {
      gg.save();
      const k = ww / W;
      gg.scale(k * 1.3, k * 1.3);
      gg.translate(-120, -420);
      gg.fillStyle = '#0c1018'; gg.fillRect(0, 0, W * 2, H * 2);
      seccion(gg, s, {valores: true});
      dedo(gg, 480, Y_CRISTAL - 40, -0.6, {R: 230, remolino: 1, s});
      gg.restore();
      // UI de Instagram
      const t = (x: string, px: number, py: number, tam: number, peso = 600, c = '#fff') => { gg.font = `${peso} ${tam}px ${FF}`; gg.fillStyle = c; gg.fillText(x, px, py); };
      ['♡', '💬', '⟲', '➤'].forEach((ic, i) => t(ic, ww - 62, hh * 0.52 + i * 78, 34, 400, i === 3 && s > tCom ? '#0095f6' : '#fff'));
      gg.fillStyle = '#3a77d5'; gg.beginPath(); gg.arc(40, hh * 0.84, 20, 0, 7); gg.fill();
      t('resultaaquee', 70, hh * 0.84 + 7, 20, 700);
      const sig = s > tSeg;
      gg.strokeStyle = 'rgba(255,255,255,0.6)'; gg.lineWidth = 1.5;
      gg.beginPath(); gg.roundRect(200, hh * 0.84 - 15, sig ? 98 : 76, 30, 8); gg.stroke();
      if (sig) { gg.fillStyle = 'rgba(255,255,255,0.15)'; gg.fill(); }
      t(sig ? 'Siguiendo' : 'Seguir', 210, hh * 0.84 + 6, 16, 700);
      t('Por qué tu pantalla nota tu dedo y no una pluma…', 26, hh * 0.885, 16, 500, 'rgba(255,255,255,0.85)');
      gg.fillStyle = '#000'; gg.fillRect(0, hh * 0.93, ww, hh * 0.07);
      ['⌂', '▢', '▷', '⌕', '●'].forEach((ic, i) => t(ic, 40 + i * (ww - 80) / 4 - 8, hh * 0.975, 26, 400));
      // hoja de compartir
      if (hoja > 0) {
        const hy = hh * (1 - 0.48 * hoja);
        gg.fillStyle = '#1c1c1e';
        gg.beginPath(); gg.roundRect(0, hy, ww, hh * 0.5, 26); gg.fill();
        gg.fillStyle = '#2c2c2e'; gg.beginPath(); gg.roundRect(24, hy + 34, ww - 48, 44, 12); gg.fill();
        t('🔍 Buscar', 40, hy + 64, 18, 500, '#999');
        const nombres = ['Sofía', 'Daniel', 'Mei', 'Lucas'];
        const colores = ['#d9a066', '#4a7bd9', '#e0c3a0', '#6fbf73'];
        nombres.forEach((n, i) => {
          const ax = 70 + i * ((ww - 140) / 3);
          gg.fillStyle = colores[i]; gg.beginPath(); gg.arc(ax, hy + 150, 44, 0, 7); gg.fill();
          gg.fillStyle = '#5a3a26'; gg.beginPath(); gg.arc(ax, hy + 146, 22, 0, 7); gg.fill();
          if (i === 0 && s > tAmi) { gg.fillStyle = '#0095f6'; gg.beginPath(); gg.arc(ax + 32, hy + 182, 15, 0, 7); gg.fill(); t('✓', ax + 25, hy + 189, 18, 800); }
          gg.font = `500 17px ${FF}`; gg.fillStyle = '#fff'; gg.textAlign = 'center'; gg.fillText(n, ax, hy + 220); gg.textAlign = 'start';
        });
        const env = s > tEnv;
        gg.fillStyle = env ? '#3a3a3c' : s > tAmi ? '#0095f6' : '#2c2c2e';
        gg.beginPath(); gg.roundRect(24, hy + 270, ww - 48, 58, 12); gg.fill();
        gg.font = `700 22px ${FF}`; gg.fillStyle = '#fff'; gg.textAlign = 'center';
        gg.fillText(env ? '✓ Enviado' : 'Enviar', ww / 2, hy + 307); gg.textAlign = 'start';
      }
    });
    // gotas flotando: "manos mojadas"
    const moj = rampa(s, w(295, 'mojadas') - 0.2, w(295, 'mojadas') + 0.4);
    for (let k = 0; k < 18 * moj; k++) {
      const x = 260 + rnd(k + 900) * 560, y = 700 + rnd(k + 950) * 900 - l * 30;
      const r = 8 + rnd(k) * 14;
      g.fillStyle = 'rgba(200,225,255,0.25)'; g.strokeStyle = 'rgba(255,255,255,0.75)'; g.lineWidth = 2;
      g.beginPath(); g.arc(x, y, r, 0, 7); g.fill(); g.stroke();
    }
    // dedo que toca Seguir → compartir → Sofía → Enviar
    const objetivos: [number, number, number][] = [[w(279, 'sigueme') - 0.3, 900, 2000], [tSeg, 540 - TW / 2 + 260, 1100 + TW * 1.025 * 0.68], [tCom, 540 + TW / 2 - 50, 1100 + TW * 1.025 * 0.05 + 230], [tAmi, 540 - TW / 2 + 85, 1100 + TW * 1.025 * 0.4], [tEnv, 540, 1100 + TW * 1.025 * 0.65], [tEnv + 0.6, 900, 2100]];
    let fx = objetivos[0][1], fy = objetivos[0][2];
    for (let i = 1; i < objetivos.length; i++) {
      const [t1, x1, y1] = objetivos[i];
      const p = rampa(s, t1 - 0.35, t1, 'suave');
      fx = lerp(fx, x1, p); fy = lerp(fy, y1, p);
    }
    dedoTocando(g, fx, fy, -0.45, 70, false);
  }},
];

const CORTES = PLANOS.map((p) => p.t0);

function dibujar(g: G, s: number) {
  let k = 0;
  for (let i = 0; i < PLANOS.length; i++) if (s >= PLANOS[i].t0 - 0.06) k = i;
  const pl = PLANOS[k];
  g.save();
  pl.dib(g, s, s - pl.t0);
  g.restore();
  g.setTransform(1, 0, 0, 1, 0, 0);
}

// ===================================================================== sonido
const tCorte = PLANOS.slice(1).map((p) => p.t0);
const SFX: [number, string, number][] = [
  ...tCorte.map((t, i) => [t - 0.12, i % 3 === 0 ? 'whoosh-short.mp3' : i % 3 === 1 ? 'whoosh.mp3' : 'click-soft.mp3', i % 3 === 2 ? 0.25 : 0.22] as [number, string, number]),
  [0.5, 'sparkle.mp3', 0.25], [w(15, 'aprietas') + 0.2, 'glitch-3.mp3', 0.2], [w(44, 'cuerpo'), 'sparkle.mp3', 0.3],
  [w(51, 'llaman'), 'notification.mp3', 0.25], [w(62, 'rejilla'), 'riser.mp3', 0.0], [w(69, 'filas'), 'whoosh-short.mp3', 0.2],
  [w(74, 'columnas'), 'whoosh-short.mp3', 0.2], [w(84, 'cruza'), 'ping.mp3', 0.25], [w(93, 'carga'), 'sparkle.mp3', 0.3],
  [w(97, 'revisa'), 'typing.mp3', 0.15], [w(115, 'conduce'), 'sparkle.mp3', 0.3], [w(127, 'lleva'), 'sparkle.mp3', 0.25],
  [w(155, 'toque'), 'pop.mp3', 0.35], [w(165, 'dos'), 'pop.mp3', 0.3], [w(188, 'apretando'), 'click-soft.mp3', 0.3],
  [w(210, 'loca'), 'glitch-1.mp3', 0.18], [w(216, 'conduce'), 'pop.mp3', 0.3], [w(232, 'tactiles'), 'chime.mp3', 0.25],
  [w(235, 'hilo'), 'sparkle.mp3', 0.3], [w(250, 'cristal'), 'sparkle.mp3', 0.3], [w(268, 'esfumaba'), 'whoosh-short.mp3', 0.15],
  [w(279, 'sigueme') + 0.25, 'click.mp3', 0.35], [w(281, 'mandaselo'), 'click.mp3', 0.35], [w(284, 'amigo'), 'click-soft.mp3', 0.3],
  [w(289, 'funciona'), 'click.mp3', 0.3], [w(289, 'funciona') + 0.1, 'notification.mp3', 0.2],
];

// ===================================================================== composición
const SPEC: VideoSpec = {
  titulo: 'electro', estilo: 'estudio-oscuro', palabras: P, escenas: [],
  claves: ['celular#1', 'suave', 'aprietas', 'fuerzas', 'entera', 'notando', 'presión', 'cuerpo#1', 'invierno', 'guantes#1', 'cristal#1', 'rejilla', 'filas', 'columnas',
    'cruza', 'columna', 'diminuta', 'cruces#1', 'cuerpo#2', 'sal', 'conduce#1', 'yema', 'debajo', 'pequeña', 'toque', 'separado', 'dos', 'zoom', 'guante', 'apretando', 'mueve',
    'nadie', 'loca', 'agua#2', 'dedo#5', 'táctiles', 'hilo', 'cristal#4', 'pantalla#3', 'sentido#1', 'poquito', 'esfumaba', 'llevaba', 'sígueme', 'mándaselo', 'mojadas'],
  emojis: {celular: '📱', sal: '💧', invierno: '❄️', mojadas: '💦', guantes: '🧤'},
};

export const ElectroCompleto: React.FC = () => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();
  const s = frame / fps;
  const ref = useRef<HTMLCanvasElement>(null);
  useLayoutEffect(() => {
    const g = ref.current!.getContext('2d')!;
    dibujar(g, s);
  }, [s]);
  // transición: empuje con desenfoque de 8 cuadros alrededor de cada corte
  let blur = 0, esc = 1;
  for (const [i, c] of CORTES.entries()) {
    if (i === 0 || PLANOS[i].corte === 'duro') continue;
    const d = s - c;
    if (Math.abs(d) < 0.14) {
      const q = 1 - Math.abs(d) / 0.14;
      blur = Math.max(blur, q * 20);
      esc = d < 0 ? 1 + 0.08 * q : 1 + 0.08 * q * 0.6;
    }
  }
  const reloj = useMemo(() => crearReloj(P, fps), [fps]);
  const palabras = useMemo(() => prepararPalabras(SPEC), []);
  return (
    <VideoCtx.Provider value={{spec: SPEC, reloj, estilo: 'estudio-oscuro', palabras}}>
      <AbsoluteFill style={{background: '#07090d'}}>
        <canvas ref={ref} width={W} height={H} style={{width: W, height: H, filter: blur > 0.2 ? `blur(${blur}px)` : undefined, scale: String(esc)}} />
        <AbsoluteFill style={{background: 'linear-gradient(180deg, rgba(5,6,9,0.75) 0%, rgba(5,6,9,0.35) 18%, rgba(5,6,9,0) 28%)'}} />
        <Subtitulos palabras={palabras} />
        <Audio src={staticFile('voz/electro.mp3')} volume={0.8} />
        <Audio src={staticFile('voz/electro-musica.mp3')} volume={(f) => 0.1 * interpolate(f, [DURACION_ELECTRO * fps - 40, DURACION_ELECTRO * fps], [1, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'})} />
        {SFX.filter(([, , v]) => v > 0).map(([t, f, v], i) => (
          <Sequence key={i} from={Math.max(0, Math.round(t * fps))} durationInFrames={Math.round(2.5 * fps)} layout="none">
            <Audio src={staticFile(`sfx-hf/${f}`)} volume={v * 0.7} />
          </Sequence>
        ))}
      </AbsoluteFill>
    </VideoCtx.Provider>
  );
};
