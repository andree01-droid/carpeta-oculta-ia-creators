"""Mide subtítulos y colores en fotogramas de referencia (720x1280)."""
import sys, glob, os
import numpy as np
from PIL import Image

def hexc(c):
    return "#%02x%02x%02x" % tuple(int(v) for v in c[:3])

for f in sorted(glob.glob("videos_referencia/fullres/*.png")):
    im = np.asarray(Image.open(f).convert("RGB")).astype(int)
    h, w, _ = im.shape
    top = im[120:400]
    lum = top.mean(axis=2)
    # filas con texto blanco brillante (palabra activa)
    bright = (lum > 225) & (np.ptp(top, axis=2) < 25)
    rows = np.where(bright.sum(axis=1) > 2)[0]
    cols = np.where(bright.sum(axis=0) > 0)[0]
    info = ""
    if len(rows):
        # agrupar filas en líneas
        groups, start, prev = [], rows[0], rows[0]
        for r in rows[1:]:
            if r - prev > 6:
                groups.append((start + 120, prev + 120)); start = r
            prev = r
        groups.append((start + 120, prev + 120))
        info = f"lineas blancas y={groups} x={cols.min()}-{cols.max()}"
    # azul de la caja de selección
    b = im[120:400]
    blue = (b[:, :, 2] > 180) & (b[:, :, 0] < 120) & (b[:, :, 1] > 90) & (b[:, :, 1] < 200)
    bc = b[blue]
    binfo = f"azul caja n={len(bc)} med={hexc(np.median(bc,axis=0))}" if len(bc) > 20 else ""
    # gris palabras inactivas: píxeles grises medios poco saturados en zona de texto
    g = top[(lum > 110) & (lum < 190) & (np.ptp(top, axis=2) < 18)]
    ginfo = f"gris={hexc(np.median(g,axis=0))} n={len(g)}" if len(g) > 50 else ""
    # fondo: esquinas y centro
    corners = [im[20:60, 20:60], im[-60:-20, 20:60], im[600:680, 340:380], im[-60:-20, -60:-20]]
    bg = " ".join(hexc(np.median(c.reshape(-1, 3), axis=0)) for c in corners)
    # paleta dominante
    q = Image.open(f).convert("RGB").resize((180, 320)).quantize(colors=8, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()[:24]
    counts = sorted(q.getcolors(), reverse=True)
    paleta = " ".join(f"{hexc(pal[i*3:i*3+3])}({n*100//(180*320)}%)" for n, i in counts)
    print(os.path.basename(f), "|", info, "|", binfo, "|", ginfo)
    print("   fondo(esq/centro):", bg)
    print("   paleta:", paleta)
