.fila { position: absolute; left: 0; right: 0; display: flex; justify-content: center; }
.chip { padding: 14px 38px; border-radius: 999px; font-weight: 800; font-size: 50px; white-space: nowrap; }
.etq { position: absolute; font-weight: 800; font-size: 40px; color: #fff; white-space: nowrap; }
.dedo { position: absolute; width: 74px; height: 104px; border-radius: 37px 37px 30px 30px;
  background: linear-gradient(180deg, #E8B496 0%, #C98B6B 100%); box-shadow: 0 12px 24px rgba(0,0,0,0.5); }
.dedo::after { content: ""; position: absolute; left: 14px; right: 14px; top: 8px; height: 40px; border-radius: 20px 20px 12px 12px;
  background: linear-gradient(180deg, #F6D9CF, #E7C1B3); opacity: 0.9; }
.anillo { position: absolute; border-radius: 50%; border: 4px solid #EFA32D; }
