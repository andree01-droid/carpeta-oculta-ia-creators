"""Busca imágenes de stock con licencia libre (Openverse) y, si se pide, las descarga con su crédito.

Uso:
  stock.py buscar "<consulta>" [--n 8]                    → lista resultados (id, tamaño, licencia, autor, título)
  stock.py bajar <id> <destino.jpg> [--creditos archivo]   → descarga y agrega el crédito a CREDITOS.md

Solo licencias que permiten uso comercial y modificación (CC0, PDM, CC BY, CC BY-SA).
"""
import json, os, sys, urllib.parse, urllib.request

API = "https://api.openverse.org/v1/images/"
UA = {"User-Agent": "motion-graphics-ia/1.0 (videos educativos)"}


def get(url):
    return json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=40))


def buscar(q, n=8):
    params = {"q": q, "license_type": "commercial,modification", "page_size": n, "mature": "false"}
    d = get(API + "?" + urllib.parse.urlencode(params))
    for r in d.get("results", []):
        print(f"{r['id']} | {r.get('width')}x{r.get('height')} | {r.get('license')} {r.get('license_version') or ''} | "
              f"{(r.get('creator') or '?')[:30]} | {(r.get('title') or '')[:70]}")


def bajar(id_, destino, creditos):
    r = get(API + id_ + "/")
    os.makedirs(os.path.dirname(os.path.abspath(destino)), exist_ok=True)
    data = urllib.request.urlopen(urllib.request.Request(r["url"], headers=UA), timeout=90).read()
    open(destino, "wb").write(data)
    linea = (f"- `{os.path.basename(destino)}` — \"{r.get('title')}\" por {r.get('creator') or 'desconocido'}, "
             f"licencia {r.get('license', '').upper()} {r.get('license_version') or ''} ({r.get('license_url') or ''}). "
             f"Fuente: {r.get('foreign_landing_url')}\n")
    with open(creditos, "a", encoding="utf-8") as f:
        f.write(linea)
    print(f"{destino}: {len(data)/1024:.0f} KB · {r.get('license')} · {r.get('creator')}")


if __name__ == "__main__":
    if sys.argv[1] == "buscar":
        n = int(sys.argv[sys.argv.index("--n") + 1]) if "--n" in sys.argv else 8
        buscar(sys.argv[2], n)
    else:
        cred = sys.argv[sys.argv.index("--creditos") + 1] if "--creditos" in sys.argv else "CREDITOS.md"
        bajar(sys.argv[2], sys.argv[3], cred)
