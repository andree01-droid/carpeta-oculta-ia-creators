// Contornos de los países del video tiktok-paises (Natural Earth vía world-atlas, dominio público).
// Salida: src/v3d/tiktok/paises.json  { US: [[lon,lat,...]], GB: [...], ... }
import {createRequire} from 'module';
import fs from 'fs';
const require = createRequire(import.meta.url);
const topo = require('topojson-client');
const paises = require('world-atlas/countries-50m.json');

const IDS = {US: '840', GB: '826', DE: '276', FR: '250', JP: '392', KR: '410', BR: '076', MX: '484', AR: '032', CO: '170', ES: '724'};

function anillos(geo, tol, filtro) {
  const out = [];
  const polys = geo.type === 'Polygon' ? [geo.coordinates] : geo.type === 'MultiPolygon' ? geo.coordinates : [];
  for (const poly of polys) {
    const r = [];
    let prev = null;
    for (const [x0, y] of poly[0]) {
      let x = x0;
      if (prev !== null) { while (x - prev > 180) x -= 360; while (x - prev < -180) x += 360; }
      r.push([x, y]); prev = x;
    }
    if (Math.abs(r[r.length - 1][0] - r[0][0]) > 180) continue;
    if (filtro && !filtro(r[0][0], r[0][1])) continue;
    const k = [];
    let lx = 1e9, ly = 1e9;
    for (const [x, y] of r) {
      if (Math.hypot(x - lx, y - ly) >= tol) { k.push(Math.round(x * 100) / 100, Math.round(y * 100) / 100); lx = x; ly = y; }
    }
    if (k.length >= 8) out.push(k);
  }
  return out;
}
const geomP = paises.objects.countries.geometries;
const out = {};
for (const [k, id] of Object.entries(IDS)) {
  const geo = topo.feature(paises, geomP.find((g) => g.id === id)).geometry;
  // Francia y España: solo el territorio europeo (sin ultramar ni Canarias)
  const filtro = k === 'FR' || k === 'ES' ? (x, y) => x > -12 && y > 35 : k === 'US' ? (x, y) => x < -60 && x > -180 && y > 18 : null;
  out[k] = anillos(geo, 0.12, filtro);
}
fs.mkdirSync('src/v3d/tiktok', {recursive: true});
fs.writeFileSync('src/v3d/tiktok/paises.json', JSON.stringify(out));
console.log(Object.entries(out).map(([k, v]) => `${k}:${v.length}/${v.reduce((a, r) => a + r.length / 2, 0)}`).join(' '));
