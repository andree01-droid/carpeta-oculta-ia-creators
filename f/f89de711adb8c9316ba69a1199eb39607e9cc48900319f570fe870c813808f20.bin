// Piezas de dibujo para "¿Habano o cigarro?" (canvas 2D, estilo ref6).
import {G, W, H, FF, rnd, cl, lerp, glow, pantalla, salida} from '../vape/dibujo';

export {G, W, H, FF, rnd, cl, lerp, glow, pantalla, salida};
export {vista, viñeta, velo, numero, pildora, fuente, texto, puntos, suave, nebulosa, fondoLiso, fondoCalido, humo, cigarro, brasaCara, chispas, pulmones} from '../vape/dibujo';
export {golpeTexto, chispa, onda, rayos, grieta, fragmentos, estallar, cabeza, pregunta, cruz, confeti, perfilCabeza, velocimetro, personita, despertador} from '../vodka/dibujo';

export const ORO = '242,208,123';
export const TABACO = '196,128,62';
export const CENIZA = '170,176,186';
export const ROJO = '239,59,69';
export const VERDE = '80,220,140';

const cil = (g: G, r: number, st: [number, string][]) => { const gr = g.createLinearGradient(0, -r, 0, r); for (const [k, c] of st) gr.addColorStop(k, c); return gr; };

/** habano con la brasa en (x, y); el cuerpo va hacia ang. largo y r en px */
export function habano(g: G, x: number, y: number, ang: number, largo: number, r: number, s: number, brasa = 1, anillo = 'HABANO') {
  g.save(); g.translate(x, y); g.rotate(ang);
  if (brasa > 0) glow(g, 0, 0, r * 5, '255,140,50', 0.5 * brasa * (0.9 + 0.1 * Math.sin(s * 8)));
  // sombra
  g.fillStyle = 'rgba(0,0,0,0.35)'; g.beginPath(); g.ellipse(largo * 0.5, r * 1.25, largo * 0.5, r * 0.25, 0, 0, 7); g.fill();
  // cuerpo de hoja
  g.fillStyle = cil(g, r, [[0, '#3b200c'], [0.2, '#8a5428'], [0.42, '#c4803e'], [0.6, '#9a5e2c'], [0.85, '#5a3212'], [1, '#2a1606']]);
  g.beginPath(); g.moveTo(r * 0.3, -r); g.lineTo(largo - r, -r); g.quadraticCurveTo(largo + r * 0.2, -r, largo + r * 0.2, 0); g.quadraticCurveTo(largo + r * 0.2, r, largo - r, r); g.lineTo(r * 0.3, r); g.closePath(); g.fill();
  // venas de la hoja (diagonales)
  g.save(); g.clip();
  g.strokeStyle = 'rgba(60,30,10,0.35)'; g.lineWidth = Math.max(1.5, r * 0.05);
  for (let i = 0; i < 18; i++) { const x0 = (i / 18) * largo * 1.1; g.beginPath(); g.moveTo(x0, -r); g.quadraticCurveTo(x0 + r * 0.6, 0, x0 + r * 1.3, r); g.stroke(); }
  g.strokeStyle = 'rgba(255,220,170,0.12)';
  for (let i = 0; i < 30; i++) { const x0 = rnd(i * 3.3) * largo, y0 = -r + rnd(i * 5.1) * r * 2; g.beginPath(); g.moveTo(x0, y0); g.lineTo(x0 + r * 0.8, y0 + r * 0.3); g.stroke(); }
  g.fillStyle = 'rgba(255,230,190,0.18)'; g.fillRect(0, -r * 0.55, largo * 1.2, r * 0.16);
  g.restore();
  // anillo
  const ax = largo * 0.72, aw = Math.max(r * 1.3, 40);
  g.fillStyle = cil(g, r, [[0, '#5a0d12'], [0.3, '#c0182a'], [0.5, '#e53344'], [0.75, '#a3121f'], [1, '#4a080d']]);
  g.fillRect(ax, -r * 1.02, aw, r * 2.04);
  g.fillStyle = cil(g, r, [[0, '#7a5a12'], [0.4, '#f6dc8a'], [0.6, '#d7b04a'], [1, '#6a4a0c']]);
  g.fillRect(ax, -r * 1.02, aw * 0.12, r * 2.04); g.fillRect(ax + aw * 0.88, -r * 1.02, aw * 0.12, r * 2.04);
  if (r > 18 && anillo) {
    g.save(); g.translate(ax + aw / 2, 0); g.rotate(-Math.PI / 2 * 0); g.font = `900 ${Math.round(r * 0.42)}px ${FF}`; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillStyle = '#f6dc8a'; g.save(); g.rotate(Math.PI / 2); g.fillText(anillo, 0, 0); g.restore(); g.restore();
  }
  // ceniza y brasa
  const cen = r * 1.1;
  g.fillStyle = cil(g, r, [[0, '#4a4a4c'], [0.35, '#b9b6b0'], [0.6, '#d8d4cc'], [1, '#3a3a3a']]);
  g.fillRect(-cen + r * 0.3, -r * 0.98, cen, r * 1.96);
  g.strokeStyle = 'rgba(60,60,60,0.5)'; g.lineWidth = 2; for (let k = 0; k < 4; k++) { const xx = -cen + r * 0.3 + (k + 0.5) * cen / 4; g.beginPath(); g.moveTo(xx, -r * 0.95); g.lineTo(xx + 4, r * 0.95); g.stroke(); }
  const fl = 0.85 + 0.15 * Math.sin(s * 11) * Math.sin(s * 6.3);
  const gr = g.createRadialGradient(-cen + r * 0.3, 0, 0, -cen + r * 0.3, 0, r * 1.1);
  gr.addColorStop(0, `rgba(255,245,200,${brasa})`); gr.addColorStop(0.35, `rgba(255,170,60,${brasa * fl})`); gr.addColorStop(0.8, `rgba(220,70,20,${brasa * fl})`); gr.addColorStop(1, 'rgba(90,20,6,0)');
  g.fillStyle = gr; g.beginPath(); g.ellipse(-cen + r * 0.3, 0, r * 0.4, r * 0.98, 0, 0, 7); g.fill();
  if (brasa > 0) glow(g, -cen + r * 0.3, 0, r * 2, '255,200,120', 0.7 * brasa * fl);
  g.restore();
}

/** cajetilla de cigarros; abierta 0..1 saca los cigarros; n = cuántos asoman */
export function cajetilla(g: G, x: number, y: number, sc: number, abierta = 0, a = 1, txt = '20', sub = 'CIGARROS') {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.scale(sc, sc);
  g.fillStyle = 'rgba(0,0,0,0.35)'; g.beginPath(); g.ellipse(0, 175, 140, 18, 0, 0, 7); g.fill();
  // cigarros que asoman
  if (abierta > 0) for (let i = 0; i < 7; i++) {
    const h = lerp(0, 90 + (i % 2) * 30, abierta);
    g.fillStyle = '#f4f0e6'; g.fillRect(-105 + i * 30, -160 - h, 26, h + 20);
    g.fillStyle = '#d99a4e'; g.fillRect(-105 + i * 30, -160 - h, 26, 36);
  }
  const m = g.createLinearGradient(-120, 0, 120, 0); m.addColorStop(0, '#e9e6df'); m.addColorStop(0.5, '#ffffff'); m.addColorStop(1, '#cfcac0');
  g.fillStyle = m; g.beginPath(); g.roundRect(-120, -170, 240, 340, 14); g.fill();
  g.fillStyle = '#c8102e'; g.beginPath(); g.moveTo(-120, -40); g.lineTo(0, 30); g.lineTo(120, -40); g.lineTo(120, -170); g.lineTo(-120, -170); g.closePath(); g.fill();
  g.fillStyle = 'rgba(255,255,255,0.25)'; g.fillRect(-110, -165, 16, 320);
  // tapa
  g.strokeStyle = 'rgba(0,0,0,0.25)'; g.lineWidth = 3; g.beginPath(); g.moveTo(-120, -110); g.lineTo(120, -110); g.stroke();
  g.font = `900 92px ${FF}`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#1a1a1a'; g.fillText(txt, 0, 92);
  g.font = `800 20px ${FF}`; g.fillStyle = '#6b6b6b'; g.fillText(sub, 0, 148);
  g.restore(); g.textAlign = 'left'; g.textBaseline = 'alphabetic';
}

/** hoja de tabaco */
export function hojaTabaco(g: G, x: number, y: number, sc: number, ang: number, tono = 0, a = 1) {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(ang); g.scale(sc, sc);
  const c1 = `rgb(${lerp(120, 150, tono) | 0},${lerp(150, 90, tono) | 0},${lerp(60, 35, tono) | 0})`, c2 = `rgb(${lerp(70, 80, tono) | 0},${lerp(95, 45, tono) | 0},${lerp(30, 15, tono) | 0})`;
  const gr = g.createLinearGradient(-60, -200, 60, 200); gr.addColorStop(0, c1); gr.addColorStop(1, c2);
  g.fillStyle = gr; g.beginPath(); g.moveTo(0, -210); g.bezierCurveTo(110, -150, 120, 80, 0, 210); g.bezierCurveTo(-120, 80, -110, -150, 0, -210); g.fill();
  g.strokeStyle = 'rgba(255,240,200,0.35)'; g.lineWidth = 5; g.beginPath(); g.moveTo(0, -200); g.lineTo(0, 205); g.stroke();
  g.lineWidth = 2.5; for (let k = -4; k <= 4; k++) { if (!k) continue; const yy = k * 38; g.beginPath(); g.moveTo(0, yy); g.quadraticCurveTo(Math.sign(k) * 50, yy - 30, Math.sign(k) * 80, yy - 60 + Math.abs(k) * 6); g.stroke(); g.beginPath(); g.moveTo(0, yy); g.quadraticCurveTo(-Math.sign(k) * 50, yy - 30, -Math.sign(k) * 80, yy - 60 + Math.abs(k) * 6); g.stroke(); }
  g.restore();
}

/** hoja de calendario con texto */
export function calendario(g: G, x: number, y: number, sc: number, mes: string, num: string, a = 1, rot = 0) {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot); g.scale(sc, sc);
  g.fillStyle = '#fbfbf6'; g.shadowColor = 'rgba(0,0,0,0.5)'; g.shadowBlur = 20; g.beginPath(); g.roundRect(-110, -120, 220, 240, 18); g.fill(); g.shadowBlur = 0;
  g.fillStyle = '#e5484d'; g.beginPath(); g.roundRect(-110, -120, 220, 66, [18, 18, 0, 0]); g.fill();
  g.font = `900 34px ${FF}`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#fff'; g.fillText(mes, 0, -86);
  g.font = `900 100px ${FF}`; g.fillStyle = '#1a1a1a'; g.fillText(num, 0, 30);
  g.fillStyle = '#9a9a9a'; for (const sx of [-60, 60]) { g.beginPath(); g.arc(sx, -120, 10, 0, 7); g.fill(); }
  g.restore(); g.textAlign = 'left'; g.textBaseline = 'alphabetic';
}

/** nitrosamina: N–N=O con dos grupos de carbono */
export function nitrosamina(g: G, x: number, y: number, r: number, rot: number, a = 1, brillo = 0) {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot);
  if (brillo > 0) glow(g, 0, 0, r * 6, '255,70,80', 0.5 * brillo);
  const at: [number, number, string, number, string][] = [[-r * 1.1, 0, '#3A77D5', r * 0.72, 'N'], [r * 0.6, -r * 0.6, '#3A77D5', r * 0.72, 'N'], [r * 2.1, 0, '#e5484d', r * 0.68, 'O'],
    [-r * 2.2, -r * 1.0, '#3a3a40', r * 0.6, 'C'], [-r * 2.2, r * 1.1, '#3a3a40', r * 0.6, 'C']];
  g.strokeStyle = 'rgba(230,230,240,0.85)'; g.lineWidth = r * 0.2; g.lineCap = 'round';
  for (const [i, j] of [[0, 1], [0, 3], [0, 4]]) { g.beginPath(); g.moveTo(at[i][0], at[i][1]); g.lineTo(at[j][0], at[j][1]); g.stroke(); }
  // doble enlace N=O
  for (const o of [-r * 0.14, r * 0.14]) { g.beginPath(); g.moveTo(at[1][0], at[1][1] + o); g.lineTo(at[2][0], at[2][1] + o); g.stroke(); }
  for (const [px, py, c, rr, t] of at) {
    const gr = g.createRadialGradient(px - rr * 0.35, py - rr * 0.35, rr * 0.1, px, py, rr);
    gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.3, c); gr.addColorStop(1, 'rgba(0,0,0,0.6)');
    g.fillStyle = gr; g.beginPath(); g.arc(px, py, rr, 0, 7); g.fill();
    if (r >= 16) { g.save(); g.rotate(-rot); g.restore(); g.font = `900 ${Math.round(rr * 0.9)}px ${FF}`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#fff'; g.fillText(t, px, py + 2); }
  }
  g.restore(); g.textAlign = 'left'; g.textBaseline = 'alphabetic';
}

/** escala de pH horizontal (0..14) con aguja en val */
export function escalaPH(g: G, x: number, y: number, w: number, val: number, a = 1) {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x - w / 2, y);
  const gr = g.createLinearGradient(0, 0, w, 0);
  ['#e5484d', '#f2994a', '#f2c94c', '#6fcf97', '#27ae60', '#2d9cdb', '#3A77D5', '#7b5cd6'].forEach((c, i, A) => gr.addColorStop(i / (A.length - 1), c));
  g.fillStyle = gr; g.beginPath(); g.roundRect(0, -26, w, 52, 26); g.fill();
  g.font = `800 26px ${FF}`; g.textAlign = 'center'; g.fillStyle = 'rgba(255,255,255,0.8)';
  for (const k of [0, 7, 14]) g.fillText(String(k), (k / 14) * w, 70);
  const px = (cl(val / 14)) * w;
  g.fillStyle = '#fff'; g.shadowColor = 'rgba(0,0,0,0.6)'; g.shadowBlur = 12; g.beginPath(); g.moveTo(px, -36); g.lineTo(px - 22, -76); g.lineTo(px + 22, -76); g.closePath(); g.fill();
  g.beginPath(); g.roundRect(px - 5, -36, 10, 72, 5); g.fill();
  g.restore(); g.textAlign = 'left';
}

/** cabeza de perfil con boca, garganta y esófago que se encienden (0..1 cada uno) */
export function garganta(g: G, x: number, y: number, sc: number, s: number, o: {boca?: number; garg?: number; eso?: number; humo?: number} = {}) {
  const {boca = 0, garg = 0, eso = 0, humo = 0} = o;
  g.save(); g.translate(x, y); g.scale(sc, sc);
  // cuello y pecho
  g.fillStyle = '#1b1d25'; g.beginPath(); g.moveTo(-70, 180); g.lineTo(-90, 640); g.lineTo(150, 640); g.lineTo(120, 190); g.closePath(); g.fill();
  g.beginPath(); g.moveTo(-60, 300); g.lineTo(-60, 200); g.bezierCurveTo(-200, 160, -230, 20, -200, -100); g.bezierCurveTo(-170, -260, 60, -300, 160, -180);
  g.bezierCurveTo(210, -120, 200, -60, 190, -20); g.lineTo(240, 60); g.lineTo(200, 80); g.lineTo(210, 120); g.lineTo(195, 140); g.bezierCurveTo(210, 190, 180, 210, 120, 205); g.lineTo(110, 300); g.closePath();
  const sk = g.createLinearGradient(-200, -200, 200, 200); sk.addColorStop(0, '#2a2d38'); sk.addColorStop(1, '#14161d'); g.fillStyle = sk; g.fill();
  g.strokeStyle = 'rgba(255,255,255,0.22)'; g.lineWidth = 4; g.stroke();
  // conductos (siempre tenues)
  const tubo = (pts: number[][], w: number, p: number) => {
    g.save(); g.lineCap = 'round'; g.lineJoin = 'round';
    g.strokeStyle = 'rgba(255,170,170,0.18)'; g.lineWidth = w; g.beginPath(); pts.forEach(([a, b], i) => (i ? g.lineTo(a, b) : g.moveTo(a, b))); g.stroke();
    if (p > 0) { g.strokeStyle = `rgba(255,80,90,${0.9 * p})`; g.shadowColor = 'rgba(255,60,70,0.9)'; g.shadowBlur = 30 * p; g.stroke(); }
    g.restore();
  };
  // boca (cavidad)
  g.save(); g.fillStyle = `rgba(255,140,150,${0.2 + 0.0 * boca})`; g.beginPath(); g.ellipse(120, 120, 70, 34, 0.1, 0, 7); g.fill();
  if (boca > 0) { glow(g, 120, 120, 160, '255,70,80', 0.6 * boca); g.fillStyle = `rgba(255,80,90,${0.85 * boca})`; g.beginPath(); g.ellipse(120, 120, 70, 34, 0.1, 0, 7); g.fill(); }
  g.restore();
  tubo([[60, 130], [30, 200], [20, 300]], 30, garg);
  tubo([[20, 300], [15, 450], [20, 620]], 24, eso);
  // humo dentro de la boca
  if (humo > 0) for (let i = 0; i < 10; i++) { const ph = (s * 0.8 + i / 10) % 1; glow(g, 110 + Math.sin(i * 2 + s * 3) * 40, 115 + Math.cos(i + s * 2) * 14, 40 + ph * 20, '220,220,230', 0.35 * humo); }
  g.restore();
}

/** corona de lujo */
export function corona(g: G, x: number, y: number, sc: number, a = 1) {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.scale(sc, sc);
  glow(g, 0, 0, 200, ORO, 0.6);
  const gr = g.createLinearGradient(0, -70, 0, 60); gr.addColorStop(0, '#fff1b8'); gr.addColorStop(0.5, '#f2c94c'); gr.addColorStop(1, '#a87413');
  g.fillStyle = gr; g.beginPath(); g.moveTo(-100, 50); g.lineTo(-110, -50); g.lineTo(-55, 0); g.lineTo(0, -75); g.lineTo(55, 0); g.lineTo(110, -50); g.lineTo(100, 50); g.closePath(); g.fill();
  g.fillStyle = '#e5484d'; g.beginPath(); g.arc(0, 18, 14, 0, 7); g.fill(); g.fillStyle = '#3A77D5'; g.beginPath(); g.arc(-55, 24, 10, 0, 7); g.arc(55, 24, 10, 0, 7); g.fill();
  g.restore();
}

/** calavera de advertencia */
export function calavera(g: G, x: number, y: number, sc: number, a = 1, col = '#ffffff') {
  if (a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.scale(sc, sc);
  g.fillStyle = col; g.beginPath(); g.arc(0, -20, 90, Math.PI * 0.85, Math.PI * 2.15); g.lineTo(50, 70); g.lineTo(-50, 70); g.closePath(); g.fill();
  g.fillStyle = '#120608'; g.beginPath(); g.ellipse(-36, -10, 26, 30, 0, 0, 7); g.ellipse(36, -10, 26, 30, 0, 0, 7); g.fill();
  g.beginPath(); g.moveTo(0, 18); g.lineTo(-12, 42); g.lineTo(12, 42); g.closePath(); g.fill();
  for (let k = -2; k <= 2; k++) g.fillRect(k * 18 - 4, 56, 8, 16);
  g.restore();
}
