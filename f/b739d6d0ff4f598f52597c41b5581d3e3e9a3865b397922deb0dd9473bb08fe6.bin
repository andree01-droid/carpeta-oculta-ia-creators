// Mockup de iPhone y la secuencia fija del CTA "Sígueme y envíaselo" (CLAUDE.md §10).
import React from 'react';
import {Easing, interpolate} from 'remotion';
import {COLORES} from '../motor/estilos';
import {FUENTE_UI} from '../motor/fuentes';
import {useVideo} from '../motor/contexto';
import {Avatar, Dedo} from './personajes';
import {num, str, type PropsElemento} from './tipos';

const CL = {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'} as const;

/** iPhone negro. Los hijos se colocan en coordenadas de la pantalla (ancho-28 × alto-28). */
export const Telefono: React.FC<PropsElemento> = ({p, ancho, alto, children}) => {
  const borde = 14;
  return (
    <div
      style={{
        position: 'absolute',
        inset: 0,
        width: ancho,
        height: alto,
        borderRadius: num(p.radio, 90),
        background: '#0A0A0A',
        border: '4px solid #2A2A2A',
        boxShadow: '0 30px 80px rgba(0,0,0,0.6)',
        boxSizing: 'border-box',
      }}
    >
      <div
        style={{
          position: 'absolute',
          inset: borde,
          borderRadius: num(p.radio, 90) - borde,
          overflow: 'hidden',
          background: str(p.pantalla, '#000'),
        }}
      >
        {children}
      </div>
      {/* isla dinámica */}
      <div style={{position: 'absolute', left: '50%', top: borde + 16, width: 150, height: 42, translate: '-50% 0', borderRadius: 21, background: '#000'}} />
    </div>
  );
};

const AMIGOS = [
  {nombre: 'Sofía', fondo: '#F2994A', pelo: '#2B1B12', peinado: 'largo', piel: '#C68A5E'},
  {nombre: 'Javi', fondo: '#3A77D5', pelo: '#1E140F', peinado: 'corto', piel: '#E6B48C'},
  {nombre: 'Marta', fondo: '#27AE60', pelo: '#8A3B1F', peinado: 'moño', piel: '#F1C7A1', gafas: true},
  {nombre: 'Dani', fondo: '#EB5757', pelo: '#3B2A20', peinado: 'corto', piel: '#B97A56'},
];

/**
 * Cierre: UI de reel en un teléfono, el dedo toca "Seguir", luego compartir, un amigo y "Enviar".
 * props: tSeguir, tCompartir, tAmigo, tEnviar (Tiempo), usuario, descripcion.
 * Hijos: lo que se ve en la pantalla del reel (normalmente una copia reducida de la última escena).
 */
export const CTACompartir: React.FC<PropsElemento> = ({p, frame, f0, children}) => {
  const {reloj} = useVideo();
  const t = (k: string, d: number) => (p[k] !== undefined ? reloj.cuadro(p[k] as string | number) : f0 + d);
  const tSeguir = t('tSeguir', 10);
  const tCompartir = t('tCompartir', 40);
  const tAmigo = t('tAmigo', 60);
  const tEnviar = t('tEnviar', 80);
  const W = 600;
  const H = 1240;
  const hoja = interpolate(frame, [tCompartir + 2, tCompartir + 14], [1, 0], {...CL, easing: Easing.out(Easing.cubic)});
  const siguiendo = frame >= tSeguir;
  const enviado = frame >= tEnviar;
  const amigoMarcado = frame >= tAmigo;

  // posición del dedo (en coordenadas del teléfono): recorre los botones
  const objetivos: [number, number, number][] = [
    [f0, 640, 1500],
    [tSeguir, 330, 1052],
    [tCompartir, 548, 905],
    [tAmigo, 232, 960],
    [tEnviar, 300, 1140],
    [tEnviar + 20, 700, 1600],
  ];
  const fr = objetivos.map((o) => o[0]);
  const xs = objetivos.map((o) => o[1]);
  const ys = objetivos.map((o) => o[2]);
  // el dedo viaja en los 10 cuadros previos a cada toque (rango siempre creciente)
  const entrada: number[] = [];
  fr.forEach((f, i) => {
    const previo = entrada.length ? entrada[entrada.length - 1] : -Infinity;
    if (i > 0) entrada.push(Math.max(previo + 1, f - 10));
    entrada.push(Math.max(entrada.length ? entrada[entrada.length - 1] + 1 : f, f));
  });
  const llegar = (arr: number[]) =>
    interpolate(
      frame,
      entrada,
      arr.flatMap((v, i) => (i === 0 ? [v] : [arr[i - 1], v])),
      {...CL, easing: Easing.bezier(0.65, 0, 0.35, 1)},
    );
  const dx = llegar(xs);
  const dy = llegar(ys);

  return (
    <div style={{position: 'absolute', inset: 0, width: W, height: H, fontFamily: FUENTE_UI}}>
      <Telefono p={{radio: 90}} ancho={W} alto={H} frame={frame} f0={f0} f1={0}>
        <div style={{position: 'absolute', inset: 0}}>{children}</div>
        {/* barra lateral de iconos */}
        <div style={{position: 'absolute', right: 26, top: 640, display: 'flex', flexDirection: 'column', gap: 46, alignItems: 'center', color: '#fff', fontSize: 20}}>
          {['♡', '◯', '⟲', '➤'].map((ic, i) => (
            <div key={i} style={{fontSize: 46, lineHeight: 1, opacity: 0.95, color: i === 3 && frame >= tCompartir ? COLORES.azulInstagram : '#fff'}}>
              {ic}
            </div>
          ))}
        </div>
        {/* usuario + seguir */}
        <div style={{position: 'absolute', left: 30, top: 1030, display: 'flex', alignItems: 'center', gap: 14, color: '#fff'}}>
          <div style={{width: 52, height: 52, borderRadius: 26, background: COLORES.azulSeleccion, display: 'grid', placeItems: 'center', fontWeight: 800, fontSize: 22}}>rq</div>
          <div style={{fontWeight: 700, fontSize: 24}}>{str(p.usuario, 'resultaaquee')}</div>
          <div
            style={{
              padding: '6px 16px',
              borderRadius: 10,
              fontSize: 20,
              fontWeight: 700,
              border: '1.5px solid rgba(255,255,255,0.6)',
              background: siguiendo ? 'rgba(255,255,255,0.15)' : 'transparent',
            }}
          >
            {siguiendo ? 'Siguiendo' : 'Seguir'}
          </div>
        </div>
        <div style={{position: 'absolute', left: 30, top: 1096, right: 120, color: '#fff', fontSize: 20, opacity: 0.9}}>
          {str(p.descripcion, '')}
        </div>
        {/* hoja de compartir */}
        <div
          style={{
            position: 'absolute',
            left: 0,
            right: 0,
            bottom: 0,
            height: 520,
            background: '#1C1C1E',
            borderTopLeftRadius: 28,
            borderTopRightRadius: 28,
            translate: `0 ${hoja * 560}px`,
            padding: '24px 30px',
            boxSizing: 'border-box',
            color: '#fff',
          }}
        >
          <div style={{width: 60, height: 6, borderRadius: 3, background: '#555', margin: '0 auto 24px'}} />
          <div style={{background: '#2C2C2E', borderRadius: 14, padding: '14px 18px', fontSize: 22, color: '#999'}}>🔍 Buscar</div>
          <div style={{display: 'flex', justifyContent: 'space-between', marginTop: 34}}>
            {AMIGOS.map((a, i) => (
              <div key={a.nombre} style={{display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10, width: 120}}>
                <div style={{position: 'relative', width: 104, height: 104, borderRadius: 52, outline: i === 0 && amigoMarcado ? `4px solid ${COLORES.azulInstagram}` : 'none', outlineOffset: 3}}>
                  <Avatar p={a} ancho={104} alto={104} frame={frame} f0={f0} f1={0} />
                  {i === 0 && amigoMarcado ? (
                    <div style={{position: 'absolute', right: -4, bottom: -4, width: 34, height: 34, borderRadius: 17, background: COLORES.azulInstagram, border: '3px solid #1C1C1E', display: 'grid', placeItems: 'center', fontSize: 20, fontWeight: 800}}>✓</div>
                  ) : null}
                </div>
                <div style={{fontSize: 20, fontWeight: i === 0 && amigoMarcado ? 700 : 400}}>{a.nombre}</div>
              </div>
            ))}
          </div>
          <div
            style={{
              marginTop: 44,
              borderRadius: 14,
              padding: '18px 0',
              textAlign: 'center',
              fontWeight: 700,
              fontSize: 24,
              background: enviado ? '#3A3A3C' : amigoMarcado ? COLORES.azulInstagram : '#2C2C2E',
              color: enviado ? '#ddd' : '#fff',
            }}
          >
            {enviado ? '✓ Enviado' : 'Enviar'}
          </div>
        </div>
      </Telefono>
      {/* dedo */}
      <div style={{position: 'absolute', left: dx, top: dy, width: 260, height: 820, translate: '-50% 0', rotate: '-18deg', transformOrigin: '50% 0'}}>
        <Dedo p={{toques: [tSeguir / reloj.fps, tCompartir / reloj.fps, tAmigo / reloj.fps, tEnviar / reloj.fps]}} ancho={260} alto={820} frame={frame} f0={f0} f1={0} />
      </div>
    </div>
  );
};
