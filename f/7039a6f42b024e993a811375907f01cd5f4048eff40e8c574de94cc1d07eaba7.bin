// Visualizaciones de datos animadas: gráfica de líneas, barra de porcentaje, mapa de EE. UU. en cuadritos.
import React from 'react';
import {Easing, interpolate} from 'remotion';
import {COLORES} from '../motor/estilos';
import {FUENTE} from '../motor/fuentes';
import {useVideo} from '../motor/contexto';
import {bool, num, str, type PropsElemento} from './tipos';

const CL = {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'} as const;

type Serie = {nombre: string; color?: string; puntos: [number, number][]; en?: string | number; dur?: number; grosor?: number; punteado?: boolean};

/**
 * Gráfica de líneas que se dibujan. Puntos en 0..1 (x a la derecha, y hacia arriba).
 * props: series[{nombre, color, puntos, en (Tiempo), dur (s)}], ejeX ["1991","2026"], rejilla
 */
export const GraficaLineas: React.FC<PropsElemento> = ({p, ancho, alto, frame, f0}) => {
  const {reloj} = useVideo();
  const series = (p.series as Serie[]) ?? [];
  const ejeX = (p.ejeX as string[]) ?? [];
  const m = {l: 30, r: 190, t: 30, b: 70};
  const W = ancho - m.l - m.r;
  const H = alto - m.t - m.b;
  const X = (x: number) => m.l + x * W;
  const Y = (y: number) => m.t + (1 - y) * H;
  const ejeOp = interpolate(frame, [f0, f0 + 8], [0, 1], CL);
  return (
    <svg width={ancho} height={alto} style={{position: 'absolute', inset: 0, overflow: 'visible'}}>
      <g opacity={ejeOp}>
        {bool(p.rejilla, true)
          ? [0.25, 0.5, 0.75, 1].map((y) => <line key={y} x1={X(0)} x2={X(1)} y1={Y(y)} y2={Y(y)} stroke="rgba(255,255,255,0.07)" strokeWidth={2} />)
          : null}
        <line x1={X(0)} x2={X(1)} y1={Y(0)} y2={Y(0)} stroke="rgba(255,255,255,0.35)" strokeWidth={3} />
        {ejeX.map((e, i) => (
          <text key={e} x={X(ejeX.length === 1 ? 0 : i / (ejeX.length - 1))} y={Y(0) + 54} textAnchor={i === 0 ? 'start' : i === ejeX.length - 1 ? 'end' : 'middle'} fill={COLORES.grisEtiqueta} fontFamily={FUENTE} fontWeight={600} fontSize={34}>
            {e}
          </text>
        ))}
      </g>
      {series.map((s, i) => {
        const fs = s.en !== undefined ? reloj.cuadro(s.en) : f0;
        const prog = interpolate(frame, [fs, fs + (s.dur ?? 1) * reloj.fps], [0, 1], {...CL, easing: Easing.bezier(0.65, 0, 0.35, 1)});
        if (prog <= 0) return null;
        const d = s.puntos.map(([x, y], k) => `${k === 0 ? 'M' : 'L'} ${X(x)} ${Y(y)}`).join(' ');
        const c = s.color ?? COLORES.ambar;
        // punta: interpolar a lo largo de los puntos según x
        const xs = s.puntos.map((q) => q[0]);
        const xMax = xs[0] + (xs[xs.length - 1] - xs[0]) * prog;
        let py = s.puntos[0][1];
        for (let k = 1; k < s.puntos.length; k++) {
          const [x0, y0] = s.puntos[k - 1];
          const [x1, y1] = s.puntos[k];
          if (xMax <= x1) {
            py = y0 + ((y1 - y0) * (xMax - x0)) / Math.max(1e-6, x1 - x0);
            break;
          }
          py = y1;
        }
        const g = s.grosor ?? 7;
        return (
          <g key={i}>
            <defs>
              <clipPath id={`clip-serie-${i}`}>
                <rect x={0} y={-200} width={X(xMax) + g} height={alto + 400} />
              </clipPath>
            </defs>
            <g clipPath={`url(#clip-serie-${i})`}>
              <path d={d} stroke={c} strokeWidth={g * 2.4} strokeOpacity={0.35} fill="none" style={{filter: 'blur(8px)'}} strokeLinecap="round" strokeLinejoin="round" />
              <path d={d} stroke={c} strokeWidth={g} fill="none" strokeLinecap="round" strokeLinejoin="round" strokeDasharray={s.punteado ? '14 12' : undefined} />
            </g>
            <circle cx={X(xMax)} cy={Y(py)} r={g * 1.4} fill={c} />
            <text x={X(xMax) + 22} y={Y(py) + 12} fill={c} fontFamily={FUENTE} fontWeight={700} fontSize={38} opacity={prog}>
              {s.nombre}
            </text>
          </g>
        );
      })}
    </svg>
  );
};

/** Barra horizontal de porcentaje. props: valor (0..100, animable), etiqueta, color, mostrar ("pct" | texto), fondo */
export const BarraPorcentaje: React.FC<PropsElemento> = ({p, ancho, alto}) => {
  const v = Math.max(0, Math.min(100, num(p.valor, 50)));
  const c = str(p.color, COLORES.ambar);
  const texto = p.texto !== undefined ? str(p.texto, '') : `${Math.round(v)}%`;
  return (
    <div style={{position: 'absolute', inset: 0, width: ancho, height: alto, fontFamily: FUENTE}}>
      <div style={{position: 'absolute', left: 0, bottom: alto + 14, color: '#fff', fontWeight: 700, fontSize: 36, letterSpacing: '0.12em', textTransform: 'uppercase', whiteSpace: 'nowrap'}}>
        {str(p.etiqueta, '')}
      </div>
      <div style={{position: 'absolute', inset: 0, borderRadius: alto / 2, background: str(p.fondo, 'rgba(255,255,255,0.08)'), border: '2px solid rgba(255,255,255,0.12)'}} />
      <div style={{position: 'absolute', left: 0, top: 0, bottom: 0, width: `${v}%`, borderRadius: alto / 2, background: c, boxShadow: `0 0 26px ${c}`}} />
      <div style={{position: 'absolute', left: `calc(${v}% + 20px)`, top: '50%', translate: v > 75 ? '-120% -50%' : '0 -50%', color: v > 75 ? '#1A1A1A' : '#fff', fontWeight: 800, fontSize: alto * 0.62, whiteSpace: 'nowrap', fontVariantNumeric: 'tabular-nums'}}>
        {texto}
      </div>
    </div>
  );
};

// Mapa de cuadritos (columna, fila) — 50 estados + DC
const ESTADOS: Record<string, [number, number]> = {
  AK: [0, 0], ME: [11, 0], VT: [10, 1], NH: [11, 1],
  WA: [1, 2], ID: [2, 2], MT: [3, 2], ND: [4, 2], MN: [5, 2], IL: [6, 2], WI: [7, 2], MI: [8, 2], NY: [9, 2], RI: [10, 2], MA: [11, 2],
  OR: [1, 3], NV: [2, 3], WY: [3, 3], SD: [4, 3], IA: [5, 3], IN: [6, 3], OH: [7, 3], PA: [8, 3], NJ: [9, 3], CT: [10, 3],
  CA: [1, 4], UT: [2, 4], CO: [3, 4], NE: [4, 4], MO: [5, 4], KY: [6, 4], WV: [7, 4], VA: [8, 4], MD: [9, 4], DE: [10, 4],
  AZ: [2, 5], NM: [3, 5], KS: [4, 5], AR: [5, 5], TN: [6, 5], NC: [7, 5], SC: [8, 5], DC: [9, 5],
  OK: [4, 6], LA: [5, 6], MS: [6, 6], AL: [7, 6], GA: [8, 6],
  HI: [0, 7], TX: [4, 7], FL: [9, 7],
};

/** Posición (centro) de un estado dentro del mapa, para colocar etiquetas o mover la cámara. */
export const centroEstado = (id: string, celda = 84) => {
  const c = ESTADOS[id];
  return c ? {x: c[0] * celda + celda / 2, y: c[1] * celda + celda / 2} : {x: 0, y: 0};
};

type Marca = {estado: string; en?: string | number; color?: string; valor?: string};

/**
 * Mapa de EE. UU. en cuadritos (12 × 8). Caja 1008 × 672 con celda 84.
 * props: marcas[{estado, en (Tiempo), color, valor}], celda, aparecer (cuadros escalonados)
 */
export const MapaEEUU: React.FC<PropsElemento> = ({p, frame, f0}) => {
  const {reloj} = useVideo();
  const celda = num(p.celda, 84);
  const marcas = (p.marcas as Marca[]) ?? [];
  return (
    <div style={{position: 'absolute', inset: 0, fontFamily: FUENTE}}>
      {Object.entries(ESTADOS).map(([id, [c, r]], i) => {
        const marca = marcas.find((m) => m.estado === id);
        const fm = marca ? (marca.en !== undefined ? reloj.cuadro(marca.en) : f0) : 0;
        const on = marca ? interpolate(frame, [fm, fm + 6], [0, 1], CL) : 0;
        const ap = interpolate(frame, [f0 + (c + r) * 1.2, f0 + (c + r) * 1.2 + 8], [0, 1], {...CL, easing: Easing.out(Easing.cubic)});
        const color = marca?.color ?? COLORES.coral;
        return (
          <div
            key={id}
            style={{
              position: 'absolute',
              left: c * celda + 4,
              top: r * celda + 4,
              width: celda - 8,
              height: celda - 8,
              borderRadius: 12,
              background: on > 0 ? color : '#262626',
              opacity: ap,
              scale: String(0.6 + 0.4 * ap + 0.12 * on * (1 - on) * 4),
              boxShadow: on > 0 ? `0 0 ${30 * on}px ${color}` : 'inset 0 0 0 2px rgba(255,255,255,0.06)',
              display: 'grid',
              placeItems: 'center',
              color: on > 0.5 ? '#1A1A1A' : '#7A7A7A',
              fontWeight: on > 0.5 ? 800 : 600,
              fontSize: celda * 0.3,
            }}
          >
            {id}
          </div>
        );
      })}
      {marcas.map((m) => {
        const pos = ESTADOS[m.estado];
        if (!pos || !m.valor) return null;
        const fm = m.en !== undefined ? reloj.cuadro(m.en) : f0;
        const s = interpolate(frame, [fm + 3, fm + 10], [0, 1], {...CL, easing: Easing.out(Easing.back(1.6))});
        if (s <= 0) return null;
        return (
          <div
            key={`v-${m.estado}`}
            style={{
              position: 'absolute',
              left: pos[0] * celda + celda / 2,
              top: pos[1] * celda - 14,
              translate: '-50% -100%',
              scale: String(s),
              transformOrigin: '50% 100%',
              padding: '8px 18px',
              borderRadius: 14,
              background: 'rgba(20,20,20,0.92)',
              border: `2px solid ${m.color ?? COLORES.coral}`,
              color: m.color ?? COLORES.coral,
              fontWeight: 800,
              fontSize: 44,
              whiteSpace: 'nowrap',
            }}
          >
            {m.valor}
          </div>
        );
      })}
    </div>
  );
};
