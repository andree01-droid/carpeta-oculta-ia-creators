    const [ex, ey] = aP(g, 400, 1250);
    etiqueta(g, s, T.tear, 'IT CAN TEAR YOUR INSIDES', 120, 860, ex, ey, {col: '255,170,170', tam: 30});
    pildora(g, 540, 1640, 'DON\'T TRY THIS', rebote(s, T.metal204), {col: '#ff8a8a', tam: 40});
    cierre(g, 0.55);
  }},
  // 30 — así que sí: del avión solo queda el contorno… y un plato de migas
  {t0: T.so210 - 0.1, dib: (g, s) => {
    cielo(g, s, 'atardecer', {relampagos: false, nubes: 0.5, hor: 1300});
    vista(g, s, [[T.so210 - 0.1, 0, 540, 1150, 1.2], [T.so210, 0.6, 540, 1250, 1.0], ...golpeCam(T.airplane217, 540, 1250, 1.1, 1.04)], 1.2);
    aerodromo(g, s, 1300);
    g.save(); g.globalAlpha = 0.22 + 0.08 * Math.sin(s * 3); cessna(g, s, 560, 1250, 0.9, {helice: 0}); g.restore();
    g.save(); g.setLineDash([20, 14]); g.strokeStyle = 'rgba(255,240,200,0.7)'; g.lineWidth = 4; g.beginPath(); g.ellipse(560, 1240, 560, 280, 0, 0, 7); g.stroke(); g.restore();
    heroe(g, 'atardecer', (c) => { plato(c, 540, 1600, 1.0 * rebote(s, T.really)); for (let i = 0; i < 12; i++) pieza(c, 420 + rnd(i * 3.1) * 240, 1580 - rnd(i * 1.7) * 40, 14, i, i * 4.4); }, -2.3, 6);
    pildora(g, 540, 820, 'A WHOLE PLANE. EATEN.', rebote(s, T.airplane217), {col: '#ffe08a', tam: 40});
    pildora(g, 540, 940, '2 YEARS', rebote(s, T.n2c), {col: '#ffffff', tam: 36});
    cierre(g, 0.45);
  }},
  // 31 — un trocito cada vez: el tenedor lleva el último trozo a la boca
  {t0: T.one - 0.1, dib: (g, s) => {
    vista(g, s, [[T.one - 0.1, 0, 540, 1200, 1.3], [T.one, 0.6, 540, 1250, 1.08], ...golpeCam(T.time, 540, 1300, 1.2, 1.1)], 1.1);
    escenario(g, s, {focoA: 1, publico: 0, tinte: '255,230,180'});
    const lleva = salida(cl((s - T.piece222) / (T.time - T.piece222)));
    mich(g, s, 'oro', 540, 1280, 330, {boca: s < T.time ? 0.5 + 0.5 * lleva : 0, mastica: s > T.time ? 1 : 0, expr: 'feliz', servilleta: 1, mira: 0.4});
    heroe(g, 'oro', (c) => tenedor(c, lerp(900, 600, lleva), lerp(1300, 1500, lleva), 0.75, lerp(-0.4, -1.2, lleva), () => { if (s < T.time) { glow(c, 0, -200, 120, '255,240,200', 0.8); pieza(c, 0, -200, 34, 0.3, 9.9, {brillo: 1}); } }), -2.2, 6);
    if (s > T.time) confeti(g, s, T.time, 540, 1100, 60);
