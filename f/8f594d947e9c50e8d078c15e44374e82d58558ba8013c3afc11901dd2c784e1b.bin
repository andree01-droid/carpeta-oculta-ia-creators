    enPantalla(g, () => { g.save(); g.globalCompositeOperation = 'lighter';
      for (let i = 0; i < 3; i++) { const a = -Math.PI / 2 + Math.sin(s * 0.9 + i * 2) * 0.35, x0 = 200 + i * 340; const gr = g.createLinearGradient(x0, H, x0 + Math.cos(a) * 1900, H + Math.sin(a) * 1900); gr.addColorStop(0, 'rgba(255,230,160,0.35)'); gr.addColorStop(1, 'rgba(255,230,160,0)');
        g.fillStyle = gr; g.beginPath(); g.moveTo(x0, H); g.lineTo(x0 + Math.cos(a - 0.12) * 2100, H + Math.sin(a - 0.12) * 2100); g.lineTo(x0 + Math.cos(a + 0.12) * 2100, H + Math.sin(a + 0.12) * 2100); g.closePath(); g.fill(); }
      g.restore(); });
    bk(g, s, '255,220,140', 28, 0.3);
