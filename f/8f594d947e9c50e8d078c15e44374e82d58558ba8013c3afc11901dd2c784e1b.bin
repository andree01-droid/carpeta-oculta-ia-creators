    pildora(g, 540, 1680, 'THE WEIRD PART', rebote(s, T.weird), {col: '#c8ffc0', tam: 36});
    cierre(g, 0.45);
  }},
  // 25 — …le sentaban mal: se pone verde (golpe)
  {t0: T.made - 0.1, dib: (g, s) => {
    cielo(g, s, 'lago', {relampagos: false, nubes: 0.6, hor: 1400});
    vista(g, s, [[T.made - 0.1, 0, 540, 1250, 1.25], [T.made, 0.4, 540, 1250, 1.04], ...golpeCam(T.sick, 540, 1230, 1.16, 1.06)], 1.6);
    const v = ap(s, T.sick - 0.1, 0.3);
    mich(g, s, 'lago', 540, 1260, 300, {expr: s > T.sick - 0.1 ? 'asco' : 'duda', verde: v, sudor: v, servilleta: 1}, -2.0);
    heroe(g, 'lago', (c) => platano(c, 820, 1630, 0.6, 0.4), -2.0, 5);
    for (let i = 0; i < 4; i++) { const ph = (s * 0.8 + i / 4) % 1; g.strokeStyle = `rgba(150,230,120,${0.7 * v * (1 - ph)})`; g.lineWidth = 8; g.beginPath(); for (let k = 0; k <= 10; k++) g.lineTo(380 + k * 32, 900 - ph * 220 + Math.sin(k + s * 6 + i) * 14); g.stroke(); }
    pildora(g, 540, 720, 'MADE HIM SICK', rebote(s, T.sick), {col: '#c8ffc0', tam: 50});
    onda(g, s, T.sick, 540, 1260, '160,255,140');
