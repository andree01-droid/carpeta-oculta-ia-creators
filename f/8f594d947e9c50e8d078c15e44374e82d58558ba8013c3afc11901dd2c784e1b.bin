    heroe(g, 'oro', (c) => placa(c, s, 540, 1220, 1.0 * rebote(s, T.brass - 0.1), 0, Math.sin(s * 1.8) * 0.03), -2.2, 8);
    pildora(g, 540, 1640, 'GUINNESS WORLD RECORDS', rebote(s, T.guinness), {col: '#ffe08a', tam: 34});
    if (s > T.diet) confeti(g, s, T.diet, 540, 800, 70);
    const [px, py] = aP(g, 790, 1000);
    etiqueta(g, s, T.plaque, 'BRASS PLAQUE', 900, 760, px, py, {col: '255,225,150'});
    cierre(g, 0.45);
  }},
  // 27 — también se la comió (golpe)
  {t0: T.he193 - 0.1, dib: (g, s) => {
