  {t0: T.follow - 0.1, dib: (g, s) => {
    vista(g, s, [[T.follow, 0, 540, 1200, 1.15], [T.follow + 0.05, 3, 540, 1220, 1.0]], 1.6);
    escenario(g, s, {telon: 1 - ap(s, DUR - 1.3, 1.0), focoA: 1, publico: 1});
    const seg = s >= T.follow + 0.35;
    mich(g, s, 'oro', 540, 1280, 230 * rebote(s, T.follow - 0.05), {expr: 'feliz', brazo: 'saludo', servilleta: 1, mastica: s > T.eats ? 1 : 0});
    pildora(g, 540, 640, seg ? 'FOLLOWING ✓' : 'FOLLOW', rebote(s, T.follow - 0.05), {col: '#ffffff', tam: 40, fondo: seg ? 'rgba(60,60,66,0.95)' : 'rgba(0,149,246,0.98)'});
    const toque = s - T.follow - 0.3;
    if (toque > 0 && toque < 0.4) enPantalla(g, () => { g.strokeStyle = `rgba(255,255,255,${0.6 * (1 - toque / 0.4)})`; g.lineWidth = 4; g.beginPath(); g.arc(540, 640, 40 + toque * 300, 0, 7); g.stroke(); });
    pildora(g, 540, 745, '➤ SEND', rebote(s, T.send), {col: '#ffffff', tam: 36});
    pildora(g, 540, 860, '"EATS LITERALLY ANYTHING"', rebote(s, T.friend), {col: '#ffd27a', tam: 30});
    if (s > T.eats) vuelo(g, s, T.eats, 1100, 900, 540, 1440, 8, 0.12, 28);
    const fin = cl((s - (DUR - 0.6)) / 0.6);
    if (fin > 0) enPantalla(g, () => { g.fillStyle = `rgba(0,0,0,${fin})`; g.fillRect(0, 0, W, H); });
    cierre(g, 0.5);
  }},
];
const TRANS = ['', 'zoom', 'barrido', 'desenfoque', 'barridoV', 'zoom', 'desenfoque', 'zoom', 'barrido', 'desenfoque', 'barridoV', 'barrido', 'barrido', 'desenfoque', 'zoom',
  'barridoV', 'desenfoque', 'barrido', 'zoom', 'desenfoque', 'giro', 'zoom', 'barrido', 'desenfoque', 'corte', 'zoom', 'desenfoque', 'zoom', 'barridoV', 'desenfoque', 'barrido', 'desenfoque'];

const dibujar = (g: G, s: number) => {
  let k = 0;
  for (let i = 0; i < PLANOS.length; i++) if (s >= PLANOS[i].t0 - 0.06) k = i;
  g.save(); PLANOS[k].dib(g, s); g.restore();
  g.setTransform(1, 0, 0, 1, 0, 0);
  for (let i = 1; i < PLANOS.length; i++) {
    const d = s - PLANOS[i].t0; if (Math.abs(d) > 0.16) continue;
    const q = 1 - Math.abs(d) / 0.16, tr = TRANS[i];
    if (tr === 'barrido' || tr === 'barridoV') {
      g.save();
      for (let j = 1; j <= 4; j++) { g.globalAlpha = 0.25 * q; const o = j * 60 * q; if (tr === 'barrido') g.drawImage(g.canvas, o, 0, W, H); else g.drawImage(g.canvas, 0, o, W, H); }
      g.restore();
    }
    if (tr === 'zoom' && d > -0.03 && d < 0.12) { g.fillStyle = `rgba(255,255,255,${0.45 * (1 - Math.abs(d) / 0.12)})`; g.fillRect(0, 0, W, H); }
  }
};

