    mesa(g, s);
    const cae = (t: number) => (s < t ? -1 : 1 - salida(cl((s - t) / 0.25)));
    heroe(g, 'lago', (c) => { plato(c, 540, 1440, 1.3); const kb = cae(T.bananas), ke = cae(T.eggs); if (kb >= 0) platano(c, 430, 1380 - kb * 900, 0.95, -0.15); if (ke >= 0) { huevo(c, 660, 1420 - ke * 900, 0.8, 0.2); huevo(c, 780, 1390 - ke * 1000, 0.7, -0.3); } }, -2.2, 7);
    const [bx, by] = aP(g, 430, 1360), [ex, ey] = aP(g, 700, 1400);
