    vista(g, s, [[T.like161 - 0.1, 0, 540, 1250, 1.25], [T.like161, 0.5, 540, 1250, 0.95], ...golpeCam(T.armor, 540, 1250, 1.08, 1.0)], 1.2);
    heroe(g, 'lago', (c) => tubo(c, s, 540, 1250, 0.95 * rebote(s, T.like161), ap(s, T.armor - 0.05, 0.6)), -2.2, 7, XR);
