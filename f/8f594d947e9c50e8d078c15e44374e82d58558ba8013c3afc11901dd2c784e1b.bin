const CLAVES = ['entire', 'toy', 'real#1', 'piece#1', 'lotito', 'grenoble', 'mangetout', 'everything', 'possible', 'pica', 'metal#1', 'glass', 'rubber', 'show',
  '18', '15', 'chandeliers', 'coffin', 'handles', '1978', 'cessna', 'engine', 'tiny#1', 'pounds', 'pills', 'water', 'years#1', 'kill', 'x', 'thick', 'armor',
  'bananas', 'sick', 'plaque', 'strangest', 'too', 'never', 'tear', 'airplane#3', 'time', 'friend'];
const SPEC: VideoSpec = {titulo: id, estilo: 'estudio-oscuro', palabras: P, escenas: [], claves: CLAVES, emojis: {}};

const Comp: React.FC = () => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();
  const s = frame / fps;
  const ref = useRef<HTMLCanvasElement>(null);
  useLayoutEffect(() => { const g = contextoHD(ref.current!); g.setTransform(1, 0, 0, 1, 0, 0); dibujar(g, s); }, [s]);
  let blur = 0, esc = 1, rot = Math.sin(s * 0.8) * 0.25, gx = 0, gy = 0;
  for (const [i, p] of PLANOS.entries()) {
    if (i === 0) continue;
    const d = s - p.t0, D = 0.16;
    if (Math.abs(d) >= D) continue;
    const q = 1 - Math.abs(d) / D, sg = d < 0 ? -1 : 1, q2 = q * q, tr = TRANS[i];
    if (tr === 'corte') continue;
    if (tr === 'barrido') { gx += sg * q2 * 50; esc *= 1 + 0.1 * q; blur = Math.max(blur, q * 7); }
    else if (tr === 'barridoV') { gy += sg * q2 * 80; esc *= 1 + 0.1 * q; blur = Math.max(blur, q * 7); }
    else if (tr === 'zoom') { esc *= 1 + (d < 0 ? 0.4 : 0.22) * q2; blur = Math.max(blur, q * 14); }
    else if (tr === 'giro') { rot += -sg * q2 * 6; esc *= 1 + 0.22 * q; blur = Math.max(blur, q * 10); }
    else { blur = Math.max(blur, q * 22); esc *= 1 + 0.12 * q * (d < 0 ? 1 : 0.6); }
  }
  esc *= 1.015 + 0.012 * Math.sin(s * 1.3);
  for (const t of GOLPES) { const d = s - t; if (d >= 0 && d < 0.3) { const q = Math.exp(-d * 12); esc *= 1 + 0.035 * q; gx += Math.sin(d * 70) * 4 * q; rot += Math.sin(d * 40) * 0.6 * q; } }
  for (const [t, amp] of FUERTES) { const d = s - t; if (d >= 0 && d < 0.5) { const q = Math.exp(-d * 9); esc *= 1 + 0.06 * q; gx += Math.sin(d * 83) * amp * q; gy += Math.cos(d * 67) * amp * 0.7 * q; } }
  const relojP = useMemo(() => crearReloj(P, fps), [fps]);
  const palabras = useMemo(() => prepararPalabras(SPEC), []);
  return (
    <VideoCtx.Provider value={{spec: SPEC, reloj: relojP, estilo: 'estudio-oscuro', palabras}}>
      <AbsoluteFill style={{background: '#08090c'}}>
        <canvas ref={ref} width={W * HD} height={H * HD} style={{width: W, height: H, filter: blur > 0.2 ? `blur(${blur}px)` : undefined, scale: String(esc), translate: `${gx}px ${gy}px`, rotate: `${rot}deg`}} />
        <Subtitulos palabras={palabras} />
        <Audio src={staticFile(`voz/${id}.mp3`)} volume={0.85} />
        <Audio src={staticFile(`voz/${id}-musica.mp3`)} volume={(f) => 0.13 * interpolate(f, [DUR * fps - 40, DUR * fps], [1, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'})} />
        {SONIDOS.filter(([, f, v]) => v > 0 && f !== '').map(([t, f, v], i) => (
          <Sequence key={i} from={Math.max(0, Math.round(t * fps))} durationInFrames={Math.round(2.5 * fps)} layout="none">
            <Audio src={staticFile(f.startsWith('sfx:') ? `sfx/${f.slice(4)}.wav` : `sfx-hf/${f}`)} volume={v * 0.7} />
          </Sequence>
        ))}
        {TICS.map((t, i) => (
          <Sequence key={`tic-${i}`} from={Math.round(t * fps)} durationInFrames={10} layout="none">
            <Audio src={staticFile('sfx/tic.wav')} volume={0.1} />
          </Sequence>
        ))}
      </AbsoluteFill>
    </VideoCtx.Provider>
  );
};
return {Comp, DUR};
}
const EN = crear(PEN as Pal[]);
export const Comido = EN.Comp;
export const DURACION_COMIDO = EN.DUR;
