// "The man who ate an airplane" (Michel Lotito, "Monsieur Mangetout") — inglés EE. UU. (voz Achird), canvas HD.
// Modelo de las referencias (ref6 / electrocutarte) y nivel de sullivan v2: 4 mundos que vuelven (cielo y aeródromo con la
// avioneta enorme, escenario de cabaret con el comensal en primer plano, mesa con mantel y plato, sala de rayos X),
// protagonistas grandes con luz de borde, el mundo siempre en movimiento, etiquetas finas y pocos títulos gigantes.
// Datos (Wikipedia "Michel Lotito"; Guinness World Records, "The man who ate metal", 2022; Snopes 2022): Grenoble, pica;
// 18 bicicletas, 15 carritos, 7 televisores, 6 lámparas de araña, un ataúd (con asas); Cessna 150 de 1978 a 1980 (~2 años);
// ~900 g (2 lb) de metal al día con aceite mineral y agua; pared del estómago e intestinos inusualmente gruesa;
// plátanos y huevos duros le sentaban mal; Guinness le dio una placa de latón por la "dieta más extraña" y se la comió.
import React, {useLayoutEffect, useMemo, useRef} from 'react';
import {AbsoluteFill, Sequence, interpolate, staticFile, useCurrentFrame, useVideoConfig} from 'remotion';
import {Audio} from '@remotion/media';
import PEN from '../avion-comido-en.palabras.json';
import {Subtitulos} from '../../componentes/Subtitulos';
import {VideoCtx} from '../../motor/contexto';
import {crearReloj, normalizar} from '../../motor/reloj';
import {prepararPalabras} from '../../Video';
import {rampa} from '../tiempo';
import {HD, contextoHD} from '../hd';
import type {VideoSpec} from '../../motor/tipos';
import {G, W, H, FF, rnd, cl, lerp, glow, pantalla, salida, vista, viñeta, velo, numero, pildora, fuente, golpeTexto, onda, rayos, grieta, pregunta, cruz} from '../cripto/dibujo';
import {confeti} from '../vodka/dibujo';
import {sello} from '../dedos/dibujo';
import {carrito, tele, llanta} from '../costco/dibujo';
import {documento} from '../helado/dibujo';
import {Tono, TONOS, cielo, cordillera, niebla, bokeh, brasas, etiqueta, iluminar, sombraSuelo} from '../sullivan/mundo';
import {cessna, pieza, comensal, OpCom, plato, tenedor, cuchillo, mantel, escenario, marquesina, aerodromo, bici, lampara, ataud, platano, huevo,
  botella, vaso, sierra, chispas, bascula, rayosX, salaX, tubo, placa, aviso, barraAnios, XR} from './dibujo';

type Pal = {word: string; start: number; end: number};
const ANCLAS: [string, number, string][] = [
  ['ate2', 2, 'ate'], ['airplane5', 5, 'airplane'], ['not', 6, 'not'], ['toy', 8, 'toy'], ['real10', 10, 'real'], ['piece12', 12, 'piece'], ['piece14', 14, 'piece'],
  ['his', 15, 'his'], ['michel18', 18, 'michel'], ['lotito', 19, 'lotito'], ['entertainer', 21, 'entertainer'], ['grenoble', 23, 'grenoble'], ['france', 24, 'france'],
  ['people', 25, 'people'], ['monsieur', 28, 'monsieur'], ['mangetout', 29, 'mangetout'], ['mr', 30, 'mr'], ['everything', 32, 'everything'],
  ['but', 33, 'but'], ['wait', 34, 'wait'], ['how', 35, 'how'], ['possible', 39, 'possible'], ['it40', 40, 'it'], ['condition', 45, 'condition'], ['pica', 47, 'pica'],
  ['urge', 49, 'urge'], ['food', 56, 'food'], ['metal57', 57, 'metal'], ['glass', 58, 'glass'], ['rubber', 59, 'rubber'], ['michel60', 60, 'michel'], ['stage', 65, 'stage'],
  ['show', 66, 'show'], ['over', 67, 'over'], ['n18', 72, '18'], ['bicycles', 73, 'bicycles'], ['n15', 74, '15'], ['shopping', 75, 'shopping'], ['n7', 77, '7'], ['tvs', 78, 'tvs'],
  ['n6', 79, '6'], ['chandeliers', 80, 'chandeliers'], ['even', 82, 'even'], ['coffin', 84, 'coffin'], ['handles', 85, 'handles'], ['included', 86, 'included'],
  ['then', 87, 'then'], ['n1978', 89, '1978'], ['cessna', 94, 'cessna'], ['n150', 95, '150'], ['a96', 96, 'a'], ['real97', 97, 'real'], ['wings', 100, 'wings'],
  ['wheels', 101, 'wheels'], ['engine', 104, 'engine'], ['picture', 105, 'picture'], ['tiny111', 111, 'tiny'], ['pieces', 112, 'pieces'], ['swallow', 116, 'swallow'],
  ['every', 117, 'every'], ['day', 118, 'day'], ['n2a', 120, '2'], ['pounds', 121, 'pounds'], ['metal123', 123, 'metal'], ['he124', 124, 'he'], ['gulped', 125, 'gulped'],
  ['pills', 129, 'pills'], ['mineral', 131, 'mineral'], ['water', 136, 'water'], ['it137', 137, 'it'], ['took', 138, 'took'], ['n2b', 141, '2'], ['years142', 142, 'years'],
  ['so143', 143, 'so'], ['why', 144, 'why'], ['kill', 147, 'kill'], ['doctors149', 149, 'doctors'], ['xray', 150, 'x'], ['stomach', 153, 'stomach'], ['lining', 157, 'lining'],
  ['unusually', 159, 'unusually'], ['thick', 160, 'thick'], ['like161', 161, 'like'], ['pipe', 163, 'pipe'], ['armor', 165, 'armor'], ['inside', 167, 'inside'],
  ['and168', 168, 'and'], ['weird', 171, 'weird'], ['bananas', 173, 'bananas'], ['eggs', 177, 'eggs'], ['made', 178, 'made'], ['sick', 180, 'sick'], ['guinness', 181, 'guinness'],
  ['brass', 187, 'brass'], ['plaque', 188, 'plaque'], ['strangest', 191, 'strangest'], ['diet', 192, 'diet'], ['he193', 193, 'he'], ['ate194', 194, 'ate'], ['too', 196, 'too'],
  ['doctors197', 197, 'doctors'], ['never', 200, 'never'], ['try', 201, 'try'], ['swallowing', 203, 'swallowing'], ['metal204', 204, 'metal'], ['tear', 206, 'tear'], ['apart', 209, 'apart'],
  ['so210', 210, 'so'], ['really', 214, 'really'], ['airplane217', 217, 'airplane'], ['n2c', 218, '2'], ['one', 220, 'one'], ['tiny221', 221, 'tiny'], ['piece222', 222, 'piece'],
  ['time', 225, 'time'], ['follow', 226, 'follow'], ['send', 229, 'send'], ['friend', 233, 'friend'], ['eats', 235, 'eats'], ['anything', 237, 'anything'],
];

function crear(P: Pal[]) {
const w = (i: number, txt: string) => {
  if (!normalizar(P[i].word).startsWith(normalizar(txt))) throw new Error(`palabra ${i} es "${P[i].word}", esperaba "${txt}"`);
  return P[i].start;
};
const T: Record<string, number> = {};
for (const [k, i, t] of ANCLAS) T[k] = w(i, t);
const DUR = P[P.length - 1].end + 1.6;

// ------------------------------------------------------------------ ayudantes
type K = [number, number, number, number, number];
const ap = (s: number, t: number, d = 0.35) => rampa(s, t, t + d, 'salida');
const rebote = (s: number, t: number) => { const d = s - t; if (d <= 0) return 0; return 1 + Math.sin(d * 18) * 0.22 * Math.exp(-d * 8) - Math.exp(-d * 30); };
const cuenta = (s: number, t: number, a: number, b: number, d = 0.7) => lerp(a, b, salida(cl((s - t) / d)));
const enPantalla = (g: G, f: () => void) => { g.save(); pantalla(g); f(); g.restore(); };
const flash = (g: G, s: number, t: number, col = '255,255,255', a0 = 0.8, d0 = 0.2) => { const d = s - t; if (d < 0 || d > d0) return; enPantalla(g, () => { g.fillStyle = `rgba(${col},${a0 * (1 - d / d0)})`; g.fillRect(0, 0, W, H); }); };
const aP = (g: G, x: number, y: number): [number, number] => { const R = g.canvas.width / W, p = g.getTransform().transformPoint(new DOMPoint(x, y)); return [p.x / R, p.y / R]; };
/** figura con luz de borde, sombra propia y tinte del ambiente */
const heroe = (g: G, tono: Tono, dib: (x: G) => void, ang = -Math.PI / 2, ancho = 7, borde?: string) =>
  iluminar(g, dib, {borde: borde ?? TONOS[tono].luz, bordeA: 0.75, ang, ancho, sombra: 0.55, tinte: TONOS[tono].nubeOsc, tinteA: 0.18});
const cierre = (g: G, vi = 0.5, fl = 0) => { if (fl > 0) enPantalla(g, () => { g.fillStyle = `rgba(255,240,220,${0.2 * fl})`; g.fillRect(0, 0, W, H); }); viñeta(g, vi); velo(g); };
const slam = (g: G, s: number, t: number, txt: string, x: number, y: number, ang: number, tam: number, col = '#ffffff', sombra = 'rgba(0,0,0,0.55)', hasta = 1e9) => {
  if (s < t || s >= hasta) return;
  g.save(); pantalla(g);
  g.font = `900 ${tam}px ${FF}`; const k = Math.min(1, 900 / (g.measureText(txt).width * 1.04 + 20));
  const d = s - t;
  golpeTexto(g, s, txt, x, y + Math.sin(d * 2.6) * 6, ang + Math.sin(d * 1.9) * 0.012, tam * k, t, col, sombra);
  g.restore();
};
type Sl = [number, string, number, string?];
const slams = (g: G, s: number, lista: Sl[], sombra: string, hastaFin = 1e9, y = 720) => {
  for (let i = 0; i < lista.length; i++) { const [t, tx, tam, col] = lista[i]; slam(g, s, t - 0.05, tx, 540, y, i % 2 ? 0.04 : -0.05, tam, col ?? '#ffffff', sombra, i + 1 < lista.length ? lista[i + 1][0] - 0.05 : hastaFin); }
};
const golpeCam = (t: number, x: number, y: number, z: number, zb: number): K[] => [[t - 0.04, 0.08, x, y, z], [t + 0.08, 0.5, x, y, zb]];
const mich = (g: G, s: number, tono: Tono, x: number, y: number, r: number, o: OpCom, ang = -2.2) => heroe(g, tono, (c) => comensal(c, s, x, y, r, o), ang, 9);
/** trozos de metal que vuelan de (x0,y0) hacia (x1,y1) en tandas */
const vuelo = (g: G, s: number, t0: number, x0: number, y0: number, x1: number, y1: number, n: number, cada = 0.12, r = 34) => {
  for (let i = 0; i < n; i++) { const ph = (s - t0 - i * cada) / 0.55; if (ph < 0 || ph > 1) continue; const q = salida(ph);
    pieza(g, lerp(x0, x1, q) + Math.sin(ph * 6 + i) * 30, lerp(y0, y1, q) - Math.sin(ph * Math.PI) * 220, r * (1 - ph * 0.6), s * 6 + i, i * 3.3 + 1, {brillo: 1 - ph}); }
};
/** mesa con mantel (mundo) + plato */
const bk = (g: G, s: number, col: string, n: number, a: number) => { g.save(); bokeh(g, s, col, n, a); g.restore(); };
const mesa = (g: G, s: number, yp = 1380) => { mantel(g, yp + 260); bk(g, s, "255,190,120", 16, 0.18); };
const FRAG = Array.from({length: 70}, (_, i) => ({x: -520 + rnd(i * 2.3) * 1020, y: -200 + rnd(i * 4.7) * 380, r: 18 + rnd(i * 6.1) * 22, sem: i * 7.7}));

// ------------------------------------------------------------------ planos
type Plano = {t0: number; dib: (g: G, s: number) => void};
const PLANOS: Plano[] = [
  // 1 — gancho: la avioneta vuela hacia la cámara y raja la pantalla; "THIS MAN ATE"; el comensal con la boca abierta
  {t0: 0, dib: (g, s) => {
    const tc = T.ate2 - 0.04, choque = s >= tc, ok = s >= T.airplane5 - 0.05;
    cielo(g, s, ok ? 'oro' : 'atardecer', {relampagos: false, nubes: 0.65, hor: 1400});
    if (choque) enPantalla(g, () => rayos(g, 540, 900, s, 0.8, '255,220,150', 18));
    vista(g, s, [[0, 0, 540, 1100, 1.0], ...golpeCam(tc, 540, 1100, 1.2, 1.05), ...golpeCam(T.airplane5, 540, 1150, 1.16, 1.04)], 1.6);
    cordillera(g, s, 1750, ok ? 'oro' : 'atardecer', {capas: 3, pinos: false});
    if (!choque) { const p = cl(s / tc), k = p * p; heroe(g, 'atardecer', (c) => cessna(c, s, lerp(860, 560, k), lerp(760, 1050, k), lerp(0.25, 2.6, k), {rot: lerp(-0.15, 0.05, k)}), -2.4, 6); }
    else {
      mich(g, s, ok ? 'oro' : 'atardecer', 540, 1330, 270, {boca: ok ? 0.4 : 1, mastica: ok ? 1 : 0, expr: 'feliz', servilleta: 1, mira: 0});
      if (ok) {
        const p = rebote(s, T.airplane5);
        heroe(g, 'oro', (c) => { cuchillo(c, 150, 1500, 1.1 * p, -0.35); tenedor(c, 930, 1500, 1.1 * p, 0.35); cessna(c, s, 540, 1060, 0.62 * p, {rot: Math.sin(s * 3) * 0.05}); }, -2.0, 6);
        vuelo(g, s, T.airplane5 + 0.1, 600, 1000, 540, 1490, 6, 0.1);
      }
    }
    slams(g, s, [[tc, 'THIS MAN ATE', 190], [T.airplane5, 'AN AIRPLANE', 210, '#ffe08a']], '#2a1402');
    grieta(g, s, tc, 540, 1000, 3, false, 1.3, 1.5);
    flash(g, s, tc, '255,240,220', 0.9, 0.2);
    onda(g, s, tc, 540, 1000, '255,230,180'); onda(g, s, T.airplane5, 540, 1100, '255,230,160');
    cierre(g, 0.45);
  }},
  // 2 — no es un juguete: avioneta de juguete en la palma… y cae la de verdad
  {t0: T.not - 0.1, dib: (g, s) => {
    const real = s >= T.real10 - 0.05;
    cielo(g, s, real ? 'oro' : 'atardecer', {relampagos: false, nubes: 0.5, hor: 1300});
    vista(g, s, [[T.not - 0.1, 0, 540, 1250, 1.3], [T.not, 0.45, 540, 1250, 1.05], ...golpeCam(T.real10, 540, 1200, 1.2, 1.0)], 1.4);
    aerodromo(g, s, 1300, {luz: '255,210,140'});
    if (!real) {
      const p = rebote(s, T.not);
      heroe(g, 'atardecer', (c) => { c.fillStyle = '#e8b28c'; c.beginPath(); c.ellipse(540, 1420, 300 * p, 110 * p, 0, 0, 7); c.fill(); cessna(c, s, 540, 1330, 0.28 * p, {rot: Math.sin(s * 2) * 0.06}); }, -2.3, 6);
      const [tx, ty] = aP(g, 470, 1300);
      etiqueta(g, s, T.toy, 'A TOY?', 230, 900, tx, ty, {col: '255,232,200'});
      if (s > T.toy + 0.25) cruz(g, 540, 1330, rebote(s, T.toy + 0.3), 150);
    } else {
      const p = rebote(s, T.real10), cae = 1 - salida(cl((s - T.real10) / 0.18));
      sombraSuelo(g, 540, 1560, 700 * p, 0.6);
      heroe(g, 'oro', (c) => cessna(c, s, 540, 1340 - cae * 900, 1.0 * p, {sombra: false}), -2.2, 7);
      brasas(g, s, 540, 1560, 900, Math.exp(-(s - T.real10) * 2), 30);
    }
    slams(g, s, [[T.real10, 'A REAL ONE', 220, '#ffe08a']], '#2a1402');
    grieta(g, s, T.real10, 540, 1500, 9, false, 1.2, 1.2);
    flash(g, s, T.real10, '255,240,220', 0.6, 0.15);
    onda(g, s, T.real10, 540, 1550, '255,230,160');
    cierre(g, 0.45);
  }},
  // 3 — trozo a trozo: la avioneta se va mordiendo desde la cola
  {t0: T.piece12 - 0.1, dib: (g, s) => {
    cielo(g, s, 'atardecer', {relampagos: false, nubes: 0.55, hor: 1300});
    vista(g, s, [[T.piece12 - 0.1, 0, 640, 1260, 1.25], [T.piece12, 0.45, 600, 1260, 1.05], [T.piece14, 0.8, 680, 1240, 1.12]], 1.3);
    aerodromo(g, s, 1300);
    const come = Math.max(ap(s, T.piece12, 0.25) * 0.25, 0) + ap(s, T.piece14, 0.25) * 0.25 + ap(s, T.piece14 + 0.45, 0.2) * 0.12;
    sombraSuelo(g, 560, 1560, 650, 0.6);
    heroe(g, 'atardecer', (c) => cessna(c, s, 560, 1340, 1.0, {come}), -2.4, 7);
    const xb = 560 - 560 + come * 1080;
    for (const t of [T.piece12, T.piece14, T.piece14 + 0.45]) { vuelo(g, s, t, xb, 1300, -200, 1700, 5, 0.06, 40); chispas(g, s, xb, 1300, Math.PI * 0.9, Math.exp(-Math.max(0, s - t) * 5) * (s > t ? 1 : 0), 20); }
    pildora(g, 540, 1640, 'PIECE BY PIECE', rebote(s, T.piece12 + 0.1), {col: '#ffe08a', tam: 40});
    cierre(g, 0.45);
  }},
  // 4 — el telón se abre: Michel Lotito, artista
  {t0: T.his - 0.1, dib: (g, s) => {
    vista(g, s, [[T.his - 0.1, 0, 540, 1150, 1.25], [T.his, 0.6, 540, 1150, 1.0], [T.michel18, 2.4, 540, 1180, 1.1]], 1.2);
    escenario(g, s, {telon: ap(s, T.his, 0.9), focoA: ap(s, T.his + 0.2, 0.4)});
    const p = rebote(s, T.his + 0.3);
    mich(g, s, 'oro', 540, 1180, 230 * p, {expr: 'feliz', brazo: 'arriba', boca: 0.2});
    const [hx, hy] = aP(g, 540, 940), [bx, by] = aP(g, 700, 1450);
    etiqueta(g, s, T.lotito, 'MICHEL LOTITO', 150, 760, hx - 60, hy, {col: '255,236,190'});
    etiqueta(g, s, T.entertainer, 'ENTERTAINER', 930, 1540, bx, by, {col: '255,236,190'});
    if (s > T.michel18) confeti(g, s, T.michel18, 540, 700, 40, 0.8);
    cierre(g, 0.5);
  }},
  // 5 — Grenoble, Francia: los Alpes al anochecer y las luces de la ciudad
  {t0: T.grenoble - 0.1, dib: (g, s) => {
    cielo(g, s, 'atardecer', {relampagos: false, nubes: 0.45, hor: 1250});
    vista(g, s, [[T.grenoble - 0.1, 0, 380, 1250, 1.2], [T.grenoble, 1.4, 600, 1220, 1.0]], 1);
    cordillera(g, s, 1650, 'atardecer', {capas: 5, pinos: false, x0: -900, x1: 2100});
    for (let i = 0; i < 80; i++) { const lx = 180 + rnd(i * 2.1) * 720, ly = 1560 + rnd(i * 3.3) * 120, on = 0.5 + 0.5 * Math.sin(s * 3 + i); glow(g, lx, ly, 16, '255,210,130', 0.6 * on); }
    niebla(g, s, 1520, TONOS.atardecer.niebla, 0.25);
    // banderita tricolor en el pin
    const p = rebote(s, T.grenoble + 0.05);
    g.save(); g.translate(560, 1560); g.scale(p, p);
    glow(g, 0, 0, 120, '255,225,150', 0.9); g.fillStyle = '#ffe7a8'; g.beginPath(); g.arc(0, 0, 14, 0, 7); g.fill();
    g.strokeStyle = '#ddd'; g.lineWidth = 6; g.beginPath(); g.moveTo(0, 0); g.lineTo(0, -230); g.stroke();
    const ond = (k: number) => Math.sin(s * 6 - k * 0.04) * 8;
    for (const [i, c] of [[0, '#1f4aa8'], [1, '#ffffff'], [2, '#e1263a']] as const) { g.fillStyle = c; g.beginPath(); g.moveTo(i * 50, -228 + ond(i * 50)); g.lineTo(i * 50 + 50, -228 + ond(i * 50 + 50)); g.lineTo(i * 50 + 50, -128 + ond(i * 50 + 50)); g.lineTo(i * 50, -128 + ond(i * 50)); g.closePath(); g.fill(); }
    g.restore();
    const [px, py] = aP(g, 560, 1560);
    etiqueta(g, s, T.grenoble + 0.1, 'GRENOBLE, FRANCE', 140, 1000, px, py, {col: '255,232,200', tam: 32});
    bk(g, s, '255,210,160', 14, 0.2);
    cierre(g, 0.45);
  }},
  // 6 — el cartel: MONSIEUR MANGETOUT = "Mister Eats Everything"
  {t0: T.people - 0.1, dib: (g, s) => {
    vista(g, s, [[T.people - 0.1, 0, 540, 1100, 1.3], [T.people, 0.5, 540, 1100, 1.0], ...golpeCam(T.monsieur, 540, 1100, 1.12, 1.04), [T.mr, 1, 540, 1140, 1.08]], 1.2);
    escenario(g, s, {focoX: 540 + Math.sin(s * 1.5) * 200, focoA: 0.8, tinte: '255,214,150'});
    heroe(g, 'oro', (c) => marquesina(c, s, 540, 1050, 1.0 * rebote(s, T.people), 'MONSIEUR', 'MANGETOUT', ap(s, T.monsieur - 0.05, 0.25)), -2.2, 7);
    pildora(g, 540, 1420, '= MR. EATS EVERYTHING', rebote(s, T.mr), {col: '#ffe08a', tam: 38});
    if (s > T.everything) confeti(g, s, T.everything, 540, 800, 60);
    flash(g, s, T.monsieur, '255,236,190', 0.35, 0.12);
    cierre(g, 0.45);
  }},
  // 7 — ¿cómo es posible? la avioneta servida en el plato, con cubiertos
  {t0: T.but - 0.1, dib: (g, s) => {
    cielo(g, s, 'violeta', {relampagos: false, nubes: 0, hor: 1300});
    enPantalla(g, () => rayos(g, 540, 1150, s, 0.6, '230,190,255', 16));
    vista(g, s, [[T.but - 0.1, 0, 540, 1300, 1.3], [T.but, 0.5, 540, 1300, 1.0], ...golpeCam(T.possible, 540, 1260, 1.16, 1.06)], 1.4);
    mesa(g, s);
    heroe(g, 'violeta', (c) => { plato(c, 540, 1420, 1.15); cuchillo(c, 110, 1520, 0.95, -0.12); tenedor(c, 970, 1520, 0.95, 0.12); cessna(c, s, 540, 1300, 0.62 * rebote(s, T.but), {rot: -0.04}); }, -2.0, 7);
    pregunta(g, 840, 980, rebote(s, T.how) * 0.85, 1);
    slams(g, s, [[T.possible, 'HOW?!', 300, '#e6c8ff']], '#1a0630');
    flash(g, s, T.possible, '240,220,255', 0.4, 0.12);
    cierre(g, 0.45);
  }},
  // 8 — pica: el diagnóstico en la sala de rayos X
  {t0: T.it40 - 0.1, dib: (g, s) => {
    salaX(g, s);
    vista(g, s, [[T.it40 - 0.1, 0, 540, 1200, 1.25], [T.it40, 0.5, 540, 1200, 1.0], ...golpeCam(T.pica, 540, 1150, 1.15, 1.06), [T.urge, 1, 560, 1180, 1.1]], 1.2);
    heroe(g, 'lago', (c) => documento(c, 540, 1180, 0.95 * rebote(s, T.it40), 'MEDICAL FILE', 'Patient: M. Lotito', -0.04, 0), -2.2, 7, XR);
    if (s > T.pica - 0.05) sello(g, 560, 1260, 'PICA', ap(s, T.pica - 0.05, 0.12), {tam: 150, col: '#e23b3b'});
