    const m = Math.max(ap(s, T.ate194, 0.12) * 0.55, ap(s, T.ate194, 0.12) * 0.55 + ap(s, T.too, 0.12) * 0.45);
    heroe(g, 'fuego', (c) => placa(c, s, 540, 1050, 0.95, m, -0.05), -2.2, 8);
    mich(g, s, 'fuego', 300, 1560, 230, {boca: 0.2, mastica: s > T.ate194 ? 1 : 0, expr: 'orgullo', servilleta: 1, mira: 0.8}, -1.6);
    for (const t of [T.ate194, T.too]) { vuelo(g, s, t, 830, 830, 300, 1680, 4, 0.05, 24); chispas(g, s, 830, 830, -0.8, s > t ? Math.exp(-(s - t) * 5) : 0, 20); }
    slams(g, s, [[T.ate194, 'HE ATE IT', 230], [T.too, 'TOO!', 320, '#ffd27a']], '#2a1002');
    flash(g, s, T.ate194, '255,230,200', 0.4, 0.12);
