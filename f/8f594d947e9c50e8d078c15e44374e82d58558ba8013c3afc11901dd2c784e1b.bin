    enPantalla(g, () => { const q = rebote(s, T.every); if (q > 0) { g.save(); g.translate(230, 790); g.scale(q * 0.8, q * 0.8); /* calendario: un día que pasa */ g.fillStyle = '#fbfbf6'; g.shadowColor = 'rgba(0,0,0,0.5)'; g.shadowBlur = 20; g.beginPath(); g.roundRect(-110, -120, 220, 240, 18); g.fill(); g.shadowBlur = 0;
      g.fillStyle = '#e23b3b'; g.beginPath(); g.roundRect(-110, -120, 220, 64, [18, 18, 0, 0]); g.fill(); g.fillStyle = '#fff'; g.font = `800 34px ${FF}`; g.textAlign = 'center'; g.fillText('EVERY DAY', 0, -76);
      g.fillStyle = '#222'; g.font = `900 110px ${FF}`; g.fillText(String(1 + (Math.floor((s - T.every) * 8) % 30 + 30) % 30), 0, 70); g.restore(); } });
    numero(g, 660, 800, `${cuenta(s, T.n2a, 0, 2, 0.6).toFixed(0)} LB`, rebote(s, T.n2a), {tam: 90, unidad: '≈ 900 g OF METAL'});
