"""Genera las escenas HyperFrames del video "teclado-fj" (las rayitas de la F y la J).

Uso: .venv/Scripts/python.exe herramientas/hf_teclado_fj.py
Escribe hyperframes/teclado-fj/compositions/*.html e index.html.
Estilo: "interfaz-grid" (CLAUDE.md §2.2) mejorado: teclado 3D, brillo ámbar, profundidad de campo, dedos dibujados.
Todos los tiempos de las escenas salen de las palabras de la voz (fabrica/videos/fuentes/teclado-fj.palabras.json).
"""
import json, os, re, unicodedata

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
P = os.path.join(RAIZ, "hyperframes", "teclado-fj")
W = json.load(open(os.path.join(RAIZ, "fabrica", "videos", "fuentes", "teclado-fj.palabras.json"), encoding="utf-8-sig"))


def norm(s):
    s = unicodedata.normalize("NFD", s.lower())
    return re.sub(r"[^a-z0-9ñ%$]", "", "".join(c for c in s if unicodedata.category(c) != "Mn" or c == "̃"))


ACT = [0.0]  # inicio de la escena que se está construyendo


def t(palabra, n=1):
    """segundo en que empieza la n-ésima aparición de la palabra, contando desde el inicio de la escena actual.
    Una letra mayúscula suelta ("A", "Y") se compara exacta, para no confundirla con "a" o "y"."""
    exacta = len(palabra) == 1 and palabra.isupper()
    k = 0
    for w in W:
        if w["start"] < ACT[0] - 0.01:
            continue
        txt = re.sub(r"[.,;:?!¿¡]", "", w["word"])
        if (txt == palabra) if exacta else (norm(w["word"]) == norm(palabra)):
            k += 1
            if k == n:
                return w["start"]
    raise KeyError(f"{palabra}#{n} después de {ACT[0]}")


def wi(i):
    """inicio de la palabra número i (para los cortes de escena)"""
    return W[i]["start"]


FIN = round(W[-1]["end"] + 1.6, 2)

# ------------------------------------------------------------------ paleta
AMB, AMB2, TUR, ROSA, MOR, VER, ROJO = "#EFA32D", "#FFC04D", "#2ED3C0", "#FF5C8A", "#8B6CFF", "#3DDC84", "#E5484D"

CSS_BASE = """
#root { position: absolute; inset: 0; overflow: hidden; font-family: "Inter", sans-serif; background: #0E0E10; }
.fondo { position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.035) 1.5px, transparent 1.5px), linear-gradient(90deg, rgba(255,255,255,0.035) 1.5px, transparent 1.5px);
  background-size: 120px 120px; background-position: -60px -60px; }
.halo { position: absolute; left: -300px; top: 300px; width: 1680px; height: 1680px; border-radius: 50%;
  background: radial-gradient(circle, rgba(239,163,45,0.22) 0%, rgba(239,163,45,0.06) 40%, transparent 70%); }
.vineta { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 62% at 50% 55%, transparent 55%, rgba(0,0,0,0.75) 100%); pointer-events: none; }
.cam { position: absolute; inset: 0; }
.persp { position: absolute; inset: 0; perspective: 1800px; perspective-origin: 540px 1000px; }
.tablero { position: absolute; width: 1000px; height: 392px; transform-style: preserve-3d; }
.base { position: absolute; left: -36px; top: -36px; right: -36px; bottom: -36px; border-radius: 42px;
  background: linear-gradient(180deg, #1d1d20, #141416); box-shadow: 0 30px 0 #0a0a0b, 0 50px 90px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.06); }
.k { position: absolute; width: 88px; height: 88px; border-radius: 16px;
  background: linear-gradient(180deg, #3b3b3f 0%, #2c2c30 100%);
  box-shadow: 0 10px 0 #17171a, 0 16px 24px rgba(0,0,0,0.55), inset 0 2px 0 rgba(255,255,255,0.09);
  color: #d7d7da; font-weight: 600; font-size: 40px; display: grid; place-items: center; }
.k.esp { width: 520px; }
.k .g { position: absolute; inset: 0; border-radius: 16px; opacity: 0; display: grid; place-items: center; color: #1a1206; font-weight: 800; }
.k .b { position: absolute; left: 30px; width: 28px; bottom: 14px; height: 6px; border-radius: 3px; background: #6a6a70;
  box-shadow: 0 1px 0 rgba(255,255,255,0.25); }
.fila { position: absolute; left: 0; right: 0; display: flex; justify-content: center; }
.chip { padding: 14px 38px; border-radius: 999px; font-weight: 800; font-size: 50px; white-space: nowrap; }
.etq { position: absolute; font-weight: 800; font-size: 40px; color: #fff; white-space: nowrap; }
.dedo { position: absolute; width: 74px; height: 104px; border-radius: 37px 37px 30px 30px;
  background: linear-gradient(180deg, #E8B496 0%, #C98B6B 100%); box-shadow: 0 12px 24px rgba(0,0,0,0.5); }
.dedo::after { content: ""; position: absolute; left: 14px; right: 14px; top: 8px; height: 40px; border-radius: 20px 20px 12px 12px;
  background: linear-gradient(180deg, #F6D9CF, #E7C1B3); opacity: 0.9; }
.anillo { position: absolute; border-radius: 50%; border: 4px solid #EFA32D; }
"""

FILAS = [("QWERTYUIOP", 0, 0), ("ASDFGHJKLÑ", 30, 98), ("ZXCVBNM", 75, 196)]


def pos(letra):
    """centro de la tecla en coordenadas del tablero"""
    for fila, off, y in FILAS:
        if letra in fila:
            return off + fila.index(letra) * 98 + 44, y + 44
    if letra == "ESP":
        return 240 + 260, 294 + 44
    raise KeyError(letra)


def kid(pref, letra):
    return f"{pref}-k-{'NN' if letra == 'Ñ' else letra}"


def teclado(pref, x, y, colores=None, tamano=1.0):
    """HTML de un teclado 3D. colores: {letra: color del brillo}"""
    colores = colores or {}
    teclas = []
    for fila, off, ty in FILAS:
        for i, L in enumerate(fila):
            c = colores.get(L, AMB)
            bump = '<div class="b"></div>' if L in "FJ" else ""
            teclas.append(
                f'<div class="k" id="{kid(pref, L)}" style="left:{off + i * 98}px;top:{ty}px">{L}'
                f'<div class="g" style="background:{c};box-shadow:0 0 34px {c}, 0 10px 0 rgba(0,0,0,0.25)">{L}</div>{bump}</div>')
    teclas.append(f'<div class="k esp" id="{pref}-k-ESP" style="left:240px;top:294px"><div class="g" style="background:{colores.get("ESP", AMB)};box-shadow:0 0 34px {colores.get("ESP", AMB)}"></div></div>')
    return (f'<div class="tablero" id="{pref}-tab" style="left:{x}px;top:{y}px">'
            f'<div class="base"></div>{"".join(teclas)}</div>')


def escena(id_, inicio, fin, cuerpo, js, css=""):
    dur = round(fin - inicio, 3)
    doc = f"""<template>
  <style>{CSS_BASE}{css}</style>
  <div id="root" data-composition-id="{id_}" data-width="1080" data-height="1920" data-layout-allow-overlap data-layout-allow-overflow>
{cuerpo}
  </div>
  <script>
    window.__timelines = window.__timelines || {{}};
    const tl = gsap.timeline({{ paused: true }});
    const T0 = {inicio};
    const at = (s) => Math.max(0, s - T0);
{js}
    window.__timelines["{id_}"] = tl;
  </script>
</template>
"""
    open(os.path.join(P, "compositions", f"{id_}.html"), "w", encoding="utf-8").write(doc)
    return id_, inicio, dur


def luz(sel, cuando, dur=0.12):
    return f'tl.fromTo("{sel} .g", {{opacity: 0}}, {{opacity: 1, duration: {dur}, ease: "power2.out"}}, at({cuando}));\n' \
           f'tl.fromTo("{sel}", {{y: 0}}, {{keyframes: [{{y: 8, duration: 0.06}}, {{y: 0, duration: 0.14, ease: "back.out(3)"}}]}}, at({cuando}));'


ESC = []
SFX = []  # (segundo, archivo, volumen)


def sfx(seg, archivo, vol=0.4):
    SFX.append((round(seg, 3), archivo, vol))


# ================================================================== 1. gancho: F y J
i0, i1 = 0.0, wi(11)
ACT[0] = i0
cuerpo = f"""
    <div class="fondo"></div><div class="halo" id="s1-halo"></div>
    <div class="cam" id="s1-cam"><div class="persp">{teclado("s1", 40, 980)}</div></div>
    <div class="anillo" id="s1-an1" style="left:0;top:0;width:150px;height:150px"></div>
    <div class="anillo" id="s1-an2" style="left:0;top:0;width:150px;height:150px"></div>
    <div id="s1-macro" style="position:absolute;inset:0;background:radial-gradient(circle at 50% 58%, #2a2016 0%, #0E0E10 70%)">
      <div class="k" style="left:240px;top:640px;width:600px;height:600px;border-radius:90px;font-size:300px;font-weight:700;
        box-shadow:0 46px 0 #17171a, 0 70px 90px rgba(0,0,0,0.7), inset 0 6px 0 rgba(255,255,255,0.1)">F
        <div id="s1-bm" style="position:absolute;left:210px;width:180px;bottom:90px;height:30px;border-radius:15px;background:#FFE2A8;box-shadow:0 0 40px #FFC04D, 0 0 90px #EFA32D"></div>
      </div>
      <div class="etq" id="s1-ray" style="left:600px;top:1330px;padding:12px 30px;border-radius:16px;background:{AMB};color:#1a1206;font-size:52px">← RAYITA</div>
    </div>
    <div class="vineta"></div>"""
fx, fy = pos("F")
jx, jy = pos("J")
js = f"""
    tl.fromTo("#s1-tab", {{rotationX: 58, z: 0}}, {{rotationX: 50, duration: 3.4, ease: "none"}}, 0);
    tl.fromTo("#s1-cam", {{scale: 1.55, x: 0, y: 0}}, {{scale: 1.85, x: 120, y: -40, duration: 3.36, ease: "power1.inOut"}}, 0);
    {luz("#s1-k-F", t("F"))}
    {luz("#s1-k-J", t("J"))}
    tl.fromTo(["#s1-an1", "#s1-an2"], {{opacity: 0}}, {{opacity: 0, duration: 0.01}}, 0);
    // primer plano de la F al decir "rayita" (zoom de golpe)
    tl.fromTo("#s1-macro", {{opacity: 0, scale: 0.35, filter: "blur(18px)"}}, {{opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.25, ease: "power3.out"}}, at({t("rayita") - 0.12}));
    tl.fromTo("#s1-bm", {{scaleX: 0}}, {{scaleX: 1, duration: 0.3, ease: "back.out(2.5)"}}, at({t("rayita")}) + 0.1);
    tl.fromTo("#s1-ray", {{opacity: 0, x: 60}}, {{opacity: 1, x: 0, duration: 0.3, ease: "back.out(2)"}}, at({t("rayita")}) + 0.2);
    tl.fromTo("#s1-macro", {{y: 0}}, {{y: -30, duration: 0.9, ease: "none"}}, at({t("rayita")}) + 0.15);
    tl.fromTo("#s1-k-F .b", {{background: "#6a6a70", boxShadow: "0 0 0 rgba(0,0,0,0)"}}, {{background: "#FFE2A8", boxShadow: "0 0 18px #FFC04D", duration: 0.25}}, at({t("rayita")}));
    tl.fromTo("#s1-k-J .b", {{background: "#6a6a70"}}, {{background: "#FFE2A8", boxShadow: "0 0 18px #FFC04D", duration: 0.25}}, at({t("rayita")}));
"""
sfx(0.0, "typing.mp3", 0.35)
sfx(t("F"), "key-press.mp3", 0.5)
sfx(t("J"), "key-press.mp3", 0.5)
sfx(t("rayita"), "ping.mp3", 0.4)
ESC.append(escena("s01-fj", i0, i1, cuerpo, js))

# ================================================================== 2. no es decoración ni defecto
i0, i1 = wi(11), wi(19)
ACT[0] = i0
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s2-cam" style="filter: blur(7px); opacity: 0.55"><div class="persp">{teclado("s2", 40, 1000)}</div></div>
    <div class="fila" style="top:640px"><div class="chip" id="s2-c1" style="background:#2A2A2E;color:#fff;border:3px solid #444">✨ Decoración</div></div>
    <div class="fila" style="top:860px"><div class="chip" id="s2-c2" style="background:#2A2A2E;color:#fff;border:3px solid #444">🛠️ Defecto</div></div>
    <svg id="s2-x1" style="position:absolute;left:300px;top:610px" width="480" height="160"><path d="M10 80 L470 80" stroke="{ROJO}" stroke-width="12" stroke-linecap="round" pathLength="1" stroke-dasharray="1"/></svg>
    <svg id="s2-x2" style="position:absolute;left:330px;top:830px" width="420" height="160"><path d="M10 80 L410 80" stroke="{ROJO}" stroke-width="12" stroke-linecap="round" pathLength="1" stroke-dasharray="1"/></svg>
    <div class="fila" style="top:1120px"><div id="s2-no" style="font-weight:900;font-size:220px;color:{ROJO};text-shadow:0 12px 0 #7a1f22">NO</div></div>
    <div class="vineta"></div>"""
js = f"""
    tl.fromTo("#s2-cam", {{scale: 1.3}}, {{scale: 1.2, duration: 3.8, ease: "none"}}, 0);
    tl.fromTo("#s2-tab", {{rotationX: 50}}, {{rotationX: 50, duration: 0.1}}, 0);
    tl.fromTo("#s2-no", {{scale: 2.6, opacity: 0, rotation: -8}}, {{scale: 1, opacity: 1, rotation: -4, duration: 0.22, ease: "power4.in"}}, at({t("no", 1)}));
    tl.to("#s2-no", {{opacity: 0, scale: 0.6, duration: 0.2}}, at({t("decoracion") - 0.25}));
    tl.fromTo("#s2-c1", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("decoracion") - 0.1}));
    tl.fromTo("#s2-x1 path", {{strokeDashoffset: 1}}, {{strokeDashoffset: 0, duration: 0.18, ease: "power2.out"}}, at({t("decoracion") + 0.45}));
    tl.to("#s2-c1", {{opacity: 0.45, duration: 0.2}}, at({t("decoracion") + 0.55}));
    tl.fromTo("#s2-c2", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("defecto") - 0.1}));
    tl.fromTo("#s2-x2 path", {{strokeDashoffset: 1}}, {{strokeDashoffset: 0, duration: 0.18, ease: "power2.out"}}, at({t("defecto") + 0.4}));
    tl.to("#s2-c2", {{opacity: 0.45, duration: 0.2}}, at({t("defecto") + 0.5}));
"""
sfx(i0 - 0.1, "whoosh-short.mp3", 0.45)
sfx(t("no", 1), "impact-bass-1.mp3", 0.4)
sfx(t("decoracion"), "pop.mp3", 0.4)
sfx(t("decoracion") + 0.45, "error.mp3", 0.22)
sfx(t("defecto"), "pop.mp3", 0.4)
sfx(t("defecto") + 0.4, "error.mp3", 0.22)
ESC.append(escena("s02-nodeco", i0, i1, cuerpo, js))

# ================================================================== 3. pásales el dedo sin mirar
i0, i1 = wi(19), wi(27)
ACT[0] = i0
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s3-cam"><div class="persp">{teclado("s3", 40, 900)}</div></div>
    <div class="dedo" id="s3-dedo" style="left:0;top:0;width:150px;height:300px;border-radius:75px 75px 40px 40px"></div>
    <div class="anillo" id="s3-o1" style="left:0;top:0;width:120px;height:120px"></div>
    <div class="anillo" id="s3-o2" style="left:0;top:0;width:120px;height:120px"></div>
    <div class="anillo" id="s3-o3" style="left:0;top:0;width:120px;height:120px"></div>
    <div class="fila" style="top:560px"><div class="chip" id="s3-mira" style="background:{MOR};color:#fff">🙈 sin mirar</div></div>
    <div class="vineta"></div>"""
fx, fy = pos("F")
cx, cy = 40 + fx, 900 + fy  # centro aprox. en pantalla antes de la perspectiva
js = f"""
    tl.fromTo("#s3-tab", {{rotationX: 42}}, {{rotationX: 42, duration: 0.1}}, 0);
    tl.fromTo("#s3-cam", {{scale: 2.2, x: 300, y: -160}}, {{scale: 2.35, x: 320, y: -170, duration: 3.3, ease: "none"}}, 0);
    // el dedo entra y se desliza sobre la F
    tl.fromTo("#s3-dedo", {{x: 120, y: 1900, rotation: -14}}, {{x: 360, y: 900, rotation: -8, duration: 0.6, ease: "power3.out"}}, at({t("dedo")}) - 0.3);
    tl.to("#s3-dedo", {{x: 420, y: 880, duration: 0.7, ease: "sine.inOut"}}, at({t("dedo")}) + 0.35);
    tl.to("#s3-dedo", {{x: 340, y: 890, duration: 0.7, ease: "sine.inOut"}}, at({t("dedo")}) + 1.05);
    tl.fromTo("#s3-mira", {{scale: 0, rotation: -6}}, {{scale: 1, rotation: 0, duration: 0.35, ease: "back.out(2.4)"}}, at({t("sin")}));
    // "se sienten": ondas de tacto
    ["#s3-o1", "#s3-o2", "#s3-o3"].forEach((o, i) => {{
      tl.fromTo(o, {{x: 420, y: 980, scale: 0.4, opacity: 0}}, {{keyframes: [{{scale: 0.6, opacity: 1, duration: 0.05}}, {{scale: 3.2, opacity: 0, duration: 0.7, ease: "power2.out"}}]}}, at({t("sienten")}) + i * 0.22);
    }});
    tl.fromTo("#s3-k-F .b", {{background: "#6a6a70"}}, {{background: "#FFE2A8", boxShadow: "0 0 20px #FFC04D", duration: 0.2}}, at({t("sienten")}));
"""
sfx(i0 - 0.1, "whoosh.mp3", 0.4)
sfx(t("sin"), "pop.mp3", 0.4)
sfx(t("sienten"), "sparkle.mp3", 0.35)
ESC.append(escena("s03-dedo", i0, i1, cuerpo, js))

# ================================================================== 4. un mapa para tus manos
i0, i1 = wi(27), wi(35)
ACT[0] = i0
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s4-cam"><div class="persp">{teclado("s4", 40, 900)}</div></div>
    <svg id="s4-ruta" style="position:absolute;left:0;top:0" width="1080" height="1920">
      <path d="M 120 1500 C 200 1300, 300 1260, {40 + fx} {900 + fy}" stroke="{AMB}" stroke-width="7" fill="none" stroke-dasharray="16 14" />
      <path d="M 960 1500 C 880 1300, 780 1260, {40 + jx} {900 + jy}" stroke="{TUR}" stroke-width="7" fill="none" stroke-dasharray="16 14" />
    </svg>
    <div class="etq" id="s4-pf" style="left:{40 + fx - 45}px;top:{900 + fy - 150}px;font-size:96px">📍</div>
    <div class="etq" id="s4-pj" style="left:{40 + jx - 45}px;top:{900 + jy - 150}px;font-size:96px">📍</div>
    <div class="fila" style="top:560px"><div class="chip" id="s4-mapa" style="background:{AMB};color:#1a1206">🗺️ MAPA</div></div>
    <div class="fila" style="top:1440px"><div class="chip" id="s4-manos" style="background:#232327;color:#fff;border:3px solid #3a3a3e">🖐️ para tus manos 🖐️</div></div>
    <div class="vineta"></div>"""
js = f"""
    tl.fromTo("#s4-tab", {{rotationX: 0}}, {{rotationX: 0, duration: 0.1}}, 0);
    tl.fromTo("#s4-cam", {{y: 300, filter: "blur(16px)"}}, {{y: 0, filter: "blur(0px)", duration: 0.35, ease: "power3.out"}}, 0);
    tl.fromTo("#s4-mapa", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("mapa")}));
    tl.fromTo("#s4-pf", {{y: -500, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.45, ease: "bounce.out"}}, at({t("mapa")}) + 0.1);
    tl.fromTo("#s4-pj", {{y: -500, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.45, ease: "bounce.out"}}, at({t("mapa")}) + 0.25);
    {luz("#s4-k-F", t("mapa") + 0.5)}
    {luz("#s4-k-J", t("mapa") + 0.62)}
    tl.fromTo("#s4-ruta path", {{strokeDashoffset: 600, opacity: 0}}, {{strokeDashoffset: 0, opacity: 1, duration: 0.7, ease: "power2.out"}}, at({t("manos")}) - 0.3);
    tl.fromTo("#s4-manos", {{y: 80, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.35, ease: "expo.out"}}, at({t("manos")}));
"""
sfx(i0 - 0.1, "whoosh-short.mp3", 0.45)
sfx(t("mapa"), "pop.mp3", 0.45)
sfx(t("mapa") + 0.45, "key-press.mp3", 0.4)
sfx(t("mapa") + 0.6, "key-press.mp3", 0.4)
ESC.append(escena("s04-mapa", i0, i1, cuerpo, js))

# ================================================================== 5. la fila guía: A S D F / J K L Ñ
i0, i1 = wi(35), wi(60)
ACT[0] = i0
izq, der = "ASDF", "JKLÑ"
col = {L: AMB for L in izq} | {L: TUR for L in der}
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s5-cam"><div class="persp">{teclado("s5", 40, 980, col)}</div></div>
    <div id="s5-banda" style="position:absolute;left:52px;top:{980 + 98 - 14}px;width:1006px;height:116px;border-radius:24px;border:5px solid #fff;box-shadow:0 0 30px rgba(255,255,255,0.5)"></div>
    <div class="fila" style="top:600px"><div class="chip" id="s5-sec" style="background:#232327;color:#fff;border:3px solid #3a3a3e">🤫 fila secreta</div></div>
    <div class="fila" style="top:740px"><div id="s5-guia" style="font-weight:900;font-size:130px;color:#fff;letter-spacing:-0.02em">FILA <span style="color:{AMB}">GUÍA</span></div></div>
    <div class="etq" id="s5-izq" style="left:120px;top:1460px;color:{AMB}">← IZQUIERDA</div>
    <div class="etq" id="s5-der" style="left:640px;top:1460px;color:{TUR}">DERECHA →</div>
    <div class="vineta"></div>"""
letras_t = {"A": t("A"), "S": t("S"), "D": t("D"), "F": t("F"), "J": t("J"), "K": t("K"), "L": t("L"), "Ñ": t("Ñ")}
js = f"""
    tl.fromTo("#s5-tab", {{rotationX: 64}}, {{rotationX: 30, duration: 1.2, ease: "power3.inOut"}}, 0);
    tl.fromTo("#s5-cam", {{scale: 1.3, filter: "blur(14px)"}}, {{scale: 1.0, filter: "blur(0px)", duration: 0.4, ease: "power3.out"}}, 0);
    tl.fromTo("#s5-sec", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("secreta")}));
