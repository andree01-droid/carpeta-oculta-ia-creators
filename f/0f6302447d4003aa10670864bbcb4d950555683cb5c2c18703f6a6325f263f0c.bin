alc = {"A": "QZ", "S": "WX", "D": "EC", "F": "RTGVB", "J": "YUHNM", "K": "I", "L": "O", "Ñ": "P"}
TX, TY = 40, 1000
lineas = []
for base_, dest in alc.items():
