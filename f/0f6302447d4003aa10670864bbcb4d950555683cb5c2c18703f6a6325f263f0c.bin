    {"".join(f'tl.call(() => {{ c2.textContent = "{i + 1} / 6"; }}, null, at({s}));' for i, (L, s) in enumerate(der_i))}
    tl.call(() => {{ c2.textContent = "0 / 6"; }}, null, 0.002);
