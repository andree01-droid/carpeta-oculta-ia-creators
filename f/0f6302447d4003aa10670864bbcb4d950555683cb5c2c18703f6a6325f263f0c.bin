i0, i1 = wi(210), FIN
ACT[0] = i0
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s14-cam">
      <div class="fila" style="top:560px"><div class="chip" id="s14-seg" style="background:{AMB};color:#1a1206;font-size:62px;padding:20px 56px">＋ Seguir</div></div>
      <div class="fila" style="top:720px"><div class="chip" id="s14-env" style="background:#232327;color:#fff;border:3px solid {TUR};font-size:56px">➤ Mándaselo</div></div>
      <div class="persp">{teclado("s14", 40, 1040)}</div>
      <div class="dedo" id="s14-d1" style="left:300px;top:900px;width:96px;height:180px;border-radius:48px 48px 30px 30px"></div>
      <div class="dedo" id="s14-d2" style="left:640px;top:900px;width:96px;height:180px;border-radius:48px 48px 30px 30px"></div>
      <div class="fila" style="top:1480px"><div class="etq" id="s14-dos" style="position:relative;font-size:46px;color:{ROSA}">✌️ el que escribe con dos dedos</div></div>
    </div>
    <div class="vineta"></div>"""
picoteo = [("H", 0.0), ("O", 0.32), ("L", 0.64), ("A", 0.96)]
js_p = ""
for i, (L, d) in enumerate(picoteo):
    dedo = "#s14-d1" if L in "QWERTASDFGZXCVB" else "#s14-d2"
    x, y = pos(L)
    base = 300 if dedo == "#s14-d1" else 640
    js_p += f'tl.to("{dedo}", {{x: {40 + x - 48 - base}, y: {1040 + y - 150 - 900}, duration: 0.14, ease: "power2.inOut"}}, at({t("dos", 1)}) - 1.0 + {d});\n'
    js_p += luz(f"#{kid('s14', L)}", t("dos", 1) - 0.85 + d) + "\n"
js = f"""
    tl.fromTo("#s14-cam", {{x: 600, filter: "blur(16px)"}}, {{x: 0, filter: "blur(0px)", duration: 0.3, ease: "power3.out"}}, 0);
    tl.fromTo("#s14-tab", {{rotationX: 40}}, {{rotationX: 40, duration: 0.1}}, 0);
    tl.fromTo("#s14-seg", {{scale: 0}}, {{keyframes: [{{scale: 1, duration: 0.35, ease: "back.out(2.6)"}}, {{scale: 1, duration: 0.3}}, {{scale: 0.9, duration: 0.07}}, {{scale: 1, duration: 0.2, ease: "back.out(3)"}}]}}, 0.05);
    tl.fromTo("#s14-env", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.6)"}}, at({t("mandaselo")}));
    tl.fromTo(["#s14-d1", "#s14-d2"], {{y: -600, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.35, ease: "back.out(1.6)"}}, at({t("amigo")}) - 0.2);
    tl.fromTo("#s14-dos", {{y: 60, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.35, ease: "expo.out"}}, at({t("escribe")}));
{js_p}
"""
sfx(i0 - 0.1, "whoosh.mp3", 0.45)
sfx(i0 + 0.7, "click.mp3", 0.45)
sfx(t("mandaselo"), "pop.mp3", 0.4)
for L, d in picoteo:
    sfx(t("dos", 1) - 0.85 + d, "key-press.mp3", 0.45)
sfx(FIN - 1.6, "notification.mp3", 0.3)
ESC.append(escena("s14-cta", i0, i1, cuerpo, js))

# ------------------------------------------------------------------ index.html
hosts = "\n".join(
    f'      <div id="{e}" data-composition-id="{e}" data-composition-src="compositions/{e}.html" data-start="{s}" data-duration="{d}" '
    f'data-track-index="1" data-track-kind="graphics" data-width="1080" data-height="1920"></div>'
    for e, s, d in ESC)
audios = "\n".join(
    f'      <audio id="sfx-{i:02d}" src="assets/sfx/{f}" data-start="{max(0, s)}" data-track-index="5" data-volume="{v}"></audio>'
    for i, (s, f, v) in enumerate(sorted(SFX)))
index = f"""<!doctype html>
<html lang="es" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * {{ margin: 0; padding: 0; box-sizing: border-box; }}
      html, body {{ margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #0E0E10; }}
      #root {{ position: relative; width: 1080px; height: 1920px; font-family: "Inter", sans-serif; }}
      #fondo {{ position: absolute; inset: 0; background: #0E0E10; }}
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{FIN}" data-width="1080" data-height="1920">
      <div id="fondo"></div>
{hosts}
      <div id="subtitulos" data-composition-id="subtitulos" data-composition-src="compositions/subtitulos.html" data-start="0" data-duration="{FIN}" data-track-index="2" data-track-kind="captions" data-width="1080" data-height="1920" style="z-index: 50"></div>
      <audio id="voz" src="assets/audio/voz.mp3" data-start="0" data-track-index="3" data-volume="1"></audio>
      <audio id="musica" src="assets/audio/musica.mp3" data-start="0" data-duration="{FIN}" data-track-index="4" data-volume="0.13" data-fade-out="1.5"></audio>
{audios}
    </div>
    <script>
      window.__timelines = window.__timelines || {{}};
      window.__timelines["main"] = gsap.timeline({{ paused: true }});
    </script>
  </body>
</html>
"""
open(os.path.join(P, "index.html"), "w", encoding="utf-8").write(index)
print(f"{len(ESC)} escenas · {len(SFX)} efectos · duración {FIN}s")
for e, s, d in ESC:
    print(f"  {e:16s} {s:6.2f} +{d:.2f}")
