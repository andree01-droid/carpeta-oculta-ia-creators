    tl.fromTo("#s7-sin", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("mover")}));
    tl.to("#s7-cam", {{scale: 1.06, duration: 4, ease: "none"}}, 0.4);
"""
