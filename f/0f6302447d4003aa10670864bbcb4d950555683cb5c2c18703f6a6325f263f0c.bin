    {luz("#s6-k-J", t("descansar") + 0.2)}{luz("#s6-k-K", t("descansar") + 0.25)}{luz("#s6-k-L", t("descansar") + 0.3)}{luz("#s6-k-NN", t("descansar") + 0.35)}
