# ================================================================== 11. con el tacto: los índices encuentran las rayitas
i0, i1 = wi(151), wi(178)
ACT[0] = i0
TX, TY = 40, 1000
dedos_s11 = "".join(f'<div class="dedo" id="s11-d{i}" style="left:{TX + pos(L)[0] - 37}px;top:{TY + pos(L)[1] - 70}px"></div>'
                    for i, L in enumerate(["A", "S", "D", "K", "L", "Ñ"]))
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s11-cam"><div class="persp">{teclado("s11", TX, TY, {L: (AMB if L in "ASDF" else TUR) for L in dedos})}</div>
      {dedos_s11}
      <div class="dedo" id="s11-fi" style="left:{TX + pos("F")[0] - 37}px;top:{TY + pos("F")[1] - 70}px;box-shadow:0 0 30px {AMB}"></div>
      <div class="dedo" id="s11-fd" style="left:{TX + pos("J")[0] - 37}px;top:{TY + pos("J")[1] - 70}px;box-shadow:0 0 30px {TUR}"></div>
      <div class="anillo" id="s11-of" style="left:{TX + pos("F")[0] - 60}px;top:{TY + pos("F")[1] - 60}px;width:120px;height:120px"></div>
      <div class="anillo" id="s11-oj" style="left:{TX + pos("J")[0] - 60}px;top:{TY + pos("J")[1] - 60}px;width:120px;height:120px;border-color:{TUR}"></div>
    </div>
    <div class="fila" style="top:580px"><div id="s11-txt" style="font-weight:900;font-size:150px;color:#fff;white-space:nowrap">✋ TACTO</div></div>
    <div class="fila" style="top:580px"><div id="s11-relieve" style="font-weight:900;font-size:110px;color:{AMB};white-space:nowrap">F <span style="color:#fff">+</span> <span style="color:{TUR}">J</span> = relieve</div></div>
    <div class="fila" style="top:760px"><div class="chip" id="s11-sinver" style="background:{MOR};color:#fff">🙈 escribir sin ver</div></div>
    <div class="vineta"></div>"""
js = f"""
    tl.fromTo("#s11-cam", {{scale: 1.4, filter: "blur(16px)"}}, {{scale: 1.0, filter: "blur(0px)", duration: 0.35, ease: "power3.out"}}, 0);
    tl.fromTo("#s11-tab", {{rotationX: 0}}, {{rotationX: 0, duration: 0.1}}, 0);
    tl.fromTo("#s11-txt", {{scale: 2.4, opacity: 0}}, {{scale: 1, opacity: 1, duration: 0.25, ease: "power4.in"}}, at({t("tacto")}) - 0.15);
    tl.to("#s11-txt", {{opacity: 0, y: -50, duration: 0.25}}, at({t("indices")}) - 0.2);
    // los índices buscan las rayitas (se acercan desde arriba con un pequeño zigzag)
    tl.fromTo("#s11-fi", {{x: -160, y: -240, opacity: 0}}, {{keyframes: [{{x: -80, y: -120, opacity: 1, duration: 0.3}}, {{x: 40, y: -40, duration: 0.3}}, {{x: 0, y: 0, duration: 0.35, ease: "back.out(2)"}}]}}, at({t("buscan")}));
    tl.fromTo("#s11-fd", {{x: 160, y: -240, opacity: 0}}, {{keyframes: [{{x: 80, y: -120, opacity: 1, duration: 0.3}}, {{x: -40, y: -40, duration: 0.3}}, {{x: 0, y: 0, duration: 0.35, ease: "back.out(2)"}}]}}, at({t("buscan")}) + 0.1);
    tl.fromTo(["#s11-of", "#s11-oj"], {{scale: 0.5, opacity: 0}}, {{keyframes: [{{scale: 0.7, opacity: 1, duration: 0.05}}, {{scale: 2.4, opacity: 0, duration: 0.6, ease: "power2.out"}}]}}, at({t("rayitas")}) + 0.2);
    {luz("#s11-k-F", t("rayitas") + 0.2)}{luz("#s11-k-J", t("rayitas") + 0.25)}
    [0,1,2,3,4,5].forEach((i) => {{
      tl.fromTo("#s11-d" + i, {{y: -300, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.3, ease: "back.out(2)"}}, at({t("acomoda")}) + i * 0.05);
    }});
    {"".join(luz(f"#{kid('s11', L)}", t("acomoda") + 0.2 + i * 0.05) for i, L in enumerate(["A", "S", "D", "K", "L", "Ñ"]))}
    tl.fromTo("#s11-relieve", {{scale: 0.5, opacity: 0}}, {{scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2)"}}, at({t("F")}));
    tl.fromTo("#s11-sinver", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("escribir")}));
"""
sfx(i0 - 0.1, "whoosh.mp3", 0.45)
sfx(t("tacto") - 0.1, "impact-bass-2.mp3", 0.35)
sfx(t("rayitas") + 0.2, "sparkle.mp3", 0.35)
for i in range(6):
    sfx(t("acomoda") + 0.2 + i * 0.05, "click-soft.mp3", 0.22)
sfx(t("F"), "pop.mp3", 0.4)
sfx(t("escribir"), "pop.mp3", 0.4)
ESC.append(escena("s11-tacto", i0, i1, cuerpo, js))

# ================================================================== 12. el 5 también: numpad, teléfono, cajero
i0, i1 = wi(178), wi(200)
ACT[0] = i0


def pad(pref, x, y, filas, esc=1.0, estilo="num"):
    teclas = []
    for r, fila in enumerate(filas):
        for c, L in enumerate(fila):
            if not L:
                continue
            bump = '<div class="b"></div>' if L == "5" else ""
            teclas.append(f'<div class="k" id="{pref}-n{L}" style="left:{c * 98}px;top:{r * 98}px">{L}'
                          f'<div class="g" style="background:{AMB};box-shadow:0 0 34px {AMB}">{L}</div>{bump}</div>')
    w = max(len(f) for f in filas) * 98 - 10
    h = len(filas) * 98 - 10
    return (f'<div class="tablero" id="{pref}-tab" style="left:{x}px;top:{y}px;width:{w}px;height:{h}px;scale:{esc}">'
            f'<div class="base"></div>{"".join(teclas)}</div>')


num = [["7", "8", "9"], ["4", "5", "6"], ["1", "2", "3"], ["0", "", ""]]
tel = [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s12-cam">
      <div class="fila" style="top:560px"><div id="s12-raro" style="font-weight:900;font-size:110px;color:{ROSA};white-space:nowrap">🤯 LO RARO</div></div>
      <div class="persp">{pad("s12a", 395, 820, num)}</div>
      <div id="s12-tel" style="position:absolute;left:80px;top:1180px;width:400px;padding:30px 0;text-align:center">
        <div class="etq" style="position:relative;font-size:44px;margin-bottom:16px">📞 Teléfono</div>
      </div>
      <div id="s12-atm" style="position:absolute;left:600px;top:1180px;width:400px;padding:30px 0;text-align:center">
        <div class="etq" style="position:relative;font-size:44px;margin-bottom:16px">🏧 Cajero</div>
      </div>
      <div class="persp">{pad("s12t", 110, 1280, tel, 0.72)}{pad("s12c", 630, 1280, tel, 0.72)}</div>
    </div>
    <div class="vineta"></div>"""
js = f"""
    tl.fromTo("#s12-cam", {{x: -500, filter: "blur(16px)"}}, {{x: 0, filter: "blur(0px)", duration: 0.3, ease: "power3.out"}}, 0);
    tl.fromTo("#s12-raro", {{scale: 2.4, opacity: 0, rotation: -6}}, {{scale: 1, opacity: 1, rotation: -3, duration: 0.25, ease: "power4.in"}}, at({t("raro")}) - 0.2);
    tl.fromTo("#s12a-tab", {{scale: 0, rotationX: 0}}, {{scale: 1.2, duration: 0.45, ease: "back.out(1.8)"}}, at({t("5")}) - 0.3);
    tl.fromTo("#s12a-n5 .b", {{background: "#6a6a70"}}, {{background: "#FFE2A8", boxShadow: "0 0 20px #FFC04D", duration: 0.25}}, at({t("5")}));
    {luz("#s12a-n5", t("numerico"))}
    tl.to("#s12-raro", {{opacity: 0, duration: 0.25}}, at({t("Igual")}));
    tl.to("#s12a-tab", {{y: -180, scale: 0.85, duration: 0.5, ease: "power3.inOut"}}, at({t("Igual")}));
    tl.fromTo(["#s12-tel", "#s12t-tab"], {{y: 600, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.45, ease: "expo.out"}}, at({t("telefonos")}));
    tl.fromTo(["#s12-atm", "#s12c-tab"], {{y: 600, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.45, ease: "expo.out"}}, at({t("cajeros")}));
    {luz("#s12t-n5", t("telefonos") + 0.4)}{luz("#s12c-n5", t("cajeros") + 0.4)}
"""
sfx(i0 - 0.1, "whoosh-short.mp3", 0.45)
sfx(t("raro") - 0.15, "impact-bass-1.mp3", 0.35)
sfx(t("5"), "key-press.mp3", 0.5)
sfx(t("numerico"), "sparkle.mp3", 0.3)
sfx(t("telefonos"), "whoosh-short.mp3", 0.35)
sfx(t("telefonos") + 0.4, "key-press.mp3", 0.45)
sfx(t("cajeros") + 0.4, "key-press.mp3", 0.45)
ESC.append(escena("s12-cinco", i0, i1, cuerpo, js))

# ================================================================== 13. el centro: llegas a todos los números
i0, i1 = wi(200), wi(210)
ACT[0] = i0
num2 = [["7", "8", "9"], ["4", "5", "6"], ["1", "2", "3"]]
PX, PY = 395 - 150, 900
flechas = []
for r, fila in enumerate(num2):
    for c, L in enumerate(fila):
        if L == "5":
            continue
        x1, y1 = PX + 98 + 44, PY + 98 + 44
        x2, y2 = PX + c * 98 * 1.0 + 44, PY + r * 98 + 44
        flechas.append(f'<path class="s13-f" d="M {x1} {y1} L {x2} {y2}" stroke="{AMB}" stroke-width="7" stroke-linecap="round" pathLength="1" stroke-dasharray="1"/>')
cuerpo = f"""
    <div class="fondo"></div><div class="halo"></div>
    <div class="cam" id="s13-cam">
      <div class="persp">{pad("s13", PX, PY, num2)}</div>
      <svg style="position:absolute;left:0;top:0" width="1080" height="1920">{"".join(flechas)}</svg>
      <div class="anillo" id="s13-an" style="left:{PX + 98 - 16}px;top:{PY + 98 - 16}px;width:120px;height:120px"></div>
      <div class="fila" style="top:600px"><div id="s13-cen" style="font-weight:900;font-size:120px;color:#fff;white-space:nowrap">🎯 EL <span style="color:{AMB}">CENTRO</span></div></div>
      <div class="fila" style="top:1300px"><div class="chip" id="s13-todos" style="background:{AMB};color:#1a1206">→ todos los números</div></div>
    </div>
    <div class="vineta"></div>"""
js = f"""
    tl.fromTo("#s13-cam", {{scale: 1.5, filter: "blur(16px)"}}, {{scale: 1.0, filter: "blur(0px)", duration: 0.3, ease: "power3.out"}}, 0);
    tl.fromTo("#s13-tab", {{scale: 1.6}}, {{scale: 1.6, duration: 0.1}}, 0);
    {luz("#s13-n5", t("centro"))}
    tl.fromTo("#s13-cen", {{scale: 2.4, opacity: 0}}, {{scale: 1, opacity: 1, duration: 0.25, ease: "power4.in"}}, at({t("centro")}) - 0.15);
    tl.fromTo("#s13-an", {{scale: 0.6, opacity: 0}}, {{keyframes: [{{scale: 0.8, opacity: 1, duration: 0.05}}, {{scale: 2.6, opacity: 0, duration: 0.7, ease: "power2.out"}}]}}, at({t("centro")}));
    tl.fromTo(".s13-f", {{strokeDashoffset: 1}}, {{strokeDashoffset: 0, duration: 0.3, ease: "power2.out", stagger: 0.05}}, at({t("llegas")}));
    {"".join(luz(f"#s13-n{L}", t("llegas") + 0.2 + i * 0.05) for i, L in enumerate("12346789"))}
    tl.fromTo("#s13-todos", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("todos")}));
"""
sfx(i0 - 0.1, "whoosh.mp3", 0.45)
sfx(t("centro"), "ping.mp3", 0.4)
sfx(t("llegas"), "whoosh-short.mp3", 0.35)
sfx(t("todos"), "pop.mp3", 0.4)
ESC.append(escena("s13-centro", i0, i1, cuerpo, js))

