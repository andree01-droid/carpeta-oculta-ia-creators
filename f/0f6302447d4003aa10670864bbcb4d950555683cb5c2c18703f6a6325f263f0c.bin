    }});
    {luz("#s6-k-ESP", t("pulgares"))}
    tl.fromTo(["#s6-p1", "#s6-p2"], {{y: 300, opacity: 0}}, {{y: 0, opacity: 1, duration: 0.4, ease: "back.out(1.8)", stagger: 0.08}}, at({t("pulgares")}));
    tl.fromTo("#s6-pul", {{scale: 0}}, {{scale: 1, duration: 0.35, ease: "back.out(2.4)"}}, at({t("pulgares")}));
    tl.to("#s6-cam", {{scale: 1.05, duration: 4, ease: "none"}}, 0.4);
"""
sfx(i0 - 0.1, "whoosh-short.mp3", 0.45)
