  <script>
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    const T0 = 0.0;
    const at = (s) => Math.max(0, s - T0);

    tl.fromTo("#s1-tab", {rotationX: 58, z: 0}, {rotationX: 50, duration: 3.4, ease: "none"}, 0);
    tl.fromTo("#s1-cam", {scale: 1.55, x: 0, y: 0}, {scale: 1.85, x: 120, y: -40, duration: 3.36, ease: "power1.inOut"}, 0);
    tl.fromTo("#s1-k-F .g", {opacity: 0}, {opacity: 1, duration: 0.12, ease: "power2.out"}, at(0.58));
tl.fromTo("#s1-k-F", {y: 0}, {keyframes: [{y: 8, duration: 0.06}, {y: 0, duration: 0.14, ease: "back.out(3)"}]}, at(0.58));
    tl.fromTo("#s1-k-J .g", {opacity: 0}, {opacity: 1, duration: 0.12, ease: "power2.out"}, at(1.06));
tl.fromTo("#s1-k-J", {y: 0}, {keyframes: [{y: 8, duration: 0.06}, {y: 0, duration: 0.14, ease: "back.out(3)"}]}, at(1.06));
    tl.fromTo(["#s1-an1", "#s1-an2"], {opacity: 0}, {opacity: 0, duration: 0.01}, 0);
    // primer plano de la F al decir "rayita" (zoom de golpe)
    tl.fromTo("#s1-macro", {opacity: 0, scale: 0.35, filter: "blur(18px)"}, {opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.25, ease: "power3.out"}, at(2.48));
    tl.fromTo("#s1-bm", {scaleX: 0}, {scaleX: 1, duration: 0.3, ease: "back.out(2.5)"}, at(2.6) + 0.1);
    tl.fromTo("#s1-ray", {opacity: 0, x: 60}, {opacity: 1, x: 0, duration: 0.3, ease: "back.out(2)"}, at(2.6) + 0.2);
    tl.fromTo("#s1-macro", {y: 0}, {y: -30, duration: 0.9, ease: "none"}, at(2.6) + 0.15);
    tl.fromTo("#s1-k-F .b", {background: "#6a6a70", boxShadow: "0 0 0 rgba(0,0,0,0)"}, {background: "#FFE2A8", boxShadow: "0 0 18px #FFC04D", duration: 0.25}, at(2.6));
    tl.fromTo("#s1-k-J .b", {background: "#6a6a70"}, {background: "#FFE2A8", boxShadow: "0 0 18px #FFC04D", duration: 0.25}, at(2.6));

    window.__timelines["s01-fj"] = tl;
  </script>
