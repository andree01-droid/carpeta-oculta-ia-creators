"""Estudia un vídeo de referencia (Instagram, TikTok, YouTube o un archivo) para poder replicarlo.

Uso: python herramientas/estudiar.py <enlace|archivo> --nombre <id> [--lang es|en|auto]

Deja todo en videos_referencia/<id>/:
  video.mp4            el original (solo para estudiarlo: NUNCA se mete en el vídeo final)
  hoja_NN.jpg          un cuadro cada 0,5 s con el segundo escrito (18 por hoja)
  camara.csv / .png    movimiento de cámara cuadro a cuadro (camara_ref.py)
  planos/              cortes de plano: planos.csv + una tira de 5 cuadros por plano (planos_ref.py)
  video.json           lo que dice, palabra a palabra con tiempos (transcribir.py)
  RESUMEN.md           duración, planos, ritmo de voz, gancho y texto completo
"""
import argparse
import csv
import json
import os
import shutil
import statistics
import subprocess
import sys
import tempfile

from PIL import Image, ImageDraw, ImageFont

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HERR = os.path.join(RAIZ, "herramientas")


def bajar(origen, destino):
    if os.path.isfile(origen):
        shutil.copyfile(origen, destino)
        return
    import yt_dlp
    opciones = {"outtmpl": destino, "format": "bv*+ba/b", "merge_output_format": "mp4", "quiet": True,
                "no_warnings": True, "noplaylist": True, "overwrites": True}
    try:
        with yt_dlp.YoutubeDL(opciones) as y:
            y.download([origen])
    except Exception as e:
        sys.exit(f"✗ No he podido bajar el vídeo ({str(e).splitlines()[0][:160]}).\n"
                 "  Plan B: que el usuario lo descargue (en Instagram/TikTok: «Compartir → Descargar» o una web de descargas),\n"
                 "  lo deje en videos_referencia/originales/ y repites con la ruta del archivo en vez del enlace.")


def hojas(video, carpeta):
    tmp = tempfile.mkdtemp()
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", video, "-vf", "fps=2,scale=240:-2", os.path.join(tmp, "c_%04d.jpg")], check=True)
    cuadros = sorted(os.listdir(tmp))
    try:
        letra = ImageFont.truetype("arialbd.ttf", 18)
    except OSError:
        letra = ImageFont.load_default()
    for n in range(0, len(cuadros), 18):
        grupo = [Image.open(os.path.join(tmp, c)).convert("RGB") for c in cuadros[n:n + 18]]
        w, h = grupo[0].size
        hoja = Image.new("RGB", (6 * w, 3 * h), (20, 20, 20))
        d = ImageDraw.Draw(hoja)
        for k, im in enumerate(grupo):
            x, y = (k % 6) * w, (k // 6) * h
            hoja.paste(im, (x, y))
            d.rectangle([x, y, x + 58, y + 24], fill=(0, 0, 0))
            d.text((x + 4, y + 2), f"{(n + k) * 0.5:.1f}s", fill=(255, 220, 0), font=letra)
        hoja.save(os.path.join(carpeta, f"hoja_{n // 18 + 1:02d}.jpg"), quality=85)
    shutil.rmtree(tmp, ignore_errors=True)
    return (len(cuadros) + 17) // 18


def paso(nombre, orden):
    print(f"· {nombre}…", flush=True)
    r = subprocess.run([sys.executable, *orden], cwd=RAIZ, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if r.returncode != 0:
        print(f"  (no ha salido: {(r.stderr or r.stdout).strip().splitlines()[-1:]})")
    return r.returncode == 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("origen")
    ap.add_argument("--nombre", required=True)
    ap.add_argument("--lang", default="auto")
    a = ap.parse_args()
    carpeta = os.path.join(RAIZ, "videos_referencia", a.nombre)
    os.makedirs(carpeta, exist_ok=True)
    video = os.path.join(carpeta, "video.mp4")

    print("· Bajando el vídeo…", flush=True)
    bajar(a.origen, video)
    dur = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", video],
                               capture_output=True, text=True).stdout.strip() or 0)
    print("· Hojas de fotogramas…", flush=True)
    n_hojas = hojas(video, carpeta)
    paso("Movimiento de cámara", [os.path.join(HERR, "camara_ref.py"), video, os.path.join(carpeta, "camara")])
    paso("Cortes de plano", [os.path.join(HERR, "planos_ref.py"), video, os.path.join(carpeta, "camara.csv"), os.path.join(carpeta, "planos")])
    paso("Lo que dice (transcripción)", [os.path.join(HERR, "transcribir.py"), video, "--out", carpeta, "--lang", a.lang])

    r = [f"# Referencia «{a.nombre}»", "", f"- Origen: {a.origen}", f"- Duración: {dur:.1f} s", f"- Hojas de fotogramas: {n_hojas} (`hoja_NN.jpg`)"]
    pcsv = os.path.join(carpeta, "planos", "planos.csv")
    if os.path.exists(pcsv):
        durs = [float(x["dur"]) for x in csv.DictReader(open(pcsv, encoding="utf-8"))]
        if durs:
            r.append(f"- Planos: {len(durs)} · mediana {statistics.median(durs):.2f} s · más corto {min(durs):.2f} s · más largo {max(durs):.2f} s (`planos/`)")
    tj = os.path.join(carpeta, "video.json")
    if os.path.exists(tj):
        t = json.load(open(tj, encoding="utf-8"))
        palabras = t["words"]
        if palabras:
            habla = palabras[-1]["end"] - palabras[0]["start"]
            r.append(f"- Voz: {len(palabras)} palabras · {len(palabras) / max(habla, 1) * 60:.0f} palabras por minuto · idioma {t['language']}")
            r += ["", "## Gancho (primera frase)", "", t["segments"][0]["text"] if t["segments"] else "",
                  "", "## Texto completo con tiempos", ""] + [f"- {s['start']:.1f}s: {s['text']}" for s in t["segments"]]
        else:
            r.append("- Voz: no habla (solo música o texto en pantalla)")
    open(os.path.join(carpeta, "RESUMEN.md"), "w", encoding="utf-8").write("\n".join(r) + "\n")
    print("\n".join(r[:7]))
    print(f"\n✓ Todo en videos_referencia/{a.nombre}/ — mira RESUMEN.md, las hojas y planos/ antes de proponer nada.")


if __name__ == "__main__":
    main()
