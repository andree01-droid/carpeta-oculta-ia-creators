"""Efectos limpios (sin ruido ni distorsión) + whisp/whoosh de aire, en fabrica/public/sfx/*.wav.

Uso: .venv/Scripts/python.exe herramientas/sfx_limpios.py
Pensados para reemplazar glitch, error, impact-bass, cristal y golpe cuando el usuario no quiere sonidos ásperos.
"""
import os, wave
import numpy as np

SR = 44100
RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(RAIZ, "fabrica", "public", "sfx")
rng = np.random.default_rng(11)


def t(d):
    return np.arange(int(SR * d)) / SR


def env(n, a, caida=4.0, ataque=0.01):
    x = np.linspace(0, 1, n)
    return np.clip(x / max(ataque, 1e-4), 0, 1) * np.exp(-caida * x) * a


def pasa_bajos_var(x, cortes):
    """pasa-bajos de 1 polo con corte variable por muestra."""
    y = np.zeros_like(x); acc = 0.0
    a = (2 * np.pi * cortes / SR) / (1 + 2 * np.pi * cortes / SR)
    for i, v in enumerate(x):
        acc += a[i] * (v - acc); y[i] = acc
    return y


def banda_var(x, centro, ancho=0.5):
    """pasa-banda suave = pasa-bajos(centro·(1+ancho)) − pasa-bajos(centro·(1−ancho)), aplicado dos veces."""
    for _ in range(2):
        x = pasa_bajos_var(x, centro * (1 + ancho)) - pasa_bajos_var(x, centro * (1 - ancho))
    return x


def guardar(nombre, x, gain_db=-3):
    x = x / (np.max(np.abs(x)) + 1e-9) * (10 ** (gain_db / 20))
    f = min(len(x), int(0.006 * SR)); x[-f:] *= np.linspace(1, 0, f)
    with wave.open(os.path.join(OUT, nombre + ".wav"), "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR)
        w.writeframes((x * 32767).astype(np.int16).tobytes())
    print(nombre, f"{len(x)/SR:.2f}s")


def nota(fr, d=0.6, caida=6, brillo=0.35):
    """marimba/campanita: fundamental + parciales suaves, sin saturar."""
    tt = t(d)
    x = np.sin(2 * np.pi * fr * tt) + brillo * np.sin(2 * np.pi * fr * 4 * tt) * np.exp(-tt * 25) + 0.15 * np.sin(2 * np.pi * fr * 2 * tt)
    return x * env(len(tt), 1, caida, 0.004)


# boom: golpe grave redondo (seno que cae de tono), sin ruido
tt = t(0.7)
f = 95 * np.exp(-tt * 5) + 42
boom = np.sin(2 * np.pi * np.cumsum(f) / SR) * env(len(tt), 1, 5, 0.006)
boom += 0.25 * np.sin(2 * np.pi * np.cumsum(f * 2) / SR) * env(len(tt), 1, 12, 0.004)
guardar("boom", boom, -3)

# toc: golpecito de madera (para sellos)
tt = t(0.25)
toc = (np.sin(2 * np.pi * 520 * tt) + 0.5 * np.sin(2 * np.pi * 1340 * tt)) * env(len(tt), 1, 22, 0.002)
toc += 0.8 * np.sin(2 * np.pi * np.cumsum(120 * np.exp(-tt * 9) + 60) / SR) * env(len(tt), 1, 10, 0.003)
guardar("toc", toc, -4)

# bajon: dos notas suaves que bajan (dato malo) — reemplaza error/glitch
a = nota(587.3, 0.35, 7); b = nota(440.0, 0.6, 5)
bajon = np.zeros(int(SR * 0.85)); bajon[:len(a)] += a; i = int(0.16 * SR); bajon[i:i + len(b)] += b[: len(bajon) - i]
guardar("bajon", bajon, -5)

# marimba en tres alturas (para órganos/listas que se encienden)
for nom, fr in [("marimba1", 523.3), ("marimba2", 659.3), ("marimba3", 784.0)]:
    guardar(nom, nota(fr, 0.5, 8), -5)

# brillo: arpegio rápido ascendente (lujo, dato bueno)
br = np.zeros(int(SR * 0.9))
for k, fr in enumerate([1046.5, 1318.5, 1568.0, 2093.0]):
    n = nota(fr, 0.5, 9, 0.2); i = int(k * 0.06 * SR); br[i:i + len(n)] += n[: len(br) - i] * (0.9 - k * 0.12)
guardar("brillo", br, -6)

# rise: subida tonal limpia (sin ruido)
tt = t(0.8)
f = 220 + 660 * (tt / 0.8) ** 2
rise = (np.sin(2 * np.pi * np.cumsum(f) / SR) + 0.3 * np.sin(2 * np.pi * np.cumsum(f * 1.5) / SR)) * (tt / 0.8) ** 1.6
guardar("rise", rise, -7)

# whisp: soplo de aire corto que pasa (banda que sube y baja)
for nom, d, f0, f1, var in [("whisp1", 0.28, 900, 3800, 0), ("whisp2", 0.4, 600, 2600, 1), ("whisp3", 0.55, 400, 2000, 2), ("whisp4", 0.22, 1500, 5200, 3)]:
    tt = t(d); u = tt / d
    centro = f0 + (f1 - f0) * np.sin(np.pi * u) ** 1.5
    x = banda_var(rng.standard_normal(len(tt)), centro, 0.45)
    curva = np.sin(np.pi * u ** (0.7 if var % 2 else 1.3)) ** 2
    guardar(nom, x * curva, -4)
