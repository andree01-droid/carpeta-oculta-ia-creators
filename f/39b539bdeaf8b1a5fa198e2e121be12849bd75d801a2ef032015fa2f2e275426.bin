// Piezas de dibujo para "Why do your fingers wrinkle in water?" (canvas 2D, estilo de la casa: 2D con brillo y contorno suave).
import {G, FF, rnd, cl, lerp, glow} from '../cripto/dibujo';

export const PIEL = ['#f6caa8', '#e2a07c', '#b9785a'] as const;
export const AGUA_C = '120,200,255';

const txt = (g: G, t: string, x: number, y: number, tam: number, col: string, peso = 900) => { g.font = `${peso} ${tam}px ${FF}`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = col; g.fillText(t, x, y); g.textAlign = 'left'; g.textBaseline = 'alphabetic'; };
const sombraSuelo = (g: G, y: number, rx: number) => { g.fillStyle = 'rgba(0,0,0,0.3)'; g.beginPath(); g.ellipse(0, y, rx, rx * 0.09, 0, 0, 7); g.fill(); };

/** contorno de la yema (punta arriba), ancho 300, alto 560, centrado en 0,0 */
const caminoDedo = (g: G) => { g.beginPath(); g.moveTo(-150, 280); g.lineTo(-150, -130); g.arc(0, -130, 150, Math.PI, 0); g.lineTo(150, 280); g.closePath(); };

/** yema de dedo vista de frente (lado de la huella); arruga 0 = lisa, 1 = arrugada como pasa */
export function dedo(g: G, x: number, y: number, sc: number, arruga: number, o: {rot?: number; a?: number; brillo?: number; huella?: number; sem?: number; agua?: number} = {}) {
  const {rot = 0, a = 1, brillo = 0, huella = 1, sem = 3, agua = 0} = o; if (a <= 0 || sc <= 0) return;
  const ar = cl(arruga);
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot); g.scale(sc, sc);
  if (brillo > 0) glow(g, 0, -40, 460, '255,210,170', brillo);
  // sombra
  g.save(); g.translate(14, 18); caminoDedo(g); g.fillStyle = 'rgba(0,0,0,0.3)'; g.fill(); g.restore();
  const c = g.createLinearGradient(-150, 0, 150, 0);
  c.addColorStop(0, PIEL[2]); c.addColorStop(0.35, lerpCol('#f6caa8', '#f3c4c4', ar)); c.addColorStop(0.7, PIEL[1]); c.addColorStop(1, PIEL[2]);
  caminoDedo(g); g.fillStyle = c; g.fill();
  g.save(); caminoDedo(g); g.clip();
  // huella dactilar
  if (huella > 0) {
    g.strokeStyle = `rgba(150,90,60,${0.22 * huella * (1 - ar * 0.5)})`; g.lineWidth = 4;
    for (let r = 20; r < 200; r += 17) { g.beginPath(); g.ellipse(0, -90, r * 0.75, r, 0, Math.PI * 0.95, Math.PI * 2.05); g.stroke(); }
  }
  // arrugas: surcos que bajan de la punta, se ramifican y ondulan
  if (ar > 0) {
    g.lineCap = 'round';
    for (let i = 0; i < 9; i++) {
      const x0 = -120 + i * 30 + (rnd(i * 3.1 + sem) - 0.5) * 18, f = 0.02 + rnd(i * 5.3 + sem) * 0.02, ph = rnd(i * 7.7 + sem) * 6;
      const camino = () => {
        g.beginPath();
        for (let k = 0; k <= 30; k++) {
          const yy = -230 + k * 17, ancho = Math.sqrt(Math.max(0, 1 - ((yy + 130) / 150) ** 2 * (yy < -130 ? 1 : 0)));
          const xx = x0 * (yy < -130 ? ancho : 1) + Math.sin(yy * f + ph) * 22 * ar;
          if (k === 0) g.moveTo(xx, yy); else g.lineTo(xx, yy);
        }
      };
      g.strokeStyle = `rgba(120,60,50,${0.55 * ar})`; g.lineWidth = 9 * ar + 2; camino(); g.stroke();
      g.save(); g.translate(-6, -3); g.strokeStyle = `rgba(255,235,225,${0.5 * ar})`; g.lineWidth = 5 * ar + 1; camino(); g.stroke(); g.restore();
    }
    // pliegues cortos transversales
    for (let i = 0; i < 14; i++) {
      const px = (rnd(i * 2.3 + sem) - 0.5) * 240, py = -200 + rnd(i * 4.1 + sem) * 440, L = 30 + rnd(i * 6.6) * 40;
      g.strokeStyle = `rgba(120,60,50,${0.45 * ar})`; g.lineWidth = 6 * ar + 1;
      g.beginPath(); g.moveTo(px - L / 2, py); g.quadraticCurveTo(px, py - 14 * ar, px + L / 2, py + 4); g.stroke();
    }
  }
  // gotas de agua sobre la piel
  if (agua > 0) for (let i = 0; i < 8; i++) {
    const px = (rnd(i * 3.7 + 1) - 0.5) * 230, py = -220 + rnd(i * 2.9 + 5) * 420, r = 10 + rnd(i * 8.1) * 14;
    g.fillStyle = `rgba(200,235,255,${0.55 * agua})`; g.beginPath(); g.arc(px, py, r, 0, 7); g.fill();
    g.fillStyle = `rgba(255,255,255,${0.9 * agua})`; g.beginPath(); g.arc(px - r * 0.35, py - r * 0.35, r * 0.3, 0, 7); g.fill();
  }
  // brillo lateral
  g.strokeStyle = 'rgba(255,255,255,0.35)'; g.lineWidth = 16; g.lineCap = 'round'; g.beginPath(); g.moveTo(-105, 220); g.lineTo(-105, -120); g.arc(0, -130, 105, Math.PI, Math.PI * 1.35); g.stroke();
  g.restore();
  g.strokeStyle = 'rgba(120,60,40,0.5)'; g.lineWidth = 5; caminoDedo(g); g.stroke();
  g.restore();
}

function lerpCol(a: string, b: string, t: number) {
  const pa = [1, 3, 5].map((i) => parseInt(a.slice(i, i + 2), 16)), pb = [1, 3, 5].map((i) => parseInt(b.slice(i, i + 2), 16));
  return `rgb(${pa.map((v, i) => Math.round(lerp(v, pb[i], t))).join(',')})`;
}

/** corte de la yema: piel arriba (con pliegues), almohadilla rosa y vasos sanguíneos; aprieta 0..1 estrecha los vasos y baja la superficie */
export function corte(g: G, s: number, x: number, y: number, sc: number, aprieta: number, pliegue: number) {
  const ap = cl(aprieta), pl = cl(pliegue);
  g.save(); g.translate(x, y); g.scale(sc, sc);
  const Wd = 860, top = -260 + ap * 70;
  const sup = (xx: number) => top + Math.sin(xx * 0.045) * 38 * pl + Math.sin(xx * 0.11 + 1) * 10 * pl;
  // tejido
  g.save(); g.beginPath(); g.roundRect(-Wd / 2, -320, Wd, 640, 40); g.clip();
  g.fillStyle = 'rgba(10,20,40,0.35)'; g.fillRect(-Wd / 2, -320, Wd, 640);
  g.beginPath(); g.moveTo(-Wd / 2, 330);
  for (let xx = -Wd / 2; xx <= Wd / 2; xx += 8) g.lineTo(xx, sup(xx));
  g.lineTo(Wd / 2, 330); g.closePath();
  const t = g.createLinearGradient(0, top, 0, 320); t.addColorStop(0, '#f2b9a0'); t.addColorStop(0.18, '#e88d84'); t.addColorStop(1, '#a8434f');
  g.fillStyle = t; g.fill();
  // epidermis (franja)
  g.beginPath();
  for (let xx = -Wd / 2; xx <= Wd / 2; xx += 8) { const yy = sup(xx); if (xx === -Wd / 2) g.moveTo(xx, yy); else g.lineTo(xx, yy); }
  g.strokeStyle = '#f9d7c2'; g.lineWidth = 40; g.stroke();
  g.strokeStyle = 'rgba(255,255,255,0.5)'; g.lineWidth = 6; g.stroke();
  // células de grasa
  for (let i = 0; i < 22; i++) { const px = -400 + rnd(i * 2.2) * 800, py = 160 + rnd(i * 3.9) * 140; g.fillStyle = 'rgba(255,220,170,0.25)'; g.beginPath(); g.arc(px, py, 26 + rnd(i) * 14, 0, 7); g.fill(); }
  // vasos sanguíneos
  for (let k = 0; k < 3; k++) {
    const vy = -40 + k * 95 + ap * 30, r = (34 - k * 4) * (1 - 0.62 * ap) + Math.sin(s * 6 + k) * 2;
    g.fillStyle = '#5a0c18'; g.beginPath(); g.roundRect(-Wd / 2 - 20, vy - r - 6, Wd + 40, (r + 6) * 2, r + 6); g.fill();
    const vg = g.createLinearGradient(0, vy - r, 0, vy + r); vg.addColorStop(0, '#ff5a5a'); vg.addColorStop(1, '#a3101e');
    g.fillStyle = vg; g.beginPath(); g.roundRect(-Wd / 2 - 20, vy - r, Wd + 40, r * 2, r); g.fill();
    // glóbulos que fluyen (más lentos al apretar)
    const v = 260 * (1 - 0.7 * ap);
    for (let i = 0; i < 9; i++) { const px = ((((i * 110 + s * v + k * 40) % (Wd + 100)) + Wd + 100) % (Wd + 100)) - Wd / 2 - 50; g.fillStyle = 'rgba(255,190,190,0.85)'; g.beginPath(); g.ellipse(px, vy + Math.sin(i + k) * r * 0.3, r * 0.5, r * 0.32, 0, 0, 7); g.fill(); }
  }
  g.restore();
  g.strokeStyle = 'rgba(255,255,255,0.35)'; g.lineWidth = 4; g.beginPath(); g.roundRect(-Wd / 2, -320, Wd, 640, 40); g.stroke();
  g.restore();
}

/** bañera blanca con agua, espuma y patito */
export function banera(g: G, s: number, x: number, y: number, sc: number, o: {pato?: number; a?: number} = {}) {
  const {pato = 1, a = 1} = o; if (sc <= 0 || a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.scale(sc, sc);
  sombraSuelo(g, 230, 420);
  // patas
  g.fillStyle = '#d8b25a'; for (const px of [-300, 300]) { g.beginPath(); g.roundRect(px - 30, 150, 60, 80, 20); g.fill(); }
  // agua
  const ag = g.createLinearGradient(0, -120, 0, 0); ag.addColorStop(0, '#7fd3ff'); ag.addColorStop(1, '#2c8fd8');
  g.fillStyle = ag; g.beginPath(); g.moveTo(-400, -100);
  for (let xx = -400; xx <= 400; xx += 20) g.lineTo(xx, -100 + Math.sin(xx * 0.03 + s * 3) * 8);
  g.lineTo(400, 0); g.lineTo(-400, 0); g.fill();
  // espuma
  for (let i = 0; i < 16; i++) { const px = -360 + i * 48, py = -100 + Math.sin(s * 2 + i) * 6; g.fillStyle = 'rgba(255,255,255,0.92)'; g.beginPath(); g.arc(px, py, 26 + rnd(i * 3) * 18, 0, 7); g.fill(); }
  if (pato > 0) {
    const px = 150 + Math.sin(s * 1.2) * 60, py = -130 + Math.sin(s * 3) * 8;
    g.save(); g.translate(px, py); g.rotate(Math.sin(s * 2.4) * 0.12); g.scale(pato, pato);
    g.fillStyle = '#ffd23f'; g.beginPath(); g.ellipse(0, 0, 70, 44, 0, 0, 7); g.fill(); g.beginPath(); g.arc(-42, -50, 36, 0, 7); g.fill();
    g.fillStyle = '#ff8a1c'; g.beginPath(); g.moveTo(-74, -54); g.lineTo(-110, -44); g.lineTo(-74, -36); g.fill();
    g.fillStyle = '#1a1a1a'; g.beginPath(); g.arc(-50, -58, 6, 0, 7); g.fill();
    g.restore();
  }
  // cuerpo de la bañera
  const b = g.createLinearGradient(0, -40, 0, 170); b.addColorStop(0, '#ffffff'); b.addColorStop(1, '#c6d2de');
  g.fillStyle = b; g.beginPath(); g.moveTo(-430, -70); g.lineTo(430, -70); g.quadraticCurveTo(420, 170, 300, 170); g.lineTo(-300, 170); g.quadraticCurveTo(-420, 170, -430, -70); g.fill();
  g.fillStyle = '#eef3f8'; g.beginPath(); g.roundRect(-450, -90, 900, 34, 17); g.fill();
  g.strokeStyle = 'rgba(255,255,255,0.8)'; g.lineWidth = 10; g.lineCap = 'round'; g.beginPath(); g.moveTo(-360, -20); g.quadraticCurveTo(-350, 100, -260, 130); g.stroke();
  g.restore();
}

/** gota de agua (punta arriba) */
export function gota(g: G, x: number, y: number, r: number, o: {a?: number; rot?: number; brillo?: number} = {}) {
  const {a = 1, rot = 0, brillo = 0.5} = o; if (r <= 0 || a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot);
  if (brillo > 0) glow(g, 0, 0, r * 2.4, AGUA_C, brillo);
  const c = g.createRadialGradient(-r * 0.3, -r * 0.1, r * 0.1, 0, r * 0.2, r * 1.2); c.addColorStop(0, '#d8f2ff'); c.addColorStop(0.6, '#4fb4ff'); c.addColorStop(1, '#1a63c0');
  g.fillStyle = c; g.beginPath(); g.moveTo(0, -r * 1.7); g.bezierCurveTo(r * 0.5, -r * 0.9, r, -r * 0.3, r, r * 0.25); g.arc(0, r * 0.25, r, 0, Math.PI); g.bezierCurveTo(-r, -r * 0.3, -r * 0.5, -r * 0.9, 0, -r * 1.7); g.fill();
  g.fillStyle = 'rgba(255,255,255,0.75)'; g.beginPath(); g.ellipse(-r * 0.4, r * 0.05, r * 0.16, r * 0.34, 0.3, 0, 7); g.fill();
  g.restore();
}

/** esponja amarilla; hincha 0..1 la infla */
export function esponja(g: G, s: number, x: number, y: number, sc: number, hincha: number, o: {a?: number; rot?: number} = {}) {
  const {a = 1, rot = 0} = o; if (sc <= 0 || a <= 0) return;
  const h = cl(hincha), kx = 1 + 0.12 * h + Math.sin(s * 5) * 0.01 * h, ky = 1 + 0.35 * h;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot); g.scale(sc * kx, sc * ky);
  g.fillStyle = 'rgba(0,0,0,0.3)'; g.beginPath(); g.roundRect(-210, -120, 440, 260, 50); g.fill();
  const c = g.createLinearGradient(0, -130, 0, 130); c.addColorStop(0, '#ffe66a'); c.addColorStop(1, '#e0a812');
  g.fillStyle = c; g.beginPath(); g.roundRect(-220, -130, 440, 260, 50 + 30 * h); g.fill();
  g.fillStyle = '#2fb35a'; g.beginPath(); g.roundRect(-220, 70, 440, 60, [0, 0, 50, 50]); g.fill();
  for (let i = 0; i < 22; i++) { const px = -180 + rnd(i * 2.1) * 360, py = -100 + rnd(i * 3.7) * 150, r = 8 + rnd(i * 5.1) * 14; g.fillStyle = 'rgba(170,110,0,0.45)'; g.beginPath(); g.ellipse(px, py, r, r * 0.8, 0, 0, 7); g.fill(); }
  if (h > 0) for (let i = 0; i < 5; i++) { const d = ((s * 1.4 + i / 5) % 1); gota(g, -160 + i * 80, 140 + d * 260, 14, {a: h * (1 - d), brillo: 0}); }
  g.strokeStyle = 'rgba(255,255,255,0.5)'; g.lineWidth = 10; g.lineCap = 'round'; g.beginPath(); g.moveTo(-170, -100); g.lineTo(120, -100); g.stroke();
  g.restore();
}

/** mano abierta (palma) con el nervio mediano encendido; nervio 0..1 = recorrido, roto = corte con chispas rojas */
export function mano(g: G, s: number, x: number, y: number, sc: number, o: {nervio?: number; roto?: number; a?: number; rot?: number} = {}) {
  const {nervio = 0, roto = 0, a = 1, rot = 0} = o; if (sc <= 0 || a <= 0) return;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.rotate(rot); g.scale(sc, sc);
  const c = g.createLinearGradient(-200, 0, 200, 0); c.addColorStop(0, PIEL[2]); c.addColorStop(0.4, PIEL[0]); c.addColorStop(1, PIEL[1]);
  g.fillStyle = c;
  g.beginPath(); g.roundRect(-110, 300, 220, 260, 40); g.fill(); // muñeca
  g.beginPath(); g.roundRect(-200, -60, 400, 420, 120); g.fill(); // palma
  const dedos: [number, number, number][] = [[-150, -330, 0.1], [-52, -400, 0.03], [48, -380, -0.03], [140, -300, -0.1]];
  for (const [dx, dy, r] of dedos) { g.save(); g.translate(dx, 0); g.rotate(r); g.beginPath(); g.roundRect(-44, dy, 88, -dy + 40, 44); g.fill(); g.restore(); }
  g.save(); g.translate(-190, 150); g.rotate(-0.8); g.beginPath(); g.roundRect(-45, -260, 90, 280, 45); g.fill(); g.restore();
  g.strokeStyle = 'rgba(140,80,60,0.35)'; g.lineWidth = 6; g.lineCap = 'round';
  g.beginPath(); g.moveTo(-150, 80); g.quadraticCurveTo(0, 30, 170, 60); g.moveTo(-160, 170); g.quadraticCurveTo(-20, 120, 120, 140); g.stroke();
  // nervio
  if (nervio > 0) {
    const pts: [number, number][] = [[0, 560], [0, 300], [-20, 120], [-52, -60], [-52, -360]];
    const ramas: [number, number][][] = [[[-20, 120], [-150, -40], [-150, -300]], [[-20, 120], [48, -40], [48, -340]], [[-20, 120], [-210, 40], [-300, -60]]];
    const linea = (p: [number, number][], q: number, col: string, w: number) => {
      const L = p.length - 1, hasta = q * L; g.beginPath(); g.moveTo(p[0][0], p[0][1]);
      for (let i = 1; i <= L; i++) { const f = cl(hasta - (i - 1)); if (f <= 0) break; g.lineTo(lerp(p[i - 1][0], p[i][0], f), lerp(p[i - 1][1], p[i][1], f)); }
      g.strokeStyle = col; g.lineWidth = w; g.stroke();
    };
    g.shadowColor = roto > 0 ? 'rgba(255,60,60,0.9)' : 'rgba(255,230,90,0.9)'; g.shadowBlur = 24;
    const col = roto > 0 ? '#ff5a5a' : '#ffe14a';
    linea(pts, nervio, col, 14); for (const r of ramas) linea(r, cl(nervio * 2 - 1), col, 9);
    g.shadowBlur = 0;
    if (roto > 0) {
      g.fillStyle = PIEL[0]; g.fillRect(-60, 205, 100, 40);
      for (let i = 0; i < 10; i++) { const an = rnd(i * 3 + Math.floor(s * 12)) * 7, L = 30 + rnd(i * 5 + Math.floor(s * 12)) * 50; g.strokeStyle = `rgba(255,${100 + i * 10},80,${roto})`; g.lineWidth = 5; g.beginPath(); g.moveTo(-10, 225); g.lineTo(-10 + Math.cos(an) * L, 225 + Math.sin(an) * L); g.stroke(); }
    }
  }
  g.restore();
}

/** guante de goma con un globo dentro; infla 1 = lleno y liso, 0 = desinflado y arrugado */
export function guanteGlobo(g: G, s: number, x: number, y: number, sc: number, infla: number, o: {a?: number} = {}) {
  const {a = 1} = o; if (sc <= 0 || a <= 0) return;
  const f = cl(infla), arr = 1 - f;
  g.save(); g.globalAlpha = a; g.translate(x, y); g.scale(sc, sc);
  const k = 0.82 + 0.18 * f;
  g.save(); g.scale(k, k);
  // globo rojo visible a través del guante
  glow(g, 0, 60, 360 * f + 60, '255,80,90', 0.35 * f);
  g.fillStyle = '#ff4050'; g.beginPath(); g.ellipse(0, 60, 60 + 160 * f, 70 + 190 * f, 0, 0, 7); g.fill();
  // guante con borde ondulado según lo arrugado
  const borde = (dx: number, dy: number, w: number, h: number, r: number) => {
    g.beginPath();
    const n = 40;
    for (let i = 0; i <= n; i++) {
      const u = i / n, ang = u * Math.PI * 2;
      const ex = Math.cos(ang) * w / 2, ey = Math.sin(ang) * h / 2;
      const wob = 1 + Math.sin(ang * 9 + r) * 0.05 * arr + Math.sin(ang * 17 + r * 2) * 0.03 * arr;
      if (i === 0) g.moveTo(dx + ex * wob, dy + ey * wob); else g.lineTo(dx + ex * wob, dy + ey * wob);
    }
    g.closePath();
  };
  g.fillStyle = 'rgba(80,190,255,0.72)';
  borde(0, 70, 460, 540, 1); g.fill();
  for (const [dx, dy, i] of [[-165, -260, 0], [-60, -310, 1], [55, -300, 2], [160, -240, 3]] as [number, number, number][]) { borde(dx, dy, 100, 300 - 60 * arr, i * 2); g.fill(); }
  borde(-250, 60, 260, 100, 7); g.fill();
  borde(0, 400, 280, 140, 9); g.fill();
  // arrugas del guante
  if (arr > 0) {
    g.strokeStyle = `rgba(20,80,140,${0.6 * arr})`; g.lineWidth = 6; g.lineCap = 'round';
    for (let i = 0; i < 16; i++) { const px = -180 + rnd(i * 2.7) * 360, py = -120 + rnd(i * 4.3) * 420, L = 40 + rnd(i * 6) * 50; g.beginPath(); g.moveTo(px - L / 2, py); g.quadraticCurveTo(px, py + 18 * Math.sin(i + s), px + L / 2, py - 6); g.stroke(); }
  }
  g.strokeStyle = 'rgba(255,255,255,0.55)'; g.lineWidth = 12; g.lineCap = 'round'; g.beginPath(); g.moveTo(-150, -40); g.quadraticCurveTo(-170, 120, -120, 240); g.stroke();
  g.restore();
  g.restore();
}

/** canica de cristal */
export function canica(g: G, x: number, y: number, r: number, col: string, a = 1) {
  if (r <= 0 || a <= 0) return;
  g.save(); g.globalAlpha = a;
  const c = g.createRadialGradient(x - r * 0.35, y - r * 0.35, r * 0.1, x, y, r); c.addColorStop(0, '#ffffff'); c.addColorStop(0.3, col); c.addColorStop(1, 'rgba(10,20,40,0.9)');
  g.fillStyle = c; g.beginPath(); g.arc(x, y, r, 0, 7); g.fill();
  g.fillStyle = 'rgba(255,255,255,0.8)'; g.beginPath(); g.arc(x - r * 0.4, y - r * 0.4, r * 0.18, 0, 7); g.fill();
  g.restore();
}

/** cuenco (visto de lado) con agua */
export function cuenco(g: G, x: number, y: number, sc: number, conAgua = 1) {
  g.save(); g.translate(x, y); g.scale(sc, sc);
  sombraSuelo(g, 120, 220);
  if (conAgua > 0) { g.fillStyle = `rgba(90,180,255,${0.7 * conAgua})`; g.beginPath(); g.ellipse(0, -40, 200, 30, 0, 0, 7); g.fill(); }
  const c = g.createLinearGradient(0, -40, 0, 120); c.addColorStop(0, '#f4f7fb'); c.addColorStop(1, '#9fb0c4');
  g.fillStyle = c; g.beginPath(); g.moveTo(-220, -40); g.quadraticCurveTo(-200, 120, 0, 120); g.quadraticCurveTo(200, 120, 220, -40); g.closePath(); g.fill();
  g.strokeStyle = 'rgba(255,255,255,0.9)'; g.lineWidth = 8; g.beginPath(); g.ellipse(0, -40, 220, 32, 0, 0, Math.PI); g.stroke();
  g.restore();
}

/** caja de regalo; abre 0..1 levanta la tapa */
export function regalo(g: G, x: number, y: number, sc: number, abre: number, s: number) {
  if (sc <= 0) return;
  const ab = cl(abre);
  g.save(); g.translate(x, y); g.scale(sc, sc);
  sombraSuelo(g, 200, 240);
  if (ab > 0) glow(g, 0, -80, 420 * ab, '255,230,120', 0.8 * ab);
  const c = g.createLinearGradient(-200, 0, 200, 0); c.addColorStop(0, '#b0145a'); c.addColorStop(0.5, '#ff4d9a'); c.addColorStop(1, '#a01050');
  g.fillStyle = c; g.beginPath(); g.roundRect(-200, -60, 400, 260, 14); g.fill();
  g.fillStyle = '#ffd23f'; g.fillRect(-30, -60, 60, 260);
  g.save(); g.translate(0, -60 - ab * 260); g.rotate(-ab * 0.5 + Math.sin(s * 6) * 0.03 * ab);
  g.fillStyle = '#ff5aa8'; g.beginPath(); g.roundRect(-225, -70, 450, 80, 14); g.fill(); g.fillStyle = '#ffd23f'; g.fillRect(-30, -70, 60, 80);
  g.strokeStyle = '#ffd23f'; g.lineWidth = 22; g.lineCap = 'round'; g.beginPath(); g.ellipse(-60, -110, 60, 36, -0.4, 0, 7); g.ellipse(60, -110, 60, 36, 0.4, 0, 7); g.stroke();
  g.restore();
  g.restore();
}

/** alcachofa de ducha con chorros y vapor */
export function ducha(g: G, s: number, x: number, y: number, sc: number, chorro = 1) {
  g.save(); g.translate(x, y); g.scale(sc, sc);
  g.strokeStyle = '#c9d2dc'; g.lineWidth = 26; g.lineCap = 'round'; g.beginPath(); g.moveTo(320, -120); g.lineTo(120, -120); g.quadraticCurveTo(60, -120, 40, -60); g.stroke();
  const c = g.createLinearGradient(-120, 0, 120, 0); c.addColorStop(0, '#8a96a4'); c.addColorStop(0.5, '#f2f6fa'); c.addColorStop(1, '#7a8696');
  g.fillStyle = c; g.beginPath(); g.moveTo(-120, 20); g.lineTo(120, 20); g.lineTo(60, -60); g.lineTo(-60, -60); g.closePath(); g.fill();
  if (chorro > 0) {
    g.lineCap = 'round';
    for (let i = 0; i < 26; i++) {
      const x0 = -100 + (i % 13) * 16.6, sp = (x0 / 100) * 0.35;
      for (let k = 0; k < 3; k++) { const d = ((s * 2.2 + rnd(i * 3.1) + k / 3) % 1), L = 900; const px = x0 + sp * d * L, py = 30 + d * L; g.strokeStyle = `rgba(190,230,255,${0.6 * chorro * (1 - d * 0.6)})`; g.lineWidth = 5; g.beginPath(); g.moveTo(px, py); g.lineTo(px + sp * 50, py + 50); g.stroke(); }
    }
  }
  g.restore();
}

/** sello de goma estampado (rectángulo con texto, rotado) */
export function sello(g: G, x: number, y: number, txt0: string, p: number, o: {col?: string; rot?: number; tam?: number} = {}) {
  if (p <= 0) return;
  const {col = '#ef3b45', rot = -0.12, tam = 120} = o;
  g.save(); g.translate(x, y); g.rotate(rot); const k = p < 1 ? 1 + (1 - p) * 1.4 : 1; g.scale(k, k); g.globalAlpha = cl(p * 1.5);
  g.font = `900 ${tam}px ${FF}`; const w = g.measureText(txt0).width + 70;
  g.strokeStyle = col; g.lineWidth = 14; g.beginPath(); g.roundRect(-w / 2, -tam * 0.75, w, tam * 1.5, 18); g.stroke();
  g.lineWidth = 5; g.beginPath(); g.roundRect(-w / 2 + 16, -tam * 0.75 + 16, w - 32, tam * 1.5 - 32, 10); g.stroke();
  txt(g, txt0, 0, 6, tam, col);
  g.restore();
}

/** lupa */
export function lupa(g: G, x: number, y: number, r: number, rot: number, dentro?: () => void) {
  g.save(); g.translate(x, y); g.rotate(rot);
  g.strokeStyle = '#3a2408'; g.lineWidth = r * 0.28; g.lineCap = 'round'; g.beginPath(); g.moveTo(r * 0.75, r * 0.75); g.lineTo(r * 1.8, r * 1.8); g.stroke();
  g.save(); g.beginPath(); g.arc(0, 0, r, 0, 7); g.clip(); g.fillStyle = 'rgba(200,235,255,0.25)'; g.fillRect(-r, -r, 2 * r, 2 * r); if (dentro) { g.rotate(-rot); dentro(); } g.restore();
  g.strokeStyle = '#d8b25a'; g.lineWidth = r * 0.16; g.beginPath(); g.arc(0, 0, r, 0, 7); g.stroke();
  g.strokeStyle = 'rgba(255,255,255,0.6)'; g.lineWidth = r * 0.08; g.beginPath(); g.arc(0, 0, r * 0.75, -2.6, -1.8); g.stroke();
  g.restore();
}

/** carretera mojada en perspectiva (para la escena del neumático) */
export function carreteraMojada(g: G, s: number, y0: number) {
  g.save();
  const c = g.createLinearGradient(0, y0, 0, y0 + 500); c.addColorStop(0, '#2a3340'); c.addColorStop(1, '#141a22');
  g.fillStyle = c; g.fillRect(-300, y0, 1700, 800);
  for (let i = 0; i < 8; i++) { const xx = ((((i * 200 - s * 900) % 1600) + 1600) % 1600) - 300; g.fillStyle = 'rgba(255,225,74,0.8)'; g.fillRect(xx, y0 + 180, 110, 16); }
  for (let i = 0; i < 12; i++) { const xx = ((((rnd(i) * 1600 - s * 900) % 1600) + 1600) % 1600) - 300; g.fillStyle = 'rgba(140,200,255,0.25)'; g.beginPath(); g.ellipse(xx, y0 + 60 + rnd(i * 3) * 300, 90, 12, 0, 0, 7); g.fill(); }
  g.restore();
}

/** etiqueta de visor tipo HUD con corchetes */
export function visor(g: G, x: number, y: number, w: number, h: number, p: number, col = '255,225,74') {
  if (p <= 0) return;
  const L = 60 * p;
  g.save(); g.strokeStyle = `rgba(${col},${p})`; g.lineWidth = 8; g.lineCap = 'round'; g.shadowColor = `rgba(${col},0.9)`; g.shadowBlur = 18;
  for (const [sx, sy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
    const cx = x + sx * w / 2, cy = y + sy * h / 2;
    g.beginPath(); g.moveTo(cx, cy - sy * L); g.lineTo(cx, cy); g.lineTo(cx - sx * L, cy); g.stroke();
  }
  g.restore();
}
