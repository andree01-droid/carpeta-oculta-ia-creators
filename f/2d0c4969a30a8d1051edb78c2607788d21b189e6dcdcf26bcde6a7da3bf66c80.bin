"""Lista palabras con tiempos y huecos. Uso: palabras.py <clave> [desde] [hasta]"""
import json, sys

n = sys.argv[1]
a0 = float(sys.argv[2]) if len(sys.argv) > 2 else 0
a1 = float(sys.argv[3]) if len(sys.argv) > 3 else 1e9
w = json.load(open(f"videos_referencia/transcripciones/{n}.json", encoding="utf-8"))["words"]
for i, x in enumerate(w):
    if a0 <= x["start"] <= a1:
        gap = w[i + 1]["start"] - x["end"] if i + 1 < len(w) else 0
        print(f"{i:3d} {x['word']:>14} {x['start']:6.2f}-{x['end']:6.2f}  hueco={gap:.2f}")
