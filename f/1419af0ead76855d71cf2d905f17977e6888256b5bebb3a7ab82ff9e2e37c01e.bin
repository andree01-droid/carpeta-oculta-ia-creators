  <script>
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    const T0 = 7.14;
    const at = (s) => Math.max(0, s - T0);

    tl.fromTo("#s3-tab", {rotationX: 42}, {rotationX: 42, duration: 0.1}, 0);
    tl.fromTo("#s3-cam", {scale: 2.2, x: 300, y: -160}, {scale: 2.35, x: 320, y: -170, duration: 3.3, ease: "none"}, 0);
    // el dedo entra y se desliza sobre la F
    tl.fromTo("#s3-dedo", {x: 120, y: 1900, rotation: -14}, {x: 360, y: 900, rotation: -8, duration: 0.6, ease: "power3.out"}, at(7.72) - 0.3);
    tl.to("#s3-dedo", {x: 420, y: 880, duration: 0.7, ease: "sine.inOut"}, at(7.72) + 0.35);
    tl.to("#s3-dedo", {x: 340, y: 890, duration: 0.7, ease: "sine.inOut"}, at(7.72) + 1.05);
    tl.fromTo("#s3-mira", {scale: 0, rotation: -6}, {scale: 1, rotation: 0, duration: 0.35, ease: "back.out(2.4)"}, at(7.9));
    // "se sienten": ondas de tacto
    ["#s3-o1", "#s3-o2", "#s3-o3"].forEach((o, i) => {
      tl.fromTo(o, {x: 420, y: 980, scale: 0.4, opacity: 0}, {keyframes: [{scale: 0.6, opacity: 1, duration: 0.05}, {scale: 3.2, opacity: 0, duration: 0.7, ease: "power2.out"}]}, at(9.2) + i * 0.22);
    });
    tl.fromTo("#s3-k-F .b", {background: "#6a6a70"}, {background: "#FFE2A8", boxShadow: "0 0 20px #FFC04D", duration: 0.2}, at(9.2));

    window.__timelines["s03-dedo"] = tl;
  </script>
